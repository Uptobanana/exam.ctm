// s2-zhongzhen.js
(function() {
var S2 = {
id:'s2',name:'中医诊断学',abbr:'中诊',points:[],units:[
{unit:'第一单元 绪论',subunits:[
{name:'中医诊断疾病的三大原则',points:[
{id:'dx-1-1',name:'中医诊断疾病的三大原则',type:'concept',cardQuiz:[{q:'中医诊断三大原则不包括?',opts:['整体审察','四诊合参','病证结合','辨证论治'],ans:3}],content:'<p>三大原则：<strong>整体审察</strong>(从整体出发)、<strong>四诊合参</strong>(望闻问切并重)、<strong>病证结合</strong>(辨病辨证结合)。</p><div class=compare-table><div class=ct-left><h4>三大原则</h4><p><strong>整体审察：</strong>从整体全面分析病情</p><p><strong>四诊合参：</strong>望闻问切互相印证不可偏废</p><p><strong>病证结合：</strong>辨病与辨证相结合</p></div><div class=ct-right><h4>临床意义</h4><p>诊病如破案不能只看单个线索</p><p>四诊任何一诊缺失都可能误诊</p><p>病证结合才能全面把握病情</p></div></div><div class=trap-box><strong>考点：三大原则不包括辨证论治。</strong>辨证论治是治疗原则，不是诊断原则。诊断是辨(诊断)，治疗是论治(治疗)。</div>'}
]}]},
{unit:'第二单元 问诊',subunits:[
{name:'细目一：问寒热',points:[
{id:'dx-2-1',name:'恶寒发热的临床意义',type:'detail',content:'<p>恶寒发热并见主表证。恶寒重发热轻风寒表证（荆防败毒散）。发热重恶寒轻风热表证（银翘散）。发热轻恶风自汗太阳中风证（桂枝汤）。</p><div class=compare-table><div class=ct-left><h4>恶寒重发热轻</h4><p>风寒表证→荆防败毒散</p></div><div class=ct-right><h4>发热重恶寒轻</h4><p>风热表证→银翘散</p></div></div><div class=trap-box>恶寒发热并见=表证。寒重热轻=风寒；热重寒轻=风热。</div><div class=clq>《素问》：风气藏于皮肤之间。 <span class=src>——《黄帝内经》</span></div><div class=plain>恶寒发热并见说明病还在表层。怕冷比发热重的是寒邪感冒用辛温。发热比怕冷重的是热邪感冒用辛凉。</div>'},
{id:'dx-2-2',name:'但寒不热的临床意义',type:'detail',content:'<p>只感怕冷无发热主里寒证。新病恶寒实寒证(理中汤)。久病恶寒虚寒证(金匮肾气丸)。</p><div class=compare-table><div class=ct-left><h4>新病恶寒</h4><p>实寒证→理中汤</p></div><div class=ct-right><h4>久病恶寒</h4><p>虚寒证→肾气丸</p></div></div>'},
{id:'dx-2-3',name:'但热不寒的临床意义',type:'detail',content:'<p>只发热不怕冷主里热证。壮热(T>39度)白虎汤。日晡潮热阳明腑实(大承气汤)午后潮热湿温夜间潮热阴虚。</p><div class=compare-table><div class=ct-left><h4>壮热</h4><p>高热大汗→白虎汤</p></div><div class=ct-right><h4>潮热三种</h4><p>日晡→阳明腑实；午后→湿温；夜间→阴虚</p></div></div>'},
{id:'dx-2-4',name:'寒热往来的临床意义',type:'detail',content:'<p>恶寒发热交替出现主半表半里证。发无定时少阳病(小柴胡汤)。发有定时疟疾。</p><div class=compare-table><div class=ct-left><h4>发无定时</h4><p>少阳病→小柴胡汤</p></div><div class=ct-right><h4>发有定时</h4><p>疟疾→达原饮</p></div></div>'}
]},
{name:'细目二：问汗',points:[{id:'dx-3-1',name:'特殊汗出的临床表现意义',type:'detail',content:'<p>自汗气虚阳虚(玉屏风散)。盗汗入睡出汗醒则止阴虚(当归六黄汤)。绝汗亡阳冷汗亡阴热汗。战汗邪正交争转折点。</p><div class=compare-table><div class=ct-left><h4>自汗</h4><p>白天不动也出汗→气虚/阳虚(玉屏风散)</p></div><div class=ct-right><h4>盗汗</h4><p>入睡出汗醒则止→阴虚(当归六黄汤)</p></div></div><div class=trap-box><strong>汗证鉴别：</strong>自汗(气虚白天漏汗)盗汗(阴虚晚上偷汗)绝汗(危重:亡阳冷汗亡阴热汗)战汗(转折点)</div>'},
{id:'dx-4-2',name:'头痛胸痛胁痛胃脘痛腹痛的要点',type:'detail',content:'<p>头痛太阳经后脑勺阳明经前额少阳经头侧厥阴经巅顶。胸痛闷痛痰饮刺痛瘀血真心痛。胁痛胀痛肝气郁结刺痛瘀血。</p><div class=compare-table><div class=ct-left><h4>头痛分经</h4><p>太阳→后脑</p><p>阳明→前额</p><p>少阳→两侧</p><p>厥阴→巅顶</p></div><div class=ct-right><h4>胸胁胃腹</h4><p>胸痛闷痛→痰饮</p><p>胁胀痛→肝气郁结</p></div></div><div class=trap-box><strong>头痛分经：</strong>太阳后脑阳明前额少阳两侧厥阴巅顶</div>'}
]},
{name:'细目四：问头身胸腹',points:[{id:'dx-4b-1',name:'头晕的要点及临床意义',type:'detail',content:'<p>头晕胀痛肝阳上亢(天麻钩藤饮)。头晕面白气血亏虚(归脾汤)。头晕重如裹痰湿内阻(半夏白术天麻汤)。头晕耳鸣肾精不足(左归丸)。</p><div class=compare-table><div class=ct-left><h4>头晕胀痛</h4><p>肝阳上亢→天麻钩藤饮</p></div><div class=ct-right><h4>头晕面白</h4><p>气血亏虚→归脾汤</p></div></div><div class=compare-table style="margin-top:6px"><div class=ct-left><h4>头晕重如裹</h4><p>痰湿内阻→半夏白术天麻汤</p></div><div class=ct-right><h4>头晕耳鸣</h4><p>肾精不足→左归丸</p></div></div>'}]},
{name:'细目五：问耳目',points:[
{id:'dx-5b-1',name:'耳鸣耳聋的概念及临床意义',type:'detail',content:'<p>实证突发声大按之不减肝火上炎(龙胆泻肝汤)。虚证渐发声细按之可减肾精不足(耳聋左慈丸)。</p><div class=compare-table><div class=ct-left><h4>实证耳鸣</h4><p>突发声大如潮按之不减→肝火上炎(龙胆泻肝汤)</p></div><div class=ct-right><h4>虚证耳鸣</h4><p>渐发声细如蝉按之可减→肾精不足(耳聋左慈丸)</p></div></div>'},
{id:'dx-5b-2',name:'目眩的概念及临床意义',type:'detail',content:'<p>目眩视物旋转如坐舟车。</p><div class=compare-table><div class=ct-left><h4>目眩辨证</h4><p>+面赤→肝阳上亢</p><p>+面白→气血亏虚</p><p>+呕恶→痰湿中阻</p><p>+腰酸→肾精不足</p></div><div class=ct-right><h4>临床意义</h4><p>目眩为肝风内动或清窍失养</p><p>需结合伴随症状辨证</p></div></div>'}
]},
{name:'细目六：问睡眠',points:[
{id:'dx-6b-1',name:'失眠的概念及临床意义',type:'detail',content:'<p>入睡困难心烦心肾不交(交泰丸)。睡后易醒心悸纳差心脾两虚(归脾汤)。多噩梦痰热扰心(温胆汤)。彻夜不眠肝火扰心(龙胆泻肝汤)。</p><div class=trap-box><strong>失眠四证鉴别：</strong>入睡困难+心烦→心肾不交(交泰丸)；睡后易醒+纳差→心脾两虚(归脾汤)；多噩梦+呕恶→痰热扰心(温胆汤)；彻夜不眠+急躁→肝火扰心(龙胆泻肝汤)</div>'},
{id:'dx-6b-2',name:'嗜睡的概念及临床意义',type:'detail',content:'<p>时时欲睡呼之即醒。</p><div class=compare-table><div class=ct-left><h4>嗜睡三型</h4><p>困倦头昏→痰湿困脾</p><p>饭后嗜睡→脾气虚弱</p><p>极度嗜睡→心肾阳虚</p></div><div class=ct-right><h4>病机</h4><p>痰湿→湿困清阳</p><p>脾虚→清阳不升</p><p>阳虚→神失温养</p></div></div>'}
]},
{name:'细目七：问饮食与口味',points:[
{id:'dx-7b-1',name:'口渴与饮水的临床意义',type:'detail',content:'<p>渴喜冷饮热盛伤津(白虎汤)。渴不多饮湿热或水逆(三仁汤/五苓散)。</p><div class=compare-table><div class=ct-left><h4>渴喜冷饮</h4><p>大渴喜冷大汗→热盛伤津(白虎汤)</p></div><div class=ct-right><h4>渴不多饮</h4><p>口干不想咽/漱口不咽→湿热或水逆</p></div></div><div class=trap-box>同为渴不多饮：湿热→苔黄腻；水逆→水入即吐；阴虚→口干不多饮</div>'},
{id:'dx-7b-2',name:'食欲与食量的临床意义',type:'detail',content:'<p>纳呆脾失健运。消谷善饥胃火炽盛(玉女煎)。饥不欲食胃阴不足(益胃汤)。厌食食积或肝胆湿热。</p><div class=compare-table><div class=ct-left><h4>食欲异常</h4><p>纳呆→脾失健运(参苓白术散)</p><p>消谷善饥→胃火炽盛(玉女煎)</p><p>饥不欲食→胃阴不足(益胃汤)</p><p>厌食→食积或肝胆湿热</p></div><div class=ct-right><h4>问诊要点</h4><p>不想吃→脾虚/食积</p><p>吃得多饿得快→胃火</p><p>饿但吃不下→胃阴不足</p></div></div>'},
{id:'dx-7b-3',name:'口味的临床意义',type:'detail',content:'<p>口淡脾胃气虚。口甜脾胃湿热。口酸肝胃郁热。口苦肝胆火旺。口咸肾虚。口黏腻湿浊内停。</p><div class=compare-table><div class=ct-left><h4>口味辨证</h4><p>口淡→脾胃气虚</p><p>口甜→脾胃湿热</p><p>口酸→肝胃郁热</p><p>口苦→肝胆火旺</p><p>口咸→肾虚</p><p>口黏腻→湿浊内停</p></div><div class=ct-right><h4>口诀</h4><p>淡气虚甜湿热</p><p>酸郁热苦火旺</p><p>咸肾虚黏湿浊</p></div></div>'}
]},
{name:'细目八：问二便',points:[
{id:'dx-8b-1',name:'大便异常的要点及临床意义',type:'detail',content:'<p>便秘热秘麻子仁丸冷秘温脾汤虚秘黄芪汤。泄泻湿盛参苓白朮散肾阳虚四神丸。里急后重湿热痢疾。</p><div class=compare-table><div class=ct-left><h4>便秘分型</h4><p>热秘→麻子仁丸</p><p>冷秘→温脾汤</p><p>虚秘→黄芪汤</p></div><div class=ct-right><h4>泄泻分型</h4><p>湿盛→参苓白术散</p><p>肾阳虚→四神丸</p><p>湿热痢→白头翁汤</p></div></div>'},
{id:'dx-8b-2',name:'小便异常的要点及临床意义',type:'detail',content:'<p>尿频湿热下注(八正散)夜尿多肾阳虚(肾气丸)。涩痛湿热淋证。余沥不尽肾气虚。</p><div class=compare-table><div class=ct-left><h4>尿频</h4><p>频数灼痛→湿热下注(八正散)</p><p>夜尿多清长→肾阳虚(肾气丸)</p></div><div class=ct-right><h4>其他</h4><p>涩痛→湿热淋证</p><p>余沥不尽→肾气虚</p><p>失禁→肾气不固</p></div></div>'}
]}
]},
{unit:'第三单元 望诊',subunits:[
{name:'细目一：望神',points:[{id:'dx-9-1',name:'得神失神假神的常见表现及临床意义',type:'detail',content:'<p>得神双目灵活神志清晰精气足预后好。失神目无光彩精神萎靡精气大伤预后差。假神久病重病突然精神转佳回光返照临终。</p><div class=compare-table><div class=ct-left><h4>得神</h4><p>双目灵活有神</p><p>神志清晰反应好</p><p>精气充足→预后好</p></div><div class=ct-right><h4>失神</h4><p>目无光彩呆滞</p><p>精神萎靡反应差</p><p>精气大伤→预后差</p></div></div><div class=compare-table style="margin-top:6px"><div class=ct-left><h4>假神(回光返照)</h4><p>久病重病突然好转</p><p>短暂精神转佳能言</p><p>阴阳离决→临终</p></div><div class=ct-right><h4>鉴别</h4><p>假神短暂回升</p><p>真正康复持续改善</p><p>必伴危重病史</p></div></div>'}
]},
{name:'细目二：望面色',points:[
{id:'dx-10-1',name:'常色与病色的区别',type:'detail',content:'<p>常色:主色+客色。病色:善色有光泽预后好恶色晦暗枯槁预后差。</p>'},
{id:'dx-10-2',name:'五色主病的内容和机理',type:'apply',content:'<p>青主寒痛瘀血。赤主热证(实热通红虚热颧红)。黄主脾虚湿。白主虚寒血虚。黑主肾虚水饮瘀血。</p><div class=compare-table><div class=ct-left><h4>五色主病</h4><p>青→寒/痛/瘀血</p><p>赤→热证(实热面红/虚热颧红)</p><p>黄→脾虚/湿证</p><p>白→虚寒/血虚</p><p>黑→肾虚/水饮/瘀血</p></div><div class=ct-right><h4>临床口诀</h4><p>青寒痛瘀赤主热</p><p>黄脾虚湿白虚寒血虚</p><p>黑肾虚水饮瘀</p></div></div><div class=clq>《灵枢》：青黑为痛黄赤为热白为寒。<span class=src>——《黄帝内经》</span></div>'}
]},
{name:'细目三：望形态',points:[
{id:'dx-11-1',name:'望形体强弱胖瘦的临床意义',type:'detail',content:'<p>强壮骨骼粗壮肌肉充实。瘦弱骨骼细小肌肉瘦削。肥胖形盛气虚多痰湿。消瘦形瘦阴虚多虚火。</p><div class=compare-table><div class=ct-left><h4>肥瘦辨证</h4><p>肥胖→形盛气虚多痰湿</p><p>肥人多中风(气虚痰湿)</p><p>消瘦→形瘦阴虚多虚火</p><p>瘦人多劳嗽(阴虚火旺)</p></div><div class=ct-right><h4>强弱</h4><p>强壮→骨骼粗壮肌肉充实</p><p>瘦弱→骨骼细小肌肉瘦削</p><p>体质强弱决定抗病能力</p></div></div>'},
{id:'dx-11-2',name:'望姿态异常的临床意义',type:'detail',content:'<p>喜动阳证实证。喜静阴证虚证。抽搐角弓反张肝风内动。半身不遂中风。手足蠕动阴虚风动。肢体颤动血虚风动。</p><div class=compare-table><div class=ct-left><h4>动静辨证</h4><p>喜动→阳证/热证/实证</p><p>喜静→阴证/寒证/虚证</p></div><div class=ct-right><h4>异常姿态</h4><p>抽搐反张→肝风内动</p><p>半身不遂→中风</p><p>手足蠕动→阴虚风动</p><p>肢体颤动→血虚风动</p></div></div>'}
]},
{name:'细目四：望头面五官',points:[
{id:'dx-12-1',name:'望头形囟门头发的内容及临床意义',type:'detail',content:'<p>囟门迟闭肾气不足。发黄稀疏精血不足。发白肾虚或血热。</p><div class=compare-table><div class=ct-left><h4>头形囟门</h4><p>头大→先天不足或水停</p><p>头小→肾精不足</p><p>囟门迟闭→肾气不足</p></div><div class=ct-right><h4>头发</h4><p>发黄稀疏→精血不足</p><p>发白→肾虚或血热</p><p>脱发→肾虚/血热/瘀血</p></div></div>'},
{id:'dx-12-2',name:'目部的脏腑相关部位及目形目态',type:'detail',content:'<p>五轮学说：内眦外眦心黑睛肝白睛肺瞳仁肾眼睑脾。目赤肝火白睛发黄黄疸。</p><div class=compare-table><div class=ct-left><h4>五轮学说</h4><p>内外眦→心(血轮)</p><p>黑睛→肝(风轮)</p><p>白睛→肺(气轮)</p><p>瞳仁→肾(水轮)</p><p>眼睑→脾(肉轮)</p></div><div class=ct-right><h4>目形目态</h4><p>目赤→肝火上炎</p><p>白睛发黄→黄疸</p><p>眼睑浮肿→水肿</p><p>瞳孔散大→危证</p></div></div>'},
{id:'dx-12-3',name:'望齿龈的内容及临床意义',type:'detail',content:'<p>牙齿干燥胃阴伤。牙龈红肿胃火上炎。出血胃火或脾虚。</p><div class=compare-table><div class=ct-left><h4>望牙齿</h4><p>干燥→胃阴伤</p><p>光燥如石→阳明热盛</p><p>松动稀疏→肾虚</p></div><div class=ct-right><h4>望牙龈</h4><p>红肿→胃火上炎(清胃散)</p><p>出血→胃火或脾不统血</p><p>色淡→血虚</p></div></div>'},
{id:'dx-12-4',name:'望咽喉的内容及临床意义',type:'detail',content:'<p>红肿疼痛肺胃有热。色淡不肿微痛阴虚。灰白假膜难拭白喉。</p><div class=compare-table><div class=ct-left><h4>咽喉辨证</h4><p>红肿疼痛→肺胃有热</p><p>色淡不肿微痛→阴虚</p><p>灰白假膜难拭→白喉(传染)</p><p>乳蛾红肿→扁桃体炎</p></div><div class=ct-right><h4>临床</h4><p>急性咽炎→肺胃热盛</p><p>慢性咽炎→阴虚火旺</p><p>白喉→传染性强须隔离</p></div></div>'}
]},
{name:'细目五：望皮肤',points:[
{id:'dx-13-1',name:'望斑疹的内容及临床意义',type:'detail',content:'<p>斑点大成片不高出皮肤(阳斑热入营血阴斑气虚)。疹点小如粟米高出皮肤。</p><div class=compare-table><div class=ct-left><h4>斑</h4><p>点大成片不高出皮肤</p><p>阳斑(热入营血)</p><p>阴斑(气虚不摄血)</p></div><div class=ct-right><h4>疹</h4><p>点小如粟米高出皮肤</p><p>摸之碍手</p><p>麻疹/风疹常见</p></div></div>'},
{id:'dx-13-2',name:'望疮疡的内容及临床意义',type:'detail',content:'<p>痈红肿热痛阳证易消易溃。疽漫肿无头阴证难消难溃。</p><div class=compare-table><div class=ct-left><h4>痈(阳证)</h4><p>红肿热痛</p><p>根盘紧束有脓头</p><p>易消易溃预后好</p></div><div class=ct-right><h4>疽(阴证)</h4><p>漫肿无头</p><p>皮色不变不热少痛</p><p>难消难溃预后差</p></div></div>'}
]},
{name:'细目六：望排泄物与分泌物',points:[{id:'dx-14-1',name:'观察痰涕的临床意义',type:'detail',content:'<p>痰黄黏稠热痰白清稀寒痰少而黏燥痰。涕清稀风寒浊涕风热。</p><div class=compare-table><div class=ct-left><h4>痰的辨证</h4><p>黄黏稠→热痰</p><p>白清稀→寒痰</p><p>少而黏→燥痰</p><p>多白易咯→湿痰</p></div><div class=ct-right><h4>涕的辨证</h4><p>清稀涕→风寒</p><p>浊涕→风热</p><p>久浊涕不止→鼻渊</p></div></div>'}]},
{name:'细目七：望小儿指纹',points:[{id:'dx-15-1',name:'小儿指纹病理变化的临床意义',type:'detail',content:'<p>适用于三岁以下。浮沉分表里红紫辨寒热淡滞定虚实三关测轻重。</p><div class=compare-table><div class=ct-left><h4>三关测轻重</h4><p>风关→病轻(络脉)</p><p>气关→病重(经脉)</p><p>命关→病危(脏腑)</p><p>透关射甲→极危</p></div><div class=ct-right><h4>其他辨证</h4><p>浮沉分表里</p><p>红紫辨寒热</p><p>淡滞定虚实</p><p>适用于三岁以下小儿</p></div></div><div class=mnem>浮沉分表里红紫辨寒热淡滞定虚实三关测轻重</div>'}]}
]},
{unit:'第四单元 望舌',subunits:[
{name:'细目一：舌诊原理',points:[{id:'dx-16-1',name:'舌与脏腑的关系',type:'detail',content:'<p>舌为心之苗、脾之外候。舌通过经络与五脏六腑相连——心经系舌本、脾经连舌本、肾经挟舌本、肝经络舌本。舌面不同部位对应不同脏腑。</p><div class=compare-table><div class=ct-left><h4>舌面分区对应脏腑</h4><p><strong>舌尖：</strong>心肺——反映上焦心肺病变</p><p><strong>舌中：</strong>脾胃——反映中焦脾胃病变</p><p><strong>舌根：</strong>肾——反映下焦肾的病变</p><p><strong>舌边(两侧)：</strong>肝胆——反映肝胆病变</p><p>舌是唯一可直接观察体内状态的窗口</p></div><div class=ct-right><h4>临床意义</h4><p>舌尖红→心火亢盛(心烦失眠口疮)</p><p>舌中厚腻苔→脾胃湿浊(纳呆腹胀)</p><p>舌根厚苔→下焦湿热(腰痛带下)</p><p>舌边红赤→肝胆火旺(胁痛口苦)</p><p>舌边齿痕→脾气虚(乏力纳差便溏)</p><p>舌下络脉青紫→瘀血</p></div></div><div class=trap-box><strong>舌诊要点：</strong>舌尖属心肺—舌中属脾胃—舌根属肾—舌边属肝胆。舌尖红用导赤散清心火；舌中厚腻用平胃散化湿浊；舌边红用龙胆泻肝汤清肝火。</div><div class=clinical-case>一位反复口腔溃疡患者舌尖鲜红溃疡点在舌尖处舌中苔黄厚腻。舌尖红→心火亢盛；舌中黄厚→脾胃湿热。辨证为心脾积热上攻口舌——导赤散清心火合泻黄散清脾胃湿热。一周后溃疡愈合。</div>'}
]},
{name:'细目二：望舌质',points:[
{id:'dx-17-1',name:'舌色变化的临床意义',type:'detail',content:'<p>舌色反映气血盛衰和病位深浅。舌色变化从淡白→红→绛→紫，提示热邪由浅入深、病情由轻到重。</p><div class=compare-table><div class=ct-left><h4>舌色分类</h4><p><strong>淡白舌：</strong>舌色浅淡→虚寒证/气血两虚(血不上荣)。阳虚则内寒不能温运血液</p><p><strong>红舌：</strong>舌色鲜红→热证。红而干为实热(热盛伤津)；红而少苔为虚热(阴虚火旺)</p><p><strong>绛舌：</strong>舌色深红→热入营血(热病极期)。绛而干燥为热极津枯；绛有黄苔为气营两燔</p><p><strong>紫舌：</strong>舌色青紫→紫而干为热盛(热极血瘀)；紫而润为寒盛(寒凝血瘀)；紫有瘀斑为瘀血</p></div><div class=ct-right><h4>舌色进展与预后</h4><p>淡白(虚寒)→红(轻热)→绛(重热)→紫(极重/瘀血)</p><p>舌色由浅变深→病情加重</p><p>舌色由深变浅→病情好转</p><p>舌色越深预后越差</p><p><strong>注意：</strong>舌色辨虚实——淡白多虚、红绛多热、紫暗多瘀。</p></div></div><div class=trap-box><strong>考核重点：</strong>淡白舌→虚寒或气血两虚；红舌→热证(干实热少苔虚热)；绛舌→热入营血(温病传变标志)；紫舌→紫干热盛紫润寒盛。舌色从淡白到紫的过程就是热邪逐渐深入的过程。</div><div class=clinical-case>一位肺炎患者高热期舌色红绛干燥——热入营血用清营汤凉血清热。体温下降后舌色转为红再转为淡红——热邪从营血退回气分再消退。另一位贫血患者舌色淡白无华——气血两虚用归脾汤调养一月后舌色转淡红。舌色变化是判断病情进退的客观指标。</div>'},
{id:'dx-17-2',name:'舌形变化的临床意义',type:'detail',content:'<p>舌形反映体内物质盈亏(气血津液)——舌老嫩辨虚实、舌胖瘦辨气血、舌裂纹辨津液、舌齿痕辨脾虚。</p><div class=compare-table><div class=ct-left><h4>舌形分类</h4><p><strong>老舌(苍老)：</strong>舌质纹理粗糙坚敛→实证(邪气有余)</p><p><strong>嫩舌(娇嫩)：</strong>舌质纹理细腻→虚证(正气不足)</p><p><strong>胖大舌：</strong>舌体胖大肿胀→水湿痰饮(脾肾阳虚水停)</p><p><strong>瘦薄舌：</strong>舌体瘦小薄扁→气血两虚或阴虚火旺</p><p><strong>裂纹舌：</strong>舌面有裂纹→红绛裂纹为热盛；淡白裂纹为血虚</p><p><strong>齿痕舌：</strong>舌边有牙齿印→脾虚或湿盛(气虚水湿内停)</p><p><strong>舌下络脉：</strong>青紫怒张迂曲→瘀血</p></div><div class=ct-right><h4>临床口诀</h4><p>老实嫩虚→辨虚实</p><p>胖大痰湿瘦薄虚→辨气血</p><p>裂纹热盛或血虚→辨津液</p><p>齿痕脾虚或湿盛→辨脾湿</p><p>舌下青紫为瘀血→辨血瘀</p></div></div><div class=trap-box><strong>舌形鉴别要点：</strong>舌老是实(邪气壅实)、舌嫩是虚(正气虚衰)。舌胖大水湿痰饮(苓桂术甘汤)、舌瘦薄气血虚(八珍汤)。舌裂纹红绛热盛(增液汤)、淡白血虚(四物汤)。齿痕舌必伴脾虚证。</div><div class=clinical-case>一位慢性肾病患者舌体胖大边有齿痕——脾肾阳虚水湿内停用真武汤温阳利水。一位甲亢患者舌体瘦小舌红少苔——阴虚火旺用知柏地黄丸滋阴降火。一位心绞痛患者舌下络脉青紫怒张——血瘀证用血府逐瘀汤活血化瘀。</div>'},
{id:'dx-17-3',name:'舌态变化的临床意义',type:'detail',content:'<p>舌态是舌体运动的状态，反映神经系统病变和危重证——舌态异常往往是中风或热入心包等危急情况的表现。</p><div class=compare-table><div class=ct-left><h4>舌态分类</h4><p><strong>强硬舌：</strong>舌体板硬强直转动不灵→热入心包(高热神昏)或中风先兆(肝阳化风)</p><p><strong>痿软舌：</strong>舌体软弱无力转动→气血虚极或阴液大亏(久病危重)</p><p><strong>颤动舌：</strong>舌体不自主抖动→肝风内动(热极/阴虚/血虚)</p><p><strong>歪斜舌：</strong>伸舌时偏向一侧→中风或中风后遗症(肝风夹痰阻络)</p><p><strong>吐弄舌：</strong>舌伸口外不回(吐舌)或上下左右舐唇(弄舌)→心脾有热(小儿多见)</p><p><strong>短缩舌：</strong>舌体紧缩不能伸出→病情危重(寒凝/热极/痰阻/气血虚)</p></div><div class=ct-right><h4>临床急症快速判断</h4><p>强硬→中风先兆/热入心包→急查神经系统</p><p>歪斜→中风(脑出血/脑梗)→急送医</p><p>痿软→气血虚极→危重</p><p>短缩→病情危重→预后不良</p></div></div><div class=trap-box><strong>舌态异常的核心：</strong>凡舌态异常大多与"风"有关(肝风内动)或与"虚"有关(气血极虚)。强硬热入心包或中风；痿软虚至极；颤动肝风内动；歪斜中风。其中强硬和歪斜是中风的典型表现需要高度警惕。</div><div class=clinical-case>一位高血压患者突然舌体强硬说话含糊伴一侧肢体麻木——中风先兆(肝阳化风)用镇肝熄风汤急煎后送医。一位帕金森老人舌体不自主颤动——阴虚风动用大定风珠滋阴息风。一位大出血患者舌体痿软无力——气血虚极急用独参汤。</div>'}
]},
{name:'细目三：望舌苔',points:[
{id:'dx-18-1',name:'苔质变化的临床意义',type:'detail',content:'<p>苔质是舌苔的质地形态，反映邪气的深浅和胃气的盛衰——薄厚辨表里、润燥辨津液、腐腻辨食积湿浊、剥落辨胃气。</p><div class=compare-table><div class=ct-left><h4>苔质分类</h4><p><strong>薄厚苔：</strong>薄苔→表证/正常(邪浅)；厚苔→里证(邪入里或食积痰湿)。由薄转厚→病进；由厚转薄→病退</p><p><strong>润燥苔：</strong>润苔→津液正常(或湿盛)；燥苔→津液已伤(高热汗出伤津)；滑苔→水湿内停(阳虚不化水)</p><p><strong>腐腻苔：</strong>腐苔如豆腐渣刮之易去→食积(保和丸)；腻苔如涂油刮之不去→湿浊(二陈汤/藿香正气散)</p><p><strong>剥落苔/镜面舌：</strong>花剥苔→胃气阴两伤；镜面舌(全舌无苔光滑如镜)→胃阴大伤病情危重</p></div><div class=ct-right><h4>临床动态观察</h4><p>舌苔从无到有→胃气渐复(好)</p><p>舌苔从薄到厚→病邪由表入里(不好)</p><p>舌苔从厚到薄→病邪消退(好)</p><p>舌苔从润到燥→津液耗伤</p><p>舌苔从燥到润→津液回复(好)</p></div></div><div class=trap-box><strong>苔质考核要点：</strong>薄苔表证厚苔里证；润苔正常燥苔津伤滑苔水湿；腐苔食积腻苔湿浊；剥落苔胃气阴伤镜面舌胃阴大伤。真苔(有根)实证；假苔(无根)虚证。</div><div class=clinical-case>一位感冒患者舌苔薄白→表证用解表药。一位食积儿童舌苔厚腻如铺豆渣酸臭→食积用保和丸三剂苔退。一位慢性胃炎老人舌光红无苔如镜面→胃阴大伤用益胃汤加沙参麦冬养胃阴。一月后舌面长出薄白苔→胃气恢复。舌苔从无到有的过程就是胃气恢复的过程。</div>'},
{id:'dx-18-2',name:'苔色变化的临床意义',type:'detail',content:'<p>苔色反映病邪性质——白苔主表寒、黄苔主里热、灰苔主里证、黑苔主重证。苔色从白→黄→灰→黑提示热邪由轻到重。</p><div class=compare-table><div class=ct-left><h4>苔色分类</h4><p><strong>白苔：</strong>主表证寒证。薄白→正常或表证初起；白厚腻→寒湿内停或食积</p><p><strong>黄苔：</strong>主里证热证。淡黄热轻、深黄热重、焦黄热结(实热)。黄腻苔→湿热(苔黄+质腻)</p><p><strong>灰苔：</strong>主里证。灰而干燥→热甚津伤；灰而湿润→寒湿内停</p><p><strong>黑苔：</strong>主重证危证。黑而干焦→热极津枯(危重)；黑而水滑→寒极阳衰(危重)</p></div><div class=ct-right><h4>苔色变化规律</h4><p>白→黄→灰→黑：热邪由轻到重</p><p>苔色变浅→病情好转(热退)</p><p>苔色加深→病情加重(热进)</p><p>白苔+表证→辛散解表</p><p>黄苔+里证→清热泻火</p><p>黑苔+干焦→急下存阴</p><p>黑苔+水滑→回阳救逆</p></div></div><div class=trap-box><strong>苔色鉴别要点：</strong>白苔表寒用温散；黄苔里热用清泄；灰苔辨干湿(干热湿寒)；黑苔看干润(干热极润寒极)。苔色结合苔质一起看才能准确辨证——黄腻为湿热、黄燥为实热、白腻为寒湿。</div><div class=clinical-case>一位肺炎高热患者舌苔从薄白转为黄燥再转为焦黑——热邪由表入里由热转极。焦黑苔时体温40度神昏谵语——热入心包用安宫牛黄丸合清营汤。三天后苔色从焦黑→深黄→薄黄→体温下降神志转清。苔色变化完整记录了热病进展和转归的过程。</div>'},
{id:'dx-18-3',name:'舌质和舌苔的综合诊察',type:'apply',content:'<p>舌质看正气(气血盛衰)、舌苔看邪气(病邪深浅)。两者结合才能真正把握病情——舌质决定病性、舌苔决定病位和性质。</p><div class=compare-table><div class=ct-left><h4>舌质舌苔综合辨证</h4><p><strong>淡白苔白：</strong>虚寒证→理中丸温中散寒</p><p><strong>红舌黄苔：</strong>实热证→白虎汤/黄连解毒汤清热泻火</p><p><strong>红舌少苔：</strong>虚热证(阴虚)→六味地黄丸滋阴降火</p><p><strong>淡白苔腻：</strong>脾虚湿盛→参苓白术散健脾化湿</p><p><strong>紫暗苔白：</strong>气滞血瘀→血府逐瘀汤活血化瘀</p><p><strong>红绛苔黄燥：</strong>热入营血→清营汤凉血清热</p></div><div class=ct-right><h4>分析原则</h4><p><strong>舌质为主舌苔为辅：</strong>舌质反映根本(正气的强弱)。舌质红绛即使苔白也要考虑热证</p><p><strong>舌苔反映邪气：</strong>苔黄为热、苔白为寒、苔腻为湿</p><p><strong>舌质舌苔矛盾时：</strong>舌质淡白但苔黄腻→脾虚湿热(虚实夹杂)</p><p>舌质红绛但苔白润→热入营血兼痰湿</p></div></div><div class=trap-box><strong>综合诊察口诀：</strong>舌质看正气(淡白为虚、红为热、紫为瘀)；舌苔看邪气(白为寒、黄为热、腻为湿、剥为虚)。舌质决定病性舌苔决定病位舌质舌苔结合才能全面判断。</div><div class=clinical-case>一位长期胃病患者舌红无苔(镜面舌)伴口干胃痛—舌质红(热/阴虚)+舌苔无(胃阴大伤)=胃阴虚；一位糖尿病人口干舌红少苔—舌质红(阴虚)+舌苔少(津亏)=阴虚津亏。另一位患者舌淡胖苔白滑—舌质淡白(气血虚)+苔白滑(寒湿)=脾虚寒湿。舌质舌苔结合起来才能准确辨证。</div>'}
]}
]},
{unit:'第五单元 闻诊',subunits:[
{name:'细目一：听声音',points:[
{id:'dx-19-1',name:'音哑与失音的临床意义',type:'detail',content:'<p>音哑新病外感(金实不鸣)久病肺肾阴虚(金破不鸣)。失音完全不能发音。</p><div class=compare-table><div class=ct-left><h4>金实不鸣(新病实证)</h4><p>突然声音嘶哑</p><p>外感风寒或风热</p><p>声带充血水肿</p><p>→宣肺开音</p></div><div class=ct-right><h4>金破不鸣(久病虚证)</h4><p>逐渐声音嘶哑</p><p>肺肾阴虚津亏</p><p>声带慢性病变</p><p>→滋阴润肺(百合固金汤)</p></div></div><div class=trap-box><strong>金实不鸣(实)+金破不鸣(虚)：</strong>新病暴哑多实(风寒风热壅遏肺气)；久病渐哑多虚(肺肾阴虚津不上承)。鉴别关键在病程长短和起病缓急。</div><div class=clinical-case>一位感冒后突然声音嘶哑说不出话伴恶寒发热——金实不鸣用麻黄汤宣肺开音三天恢复。一位教师长期用嗓过度慢声嘶哑一年伴口干咽燥手足心热——金破不鸣用百合固金汤加木蝴蝶蝉蜕滋阴润肺开音两月好转。教师和歌手是金破不鸣的高发人群。</div>'},
{id:'dx-19-2',name:'谵语郑声独语错语的概念及临床意义',type:'detail',content:'<p>谵语神识不清语无伦次声高有力实热证(安宫牛黄丸)。郑声语言重复声低无力虚证临危。独语自言自语见人便止心气不足。错语言语错乱说后自知心脾两虚。</p><div class=compare-table><div class=ct-left><h4>四种语言异常</h4><p><strong>谵语：</strong>语无伦次声高有力→实热证(安宫牛黄丸)</p><p><strong>郑声：</strong>语言重复声低无力→虚证临危</p><p><strong>独语：</strong>自言自语见人便止→心气不足</p><p><strong>错语：</strong>言语错乱说后自知→心脾两虚</p></div><div class=ct-right><h4>鉴别口诀</h4><p>谵语声高为实热(安宫牛黄丸)</p><p>郑声声低为虚极(危重证)</p><p>独语自言心不足</p><p>错语错后心脾虚</p></div></div><div class=trap-box><strong>鉴别口诀：</strong>谵语声高为实热(安宫牛黄丸)；郑声声低为虚极(危重证)；独语自言心不足；错语错后心脾虚。核心区别在声音高低——谵语法实(声高)、郑声法虚(声低)。</div><div class=clinical-case>一位高烧40度肺炎患者胡言乱语声高有力面红谵语——实热证用安宫牛黄丸清心开窍。一位危重患者语言重复声低无力郑声——虚极危重用参附汤回阳救逆。辨别关键是声音高低——谵语声高为实、郑声声低为虚。</div>'},
{id:'dx-19-3',name:'咳嗽喘哮短气少气的概念及临床意义',type:'detail',content:'<p>咳、喘、哮、短气、少气是呼吸系统常见的五种症状，各有特征和辨证要点。</p><div class=compare-table><div class=ct-left><h4>五种症状鉴别</h4><p><strong>咳嗽：</strong>肺气上逆冲击喉间发声。咳声重浊→寒咳；咳声清脆→燥咳；咳声不扬→热咳</p><p><strong>喘：</strong>呼吸困难。实喘(呼出为快)呼吸深长→痰浊阻肺(三拗汤)；虚喘(吸人为快)短促难续→肾不纳气(肾气丸)</p><p><strong>哮：</strong>喉中哮鸣音如哨→痰伏于肺(射干麻黄汤)。哮必兼喘但喘不一定兼哮</p><p><strong>短气：</strong>呼吸短促不能接续→气虚(补中益气汤)</p><p><strong>少气：</strong>呼吸微弱声低→气虚(四君子汤)</p></div><div class=ct-right><h4>临床要点</h4><p>咳重在声、喘在呼吸深度</p><p>哮在喉中声音、喘在气息出入</p><p>实喘呼出为快(呼多吸少)</p><p>虚喘吸人为难(吸多呼少)</p><p>短气+少气=气虚(补气为主)</p><p>哮是宿根遇诱因发作(治标兼治本)</p></div></div><div class=trap-box><strong>喘和哮的区别：</strong>喘是呼吸急促(以气息言)；哮是喉间哮鸣(以声音言)。哮必兼喘但喘不一定兼哮。实喘呼出为快(痰浊)用苏子降气汤；虚喘吸入为快(肾虚)用肾气丸。哮有宿根发作时治标(射干麻黄汤)缓解期治本(金匮肾气丸)。</div><div class=clinical-case>一位老慢支患者一遇寒冷就发作喘息喉中哮鸣有声——哮喘宿根用射干麻黄汤温肺化饮平喘。另一位老年肾虚患者气喘呼多吸少动则加重腰膝酸软——肾不纳气虚喘用金匮肾气丸补肾纳气。还有一位大病后患者呼吸微弱声低——少气(气虚)用四君子汤补气。</div>'},
{id:'dx-19-4',name:'呕吐呃逆嗳气的概念及临床意义',type:'detail',content:'<p>呕(有物有声)、吐(有物无声)、干呕(无物有声)、呃逆(呃呃连声)、嗳气(胃气上冲)都是胃气上逆的表现。胃以降为和——不降反升则为病。</p><div class=compare-table><div class=ct-left><h4>三种胃气上逆</h4><p><strong>呕吐：</strong>胃内容物从口而出。食入即吐→胃热(热迫急吐)；朝食暮吐→胃寒(寒凝缓吐)；呕吐酸腐→食积(保和丸)；呕吐清水→痰饮</p><p><strong>呃逆：</strong>膈肌痉挛有声。呃声高亢有力→实热(胃火上冲)；呃声低弱无力→虚寒(胃气衰败)；久病重病呃逆→预后不良</p><p><strong>嗳气：</strong>胃气上冲有声。嗳气酸腐→食积(保和丸)；嗳气无味→肝气犯胃(柴胡疏肝散)；嗳气频频→胃虚气逆</p></div><div class=ct-right><h4>辨证要点</h4><p>食入即吐→热(胃热上冲)→大黄甘草汤</p><p>朝食暮吐→寒(胃中虚冷)→丁香透膈散</p><p>呃逆声高→实(胃火)→竹叶石膏汤</p><p>呃逆声低→虚(胃衰)→理中汤/危重</p><p>嗳气酸腐→食积→保和丸</p><p>嗳气频作→肝胃不和→柴胡疏肝散</p><p>久病呃逆→脾胃衰败→预后不良</p></div></div><div class=trap-box><strong>呃逆的特殊意义：</strong>呃逆一证轻者可自愈(吃太饱/受凉)，但久病重病出现呃逆声低无力是胃气将绝的危重征象(如晚期癌症出现呃逆预后极差)。新病呃逆多实(易治)；久病呃逆多虚(难治)。</div><div class=clinical-case>一位暴饮暴食后胃胀嗳腐吞酸——食积用保和丸消食导滞嗳气消失。一位晚期胃癌患者连续呃逆声低弱无力——胃气衰败预后不良。一位孕妇晨起恶心呕吐——妊娠反应(胃气上逆)用小半夏汤和胃降逆。一位生气后嗳气频频胃胀——肝气犯胃用柴胡疏肝散疏肝和胃。</div>'}
]},
{name:'细目二：嗅气味',points:[{id:'dx-20-1',name:'口气病室气味异常的临床意义',type:'detail',content:'<p>嗅气味是闻诊的一部分——口气反映消化系统、病室气味反映全身性疾病的特有表现。某些特殊气味具有强烈提示意义。</p><div class=compare-table><div class=ct-left><h4>口气异常</h4><p><strong>口气臭秽：</strong>胃热/牙周病/口腔不洁→清胃散</p><p><strong>口气酸馊：</strong>食积胃脘(伤食)→保和丸消食</p><p><strong>口气腥臭：</strong>牙龈出血/鼻衄</p><p><strong>口中有脓臭：</strong>肺痈/鼻渊</p></div><div class=ct-right><h4>病室气味</h4><p><strong>尿臊味(氨味)：</strong>水肿晚期(肾功能衰竭/尿毒症)</p><p><strong>烂苹果味(酮味)：</strong>消渴重症(糖尿病酮症酸中毒)</p><p><strong>血腥味：</strong>失血证(内出血/大咯血)</p><p><strong>腐臭味：</strong>疮疡溃脓(痈疽溃烂)</p></div></div><div class=trap-box><strong>特殊气味与危重证的关联：</strong>尿臊味→肾功能衰竭(尿毒症)；烂苹果味→糖尿病酮症酸中毒(危重)；血腥味→大出血(急症)。这三种特殊气味一旦闻到提示病情危重需要紧急处理。</div><div class=clinical-case>一位糖尿病患者意识模糊呼吸有烂苹果味——糖尿病酮症酸中毒。一位水肿晚期患者病室有尿臊味——肾功能衰竭(尿毒症)。一位胃热患者口气臭秽伴牙龈红肿——胃火上炎用清胃散。</div>'}]}
]},
{unit:'第六单元 脉诊',subunits:[
{name:'细目一：脉诊概说',points:[
{id:'dx-21-1',name:'寸口脉与脏腑的关系',type:'detail',content:'<p><strong>寸口脉(桡动脉)</strong>分为寸关尺三部，分别对应不同脏腑。左主血分(心肝肾)、右主气分(肺脾肾)。</p><div class=compare-table><div class=ct-left><h4>寸关尺配脏腑</h4><p><strong>左手(血分)：</strong>寸→心、关→肝胆、尺→肾(阴)</p><p><strong>右手(气分)：</strong>寸→肺、关→脾胃、尺→肾(阳)</p><p><strong>分部：</strong>桡骨茎突内侧为关、关前为寸、关后为尺</p></div><div class=ct-right><h4>临床意义</h4><p>某部脉异常反映对应脏腑病变：左寸异常→心病(心悸失眠)、左关异常→肝病(胁痛)、右关异常→脾胃病(纳呆)、两尺异常→肾病(腰酸)</p><p><strong>口诀：</strong>左心肝肾(血分)、右肺脾肾(气分)</p></div></div><div class=trap-box><strong>考核要点：</strong>左寸心、左关肝胆、左尺肾阴；右寸肺、右关脾胃、右尺肾阳。三部九候—每部浮中沉三种取法。</div><div class=clinical-case>一位失眠患者左寸脉独大有力伴舌尖红心烦——心火亢盛对应左寸(心)用导赤散清心火。一位胁痛患者左关脉弦有力——肝郁气滞对应左关(肝胆)用柴胡疏肝散。</div>'},
{id:'dx-21-2',name:'切脉指法',type:'apply',content:'<p><strong>切脉</strong>是中医四诊中最具技术含量的诊法。正确的指法才能获得准确的脉象信息。</p><div class=compare-table><div class=ct-left><h4>定位方法</h4><p><strong>中指定关：</strong>先以中指按在桡骨茎突内侧(关部)</p><p><strong>食指定寸：</strong>食指在关前(远心端)为寸部</p><p><strong>无名指定尺：</strong>无名指在关后(近心端)为尺部</p><p>三指微曲呈弓形、指端齐平、以指腹触脉</p></div><div class=ct-right><h4>三种取法(举按寻)</h4><p><strong>浮取(举)：</strong>轻用力触皮肤——候心肺之气(表证)</p><p><strong>中取(寻)：</strong>中等用力——候脾胃之气</p><p><strong>沉取(按)：</strong>重按至筋骨——候肝肾之气(里证)</p><p>三部九候：每部的浮中沉三取共九种信息</p></div></div><div class=trap-box><strong>切脉要点：</strong>中指定关是关键——先找到桡骨茎突再定位关部。举按寻三取法对应表里深浅。注意：三指间距应与病人前臂成比例(病人高矮胖瘦不同)。</div><div class=clinical-case>一位感冒患者浮取即得明显脉象(浮脉)轻取有余重按稍减——典型的浮脉对应表证用解表药。另一位肾虚患者浮取不明显重按始得(沉脉)——里证对应肾病用补肾药。同一病人同一切脉三种取法获得的脉象信息完全不同。</div>'},
{id:'dx-21-3',name:'寸口三部九候概念',type:'detail',content:'<p><strong>三部九候</strong>是寸口诊法的基本框架——三部(寸关尺)每部三种取法(浮中沉)共九种候脉信息，全面反映脏腑气血状态。这是寸口脉诊的精髓所在。</p><div class=compare-table><div class=ct-left><h4>三部(位置)</h4><p><strong>寸部(前)：</strong>心肺(上焦)</p><p><strong>关部(中)：</strong>肝胆脾胃(中焦)</p><p><strong>尺部(后)：</strong>肾(下焦)</p></div><div class=ct-right><h4>九候(取法)</h4><p>每部取浮中沉三种力度：</p><p><strong>浮取(举)：</strong>轻触皮肤→候心肺表证</p><p><strong>中取(寻)：</strong>中等用力→候脾胃</p><p><strong>沉取(按)：</strong>重按至骨→候肝肾里证</p><p>三节×三力=九种诊断信息</p></div></div><div class=trap-box><strong>三部九候的价值：</strong>单纯一个脉象只能知道大概(如浮脉为表)，但通过三部九候可以具体定位到哪一脏(如左寸浮为心经表证、右关数为脾胃热证)。三部九候是寸口诊法从笼统到精准的关键。</div><div class=clinical-case>一位患者左寸浮数(浮取即得+快)——心经有热(舌尖红心烦)用导赤散清心火。另一位右关沉细(中取沉细)——脾胃虚弱(纳差乏力)用参苓白术散健脾。同是沉脉—左尺沉为肾虚、右关沉为脾虚。三部九候让定位更精准。</div>'}
]},
{name:'细目二：正常脉象',points:[
{id:'dx-22-1',name:'正常脉象的特点',type:'detail',content:'<p><strong>正常脉象(平脉)</strong>是不浮不沉、不快不慢、从容和缓、节律一致的脉象。健康成人一息四至(约72-80次/分)。平脉有胃神根三个特征。</p><div class=compare-table><div class=ct-left><h4>平脉特点</h4><p><strong>三部有脉：</strong>寸关尺三部都可触及脉搏</p><p><strong>不浮不沉：</strong>中取即得、轻取不显、重取不绝</p><p><strong>不快不慢：</strong>一息四至(72-80次/分)</p><p><strong>从容和缓：</strong>脉来柔和平稳有节奏</p><p><strong>节律一致：</strong>每次搏动间期均匀</p></div><div class=ct-right><h4>胃神根</h4><p><strong>有胃：</strong>脉来从容和缓——反映脾胃运化功能正常(有胃气则生)</p><p><strong>有神：</strong>脉来柔和有力——反映心功能正常、气血充足</p><p><strong>有根：</strong>尺部沉取有力——反映肾气充足(根深则枝叶茂)</p><p>胃神根三者缺一不可——有胃为平脉、有神为健脉、有根为生命稳固</p></div></div><div class=trap-box><strong>正常脉象的记忆：</strong>一息四至72-80次/分、不浮不沉、从容和缓。胃(和谐感)、神(力量感)、根(安定感)。脉有胃神根—即使有病也易治；脉无胃神根—无胃则死、无神则危、无根则绝。</div><div class=clinical-case>一位健康青年体检脉象从容和缓有力三部有脉一息四至——标准的平脉(有胃神根)。另一位重症患者脉来急促无序无根无神——胃气将绝之兆(危重)。脉象的胃神根是判断预后的重要依据。</div>'},
{id:'dx-22-2',name:'正常脉象胃神根的含义',type:'detail',content:'<p><strong>胃神根</strong>是判断脉象好坏(从而判断预后)的三个维度——胃是脉的和谐感、神是脉的力量感、根是脉的安定感。</p><div class=compare-table><div class=ct-left><h4>胃——脉之母</h4><p><strong>含义：</strong>脉来从容和缓、节律均匀</p><p><strong>反映：</strong>脾胃运化功能正常、气血生化有源</p><p><strong>临床：</strong>有胃则生——即使病重但脉有胃气预后尚好；无胃则死——脉来急促无序毫无从容感为危重</p><p><strong>表现：</strong>脉来柔和不疾不徐、有自然节奏</p></div><div class=ct-right><h4>神——脉之主</h4><p><strong>含义：</strong>脉来柔和有力、应指清晰</p><p><strong>反映：</strong>心功能正常、气血充足</p><p><strong>临床：</strong>有神则病易治、无神则病难愈</p><p><strong>表现：</strong>按之应指、不虚不散</p></div></div><div class=compare-table style="margin-top:6px"><div class=ct-left><h4>根——脉之基</h4><p><strong>含义：</strong>尺部沉取有力</p><p><strong>反映：</strong>肾气充足、生命根基稳固</p><p><strong>临床：</strong>有根则病虽重不死(肾为先天之本)；无根则生命垂危</p><p><strong>表现：</strong>尺脉不绝、按之有力</p></div><div class=ct-right><h4>临床口诀</h4><p>胃为脉之母(脾胃)</p><p>神为脉之主(心)</p><p>根为脉之基(肾)</p><p>三脉俱全→平脉健康</p><p>缺一→病脉</p><p>全无→死脉(预后极差)</p></div></div><div class=trap-box><strong>胃神根的临床价值：</strong>胃(脾胃功能)→决定营养状态；神(心脏功能)→决定循环状态；根(肾脏功能)→决定生命根基。三者对应脾心肺肾四个根本脏器。危重病人判断预后先看脉有无胃神根。</div><div class=clinical-case>一位危重患者脉象急促紊乱毫无从容之态(无胃)—胃气将绝预后不良。另一位慢性病久患者两尺脉沉取无力(无根)—肾气大亏生命根基动摇。还有一位大病初愈者脉来有根有神—虽有病但基础尚在预后良好。胃神根是判断预后的重要依据。</div>'}
]},
{name:'细目三：常见病脉',points:[
{id:'dx-23-1',name:'常见病脉的脉象特征及主病',type:'detail',content:'<p>十五种常见病脉可以分为六大类来掌握——<strong>深浅类(浮沉)</strong>、<strong>快慢类(迟数)</strong>、<strong>流畅类(滑涩)</strong>、<strong>强弱类(洪细微)</strong>、<strong>紧张类(紧弦濡)</strong>、<strong>不规律类(结促代)</strong>。</p><div class=compare-table><div class=ct-left><h4>十五脉分类速查</h4><p><strong>深浅类：</strong>浮脉(轻取即得→表证)、沉脉(重按始得→里证)</p><p><strong>快慢类：</strong>迟脉(一息<4至→寒证)、数脉(一息>5至→热证)</p><p><strong>流畅类：</strong>滑脉(如珠走盘→痰饮食积妊娠)、涩脉(如刀刮竹→血瘀精亏)</p><p><strong>强弱类：</strong>洪脉(来盛去衰如波涛→气分实热)、细脉(细如线→气血两虚)、微脉(极细欲绝→阳气衰微)</p><p><strong>紧张类：</strong>紧脉(如转索→寒证痛证)、弦脉(如按琴弦→肝胆病)、濡脉(浮细软→虚证湿证)</p><p><strong>不规律类：</strong>结脉(缓而时止止无定数→阴盛气结)、促脉(数而时止止无定数→阳盛实热)、代脉(有规律停跳止有定数→脏气衰微)</p></div><div class=ct-right><h4>脉诊辨证口诀</h4><p><strong>浮沉辨表里：</strong>浮表沉里</p><p><strong>迟数辨寒热：</strong>迟寒数热</p><p><strong>滑涩辨气血：</strong>滑痰湿/妊娠、涩瘀血/精亏</p><p><strong>洪细辨虚实：</strong>洪实热、细虚、微阳衰</p><p><strong>弦紧辨痛证：</strong>弦肝胆、紧寒痛</p><p><strong>结促代辨心律：</strong>结寒促热代脏衰</p><p><strong>濡脉辨湿：</strong>浮细软为濡→虚证湿证</p></div></div><div class=trap-box><strong>结促代鉴别—高频考点：</strong>结脉→缓而时止(慢而不规则停跳)→阴盛气结；促脉→数而时止(快而不规则停跳)→阳盛实热；代脉→有规律停跳(规律性停跳)→脏气衰微。口诀：结慢促快代规律。</div><div class=clinical-case>一位感冒患者浮取即得明显脉象—浮脉(表证)用解表药。一位心衰患者脉极细软弱按之欲绝—微脉(阳气衰微)用参附汤回阳救逆。一位甲亢患者脉快一息七至—数脉(热证)用清热药。一位房颤患者脉律绝对不齐快慢不一—涩脉/促脉交错(心脉痹阻)用炙甘草汤。</div>'}
]}
]},
{unit:'第七单元 按诊',subunits:[{name:'按诊',points:[
{id:'dx-24-1',name:'按肌肤的内容及临床意义',type:'detail',content:'<p>按肌肤是通过触摸皮肤的温度、湿度、弹性来判断病性——寒热辨表里、润燥辨津液、凹陷辨水肿气肿。</p><div class=compare-table><div class=ct-left><h4>按肌肤要点</h4><p><strong>辨寒热：</strong>肌肤灼热→热证(实热/虚热)；肌肤发凉→寒证(实寒/虚寒)。初按热甚久按转轻→表热；初按热轻久按转甚→里热</p><p><strong>辨润燥：</strong>皮肤润泽→津液正常；皮肤干燥→津液不足；皮肤甲错→瘀血(肌肤甲错为内有干血)</p><p><strong>辨水肿：</strong>按之凹陷不能即起→水肿(按之没指)；举手即起→气肿(气郁)</p><p><strong>辨疮疡：</strong>按之肿硬不热→阴证；肿处灼热→阳证</p></div><div class=ct-right><h4>临床口诀</h4><p>肤冷为寒肤热为热</p><p>初热久轻表热证</p><p>初轻久甚里热证</p><p>润则津充燥则津亏</p><p>凹陷水肿不起气肿</p><p>甲错瘀血在内</p></div></div><div class=trap-box><strong>按肌肤鉴别：</strong>水肿(凹陷不起+按之没指)→水湿停聚(利水)；气肿(即起+按之弹性好)→气滞(行气)。肌肤甲错皮肤粗糙如鳞甲→内有瘀血(活血化瘀)。</div><div class=clinical-case>一位肾病综合征患者双下肢按之凹陷不起没指→水肿(水湿停聚)用五苓散合真武汤温阳利水。一位肝硬化患者皮肤粗糙甲错面色晦暗→内有瘀血(肌肤甲错)用血府逐瘀汤活血化瘀。一位感冒患者初按皮肤灼热久按转轻→表热证用银翘散辛凉解表。</div>'},
{id:'dx-24-2',name:'按腹部辨疼痛痞满积聚的要点',type:'apply',content:'<p>按腹部是诊断内脏病变的重要手段——通过触按腹部了解疼痛性质、痞硬程度和包块情况。核心是辨虚实：喜按为虚、拒按为实。</p><div class=compare-table><div class=ct-left><h4>腹部按诊内容</h4><p><strong>辨疼痛虚实：</strong>喜按(按压后舒服)→虚证(小建中汤)；拒按(按压后更痛)→实证(大承气汤/大黄牡丹皮汤)</p><p><strong>辨痞满(心下)：</strong>按之硬满疼痛→结胸证(大陷胸汤)；按之濡软不痛→痞证(半夏泻心汤)</p><p><strong>辨积聚(包块)：</strong>痛有定处按之有形不移→积(血分/瘀血)；痛无定处按之无形聚散不定→聚(气分/气滞)</p><p><strong>辨肠痈：</strong>右下腹按痛反跳痛→肠痈(大黄牡丹皮汤)</p></div><div class=ct-right><h4>临床口诀</h4><p>喜按为虚→补</p><p>拒按为实→泻</p><p>按之硬痛→结胸(实)</p><p>濡软不痛→痞证(虚)</p><p>有形不移→积(血)</p><p>无形聚散→聚(气)</p></div></div><div class=trap-box><strong>腹部按诊要点：</strong>喜按为虚(小建中汤)、拒按为实(大承气汤)。积为血分(痛有定处+按之有形—活血化瘀)；聚为气分(痛无定处+按之无形—行气消聚)。结胸证按之痛是实热互结；痞证按之不痛是寒热错杂。</div><div class=clinical-case>一位急性阑尾炎患者右下腹按痛拒按反跳痛——实证用大黄牡丹皮汤通腑泄热化瘀。一位慢性胃炎患者上腹隐痛喜按喜温——虚证用小建中汤温中补虚。一位肝硬化患者胁下触及硬块固定不移刺痛——积(瘀血)用膈下逐瘀汤。一位情绪抑郁患者时感腹部气窜痛聚散不定——聚(气滞)用柴胡疏肝散。</div>'},
{id:'dx-24-3',name:'按胸部虚里的内容及临床意义',type:'detail',content:'<p><strong>虚里</strong>是左乳下的心尖搏动处——胃之大络、宗气汇聚之所。按虚里可了解宗气盛衰和心功能状态。</p><div class=compare-table><div class=ct-left><h4>虚里按诊</h4><p><strong>正常：</strong>搏动和缓有力一息4-5次→宗气充足心功能正常</p><p><strong>搏动过强：</strong>按之应手甚则衣动→宗气外泄(虚劳/心气亏虚)</p><p><strong>搏动过弱：</strong>按之微弱无力→宗气不足(心肺气虚)</p><p><strong>搏动停止：</strong>按之绝不应手→死候(心肺功能衰竭)</p><p><strong>搏动范围过大：</strong>搏动弥散移位→心气大虚</p></div><div class=ct-right><h4>临床意义</h4><p>虚里是观察宗气盛衰的窗口——</p><p>宗气=肺吸入清气+脾胃水谷精气合成</p><p>宗气功能：贯心脉行呼吸</p><p>虚里搏动太强→宗气外泄(心衰代偿)</p><p>虚里搏动太弱→宗气不足(心功能减退)</p><p>虚里绝不应手→死候(心搏停止)</p><p>虚里弥散→心气大虚(扩张性心肌病)</p></div></div><div class=trap-box><strong>虚里按诊的价值：</strong>虚里(心尖搏动)是中医观察宗气和心脏功能的窗口。搏动过强为宗气外泄—心功能不全的代偿期；搏动过弱为宗气不足—心功能减退；搏动停止为死候。左乳下虚里是诊断心肺功能的重要部位。</div><div class=clinical-case>一位心衰患者左乳下虚里搏动明显过强甚则衣动—宗气外泄(心脏代偿)用生脉散合葶苈大枣泻肺汤益气强心。另一位老年虚弱患者虚里搏动微弱几乎触不及—宗气不足心肺气虚用炙甘草汤合保元汤益气温阳。虚里的变化客观反映了心功能状态。</div>'}
]}]},
{unit:'第八单元 八纲',subunits:[
{name:'细目一：概述',points:[{id:'dx-25-1',name:'八纲辨证的概念',type:'concept',content:'<p><strong>八纲</strong>——表里·寒热·虚实·阴阳，是中医辨证的总框架。阴阳为总纲（表热实属阳、里寒虚属阴）。辨证第一步就是"分表里→分寒热→分虚实→定阴阳"。八纲是所有辨证方法的基础，但不包括气血津液、脏腑经络等具体内容。</p><div class="classic-quote">《素问》："善诊者，察色按脉，先别阴阳。"<span class="src">——《黄帝内经》</span></div><div class="mnem">八纲辨证总框架，表里寒热虚实加阴阳；表热实属阳，里寒虚属阴，先别阴阳方向定。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">八纲辨证<br>四大维度</span><span class="df-arrow">→</span><span class="df-node df-logic">表里→病位<br>寒热→病性<br>虚实→正邪</span><span class="df-arrow">→</span><span class="df-node df-organ">阴阳→总纲<br>统摄六纲</span><span class="df-arrow">→</span><span class="df-node df-symptom">辨证第一<br>张地图</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">八纲辨证——中医诊断的"第一张地图"</span><div class="ds-body">八纲就是把所有疾病的特征抽象为四个维度：病位（表/里）——病在浅层皮毛还是深层脏腑？病性（寒/热）——体内是寒盛还是热盛？正邪关系（虚/实）——是正虚还是邪实？总分类（阴/阳）——把前三个维度归为阴阳两大类。一个病人来了，先看恶寒发热并见→病在表（表里维度），再看怕冷重还是发热重→寒/热（寒热维度），再看脉搏有力还是无力→实/虚（虚实维度），最后合并判断→是阳证（表实热）还是阴证（里虚寒）。四个维度八种可能性，就叫"八纲"。《素问》说"善诊者察色按脉先别阴阳"——诊断的第一原则就是先把病归入"阳"或"阴"的大方向，方向对了再细化。</div></div></div></div></div><div class=compare-table><div class=ct-left><h4>八纲框架</h4><p><strong>表里→病位：</strong>表证(浅在皮毛肌表)、里证(深在脏腑气血)</p><p><strong>寒热→病性：</strong>寒证(阴邪/阳虚)、热证(<div class=compare-table><div class=ct-left><h4>八纲框架</h4><p><strong>表里→病位：</strong>表证(浅在皮毛肌表)、里证(深在脏腑气血)</p><p><strong>寒热→病性：</strong>寒证(阴邪/阳虚)、热证(阳邪/阴虚)</p><p><strong>虚实→正邪：</strong>虚证(正气不足)、实证(邪气亢盛)</p><p><strong>阴阳→总纲：</strong>表热实属阳、里寒虚属阴</p></div><div class=ct-right><h4>应用顺序</h4><p>第一步分表里→第二步分寒热→第三步分虚实→第四步定阴阳</p><p>例如发热病人：恶寒发热=表→热重寒轻=热→脉有力=实→结论：表热实证=风热感冒=辛凉解表</p></div></div><div class=trap-box><strong>考核重点：</strong>阴阳是八纲总纲。八纲不包括气血津液、脏腑经络。先别阴阳是诊断的第一原则。</div><div class=clinical-case>一位急诊高热患者面红声高气粗烦躁便秘腹满拒按。年轻医生看到面红认为是热证准备用清热药。老师纠正说还要看虚实——腹满拒按便秘说明是实热证而非虚热证。实证要泻(大承气汤)虚证才用补。用错方向会雪上加霜。</div>'}
]},
{name:'细目二：表里',points:[
{id:'dx-26-1',name:'表证与里证的概念',type:'concept',content:'<p><strong>表证</strong>是外感六淫从皮毛口鼻侵入肌表经络——起病急、病程短、病位浅。<strong>里证</strong>在脏腑气血，可由表传里或直中内伤。核心鉴别：恶寒发热并见+脉浮=表证；但热不寒或但寒不热+脏腑症状=里证。治则：表证用汗法，里证随证用温清消补。</p><div class="classic-quote">《素问》："其在皮者，汗而发之。"<span class="src">——《黄帝内经》</span></div><div class="mnem">恶寒发热并见表证浮，但寒但热无表里证求；表用汗法里随证，表里传变时时留。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">表证<br>病在皮毛肌表</span><span class="df-arrow">→</span><span class="df-node df-logic">外邪袭表<br>卫气被郁<br>正邪交争于表</span><span class="df-arrow">→</span><span class="df-node df-organ">恶寒发热并见<br>头身痛脉浮<br>苔薄白</span><span class="df-arrow">→</span><span class="df-node df-symptom">汗法解表<br>风寒辛温·风热辛凉</span></div></div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">里证<br>病在脏腑气血</span><span class="df-arrow">→</span><span class="df-node df-logic">表邪入里<br>外邪直中<br>内伤七情饮食</span><span class="df-arrow">→</span><span class="df-node df-organ">但热不寒/但寒不热<br>脏腑症状为主<br>舌苔变化脉沉</span><span class="df-arrow">→</span><span class="df-node df-symptom">温清消补<br>随其证而治之</span></div></div><div class=compare-table><div class=ct-left><h4>表证</h4><p>外感六淫侵入皮毛</p><p>起病急病程短(3-7天)</p><p>病位浅在皮毛肌表经络</p><p>恶寒发热并见+脉浮</p><p>治则：解表(汗法)</p></div><div class=ct-right><h4>里证</h4><p>表邪入里/外邪直中/内伤</p><p>病程可长可短</p><p>病位深在脏腑气血骨髓</p><p>但热不寒/但寒不热+脉沉</p><p>治则：温清消补随证治之</p></div></div><div class=trap-box><strong>表里鉴别核心：</strong>恶寒发热是否并见——并见=表证；只热不寒或只寒不热=里证。表里可以转化——感冒不治可传里成肺炎(由表入里)。</div><div class=clinical-case>一位年轻人感冒开始怕冷发热流鼻涕——表证用荆防败毒散辛温解表。三天后高烧不退咳吐黄痰胸痛—从表传里变为里证(肺炎)用麻杏石甘汤清肺泄热。表里转化一目了然。</div>'},
{id:'dx-26-2',name:'表证的临床表现辨证要点',type:'detail',content:'<p><strong>表证</strong>是人体防御系统（卫气）在体表与外邪交战的反应。核心特征：恶寒发热并见+头身痛+鼻塞+脉浮。辨证铁律：恶寒发热并见=表证。治则：辛散解表（风寒用辛温、风热用辛凉）。</p><div class="classic-quote">《素问》："其在皮者，汗而发之。"<span class="src">——《黄帝内经》</span></div><div class="mnem">恶寒发热头身痛，鼻塞脉浮表证求；风寒辛温风热凉，汗出邪去病自休。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">表证<br>病在皮毛</span><span class="df-arrow">→</span><span class="df-node df-logic">卫气趋表<br>与邪交争</span><span class="df-arrow">→</span><span class="df-node df-organ">恶寒（卫郁）<br>发热（正争）<br>脉浮（气趋表）</span><span class="df-arrow">→</span><span class="df-node df-symptom">风寒→麻黄汤<br>风热→银翘散</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">表证的生理机制——为什么"恶寒发热"会同时出现？</span><div class="ds-body">表证的本质是人体调动防御力量（卫气）到体表和外邪"打仗"。外邪（风寒等）刚刚侵袭体表→卫气被"困"在皮毛和肌肉之间不能正常散布→人感觉怕冷（恶寒——卫气被困的体感）。同时人体主动升高体温来"烧死"外邪→所以发热（正邪交争的产热）。气血全被调到体表助战→所以脉浮（像浮在水面的木头——按之即得）。这些反应的共同目的是把外邪"堵"在体表、通过发汗把它赶出去——所以治疗必须用"汗法"（</div></div></div><div class=compare-table><div class=ct-left><h4>典型表现</h4><p><strong>恶寒发热：</strong>怕冷与发热同时出现——最关键特征</p><p><strong>头身疼痛：</strong>外邪阻滞经络不通则痛</p><p><strong>鼻塞流涕：</strong>肺开窍于鼻——外邪犯肺</p><p><strong>咽喉痒咳：</strong>邪犯咽喉肺气失宣</p><p><strong>脉浮苔薄白：</strong>气血趋表抗邪</p></div><div class=ct-right><h4>辨证要点</h4><p><strong>恶寒发热并见=表证——这是铁律</strong></p><p>表证的本质是人体把防御力量调到体表与外邪作战：怕冷(卫气被郁)→发热(正邪交争)→脉浮(气血趋表)。任何一诊缺失都可能误诊。</p><p><strong>鉴别：</strong>感冒初起恶寒发热→表证；肺炎但热不寒→里证</p></div></div><div class=trap-box><strong>表证特征速记：</strong>恶寒发热并见+头身痛+鼻塞+脉浮=表证。治则：辛散解表。风寒用辛温(麻黄汤荆防败毒散)、风热用辛凉(银翘散)。</div><div class=clinical-case>一位受凉后恶寒发热头痛身痛鼻塞流清涕脉浮的患者诊断为风寒表证用荆防败毒散加减。服药后盖被微微出汗第二天恶寒发热消失。表证用汗法解表邪去则安。</div>'},
{id:'dx-26-3',name:'表证与里证的鉴别要点',type:'compare',content:'<p>表证和里证的鉴别是辨证的第一步——病在表还是病在里，决定了治法是汗法还是清消法。一句话鉴别：<strong>恶寒发热并见=表证（在表）；但热不寒或但寒不热=里证（入里）</strong>。</p><div class="classic-quote">《素问》："善治者治皮毛，其次治肌肤，其次治筋脉，其次治六腑，其次治五脏。"<span class="src">——《黄帝内经》</span></div><div class="mnem">恶寒发热并在表，但寒但热已入里；脉浮新病归于表，脉沉久病里中求。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">表里鉴别<br>病位第一关</span><span class="df-arrow">→</span><span class="df-node df-logic">恶寒发热→表<br>但寒/但热→里<br>脉浮→表 脉沉→里</span><span class="df-arrow">→</span><span class="df-node df-organ">新病多表<br>久病多里</span><span class="df-arrow">→</span><span class="df-node df-symptom">汗法 vs<br>温清消补</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">表里的可逆性——善治者治皮毛</span><div class="ds-body">表证和里证不是一为表永远为表——它们可以双向转化。感冒初期是表证（恶寒发热），如果没及时正确治疗，病邪可由表入里→变成肺炎（但热不寒+咳喘）→里证。反之，里证也可能出表——如麻疹出疹后热退（病邪从里透发到体表）。治疗的核心策略是阻断表邪入里的传变路径——也就是既病防变——在表证阶段就把邪气从汗孔赶出去，不给它机会深入脏腑。</div></div></div><div class=compare-table><div class=ct-left><h4>表证(病在表)</h4><p><strong>寒热：</strong>恶寒发热并见</p><p><strong>伴随：</strong>头身痛、鼻塞流涕</p><p><strong>舌脉：</strong>苔薄白、脉浮</p><p><strong>病程：</strong>短(新病)</p><p><strong>病位：</strong>皮毛肌表经络</p><p><strong>治则：</strong>解表(汗法)</p></div><div class=ct-right><h4>里证(病在里)</h4><p><strong>寒热：</strong>但热不寒或但寒不热</p><p><strong>伴随：</strong>以脏腑症状为主(咳喘呕恶腹痛)</p><p><strong>舌脉：</strong>舌苔有变化、脉沉</p><p><strong>病程：</strong>可长可短</p><p><strong>病位：</strong>脏腑气血骨髓</p><p><strong>治则：</strong>温清消补随证</p></div></div><div class=trap-box><strong>一句话鉴别：</strong>恶寒发热并见=表证(在表)；但热不寒或但寒不热=里证(入里)。感冒初起是表证，不治传里成肺炎就是里证。</div><div class=clinical-case>一位年轻人感冒开始怕冷发热流鼻涕——表证。没有及时治疗三天后高烧不退咳吐黄痰胸痛——从表证传里变为里证(肺炎)。用麻杏石甘汤清肺泄热后好转。这个病例体现了表证可转为里证——善治者治皮毛，既病防变的道理就在这里。</div>'}
]},
{name:'细目三：寒热',points:[
{id:'dx-27-1',name:'寒证与热证的概念',type:'concept',content:'<p><strong>寒证</strong>是感受寒邪或阳虚阴盛——功能衰退。特征：怕冷、面白、便溏、苔白。<strong>热证</strong>是感受热邪或阴虚阳亢——功能亢进。特征：怕热、面红、便秘、苔黄。治则：寒者热之，热者寒之。</p><div class="classic-quote">《素问》："寒者热之，热者寒之。"<span class="src">——《黄帝内经》</span></div><div class="mnem">寒怕冷白稀溲清苔白脉迟，热怕热红干便秘苔黄脉数。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">寒证vs热证<br>病性相反</span><span class="df-arrow">→</span><span class="df-node df-logic">寒→阴盛/阳虚<br>热→阳盛/阴虚</span><span class="df-arrow">→</span><span class="df-node df-organ">冷白稀清<br>vs<br>热红干黄</span><span class="df-arrow">→</span><span class="df-node df-symptom">热药(温)<br>vs<br>寒药(凉)</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">寒热——辨病性，决定用药"温度"</span><div class="ds-body">寒证就像身体被"冻住"了——功能衰退、代谢减慢：怕冷（总比别人多穿一件）、面白（血管收缩血流少）、大便稀溏（脾胃运化被冻住）、小便清长（体内火力不够水分蒸发少）、舌淡苔白（舌质颜色偏淡）、脉迟（心跳减慢）。热证就像身体"烧"起来了——功能亢进：发热（或体温未必高但自觉热）、面红（血管扩张充血）、大便干结（肠中津液被热烤干）、小便短黄（水液被蒸发浓缩）、舌红苔黄（舌质像着了火）、脉数（心跳加快）。"寒者热之、热者寒之"是寒热辨证最根本的治疗法则。</div></div></div><div class=compare-table><div class=ct-left><h4>寒证(冷白稀)</h4><p>恶寒喜暖、口淡不渴</p><p>面色苍白、四肢冷</p><p>大便溏薄、小便清长</p><p>舌淡苔白、脉迟</p><p>治则：寒者热之(温热药)</p></div><div class=ct-right><h4>热证(热红干)</h4><p>恶热喜凉、口渴喜冷</p><p>面红目赤、烦躁不安</p><p>大便干结、小便短黄</p><p>舌红苔黄、脉数</p><p>治则：热者寒之(寒凉药)</p></div></div><div class=trap-box><strong>寒热辨证口诀：</strong>寒怕冷热怕热、寒不渴热喜饮、寒面白热面红、寒溲清热溲黄、寒便溏热便秘、寒苔白热苔黄。寒者热之、热者寒之是基本治则。</div><div class=clinical-case>一位老人畏寒肢冷口淡不渴大便溏薄舌淡苔白—寒证用理中丸温中散寒。另一位青年面红目赤口渴喜冷便秘舌红苔黄—热证用黄连解毒汤清热泻火。一寒一热治法截然不同。</div>'},
{id:'dx-27-2',name:'寒证与热证的临床表现鉴别要点',type:'compare',content:'<p>寒证和热证是疾病性质的两大类。寒证=冷+白+稀（怕冷、苍白、稀便、清尿、白苔），热证=热+红+干（发热、面红、口干、便秘、黄尿、红苔）。鉴别三字诀以寒热表现、面色二便、舌脉饮渴为核心依据。</p><div class="classic-quote">《素问》："阳盛则热，阴盛则寒。"<span class="src">——《黄帝内经》</span></div><div class="mnem">寒怕冷白稀溲清苔白，热怕热红干便秘苔黄；寒温药热凉药，方向错病上添。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">寒证与热证<br>鉴别</span><span class="df-arrow">→</span><span class="df-node df-logic">寒→功能衰退<br>阴盛或阳虚<br>热→功能亢进<br>阳盛或阴虚</span><span class="df-arrow">→</span><span class="df-node df-organ">冷白稀静润<br>vs<br>热红干动燥</span><span class="df-arrow">→</span><span class="df-node df-symptom">寒者热之<br>热者寒之</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">"冷白稀"和"热红干"背后的病机</span><div class="ds-body">寒证的"冷"是阳气不足温煦失职——就像冬天没有暖气。"白"是寒性收引、血管收缩、血流减少——面唇舌都因缺血而变淡。"稀"是寒邪困住了脾肾阳气、水液不能蒸腾气化——大量水分直接从大便（稀溏）或小便（清长）排出。热证的"热"是阳热</div></div></div><div class=compare-table><div class=ct-left><h4>寒证(阴盛阳虚)</h4><p><strong>冷：</strong>畏寒肢冷、喜温喜暖</p><p><strong>白：</strong>面色苍白、舌淡白</p><p><strong>稀：</strong>大便稀溏、小便清长、痰白稀、带下清稀</p><p><strong>静：</strong>喜静蜷卧、少气懒言</p><p><strong>润：</strong>口淡不渴、舌润苔白</p></div><div class=ct-right><h4>热证(阳盛阴虚)</h4><p><strong>热：</strong>发热恶热、喜凉</p><p><strong>红：</strong>面红目赤、舌红</p><p><strong>干：</strong>大便干结、小便短黄、痰黄稠、口渴喜冷</p><p><strong>动：</strong>烦躁不安、声高气粗</p><p><strong>燥：</strong>口干咽燥、舌燥苔黄</p></div></div><div class=trap-box><strong>寒热鉴别三字诀：</strong>寒证=冷+白+稀(怕冷苍白稀便清尿白苔)；热证=热+红+干(发热面红口干便秘黄尿红苔)。治则：寒者热之(温热药)、热者寒之(寒凉药)。</div><div class=clinical-case>一位畏寒肢冷大便溏薄小便清长舌淡苔白—寒证用温药。另一位发热面红口渴便秘溲黄舌红苔黄—热证用寒药。寒热鉴别是中医用药最基本也是最重要的判断。</div>'}
]},
{name:'细目四：虚实',points:[
{id:'dx-28-1',name:'虚证与实证的概念',type:'concept',content:'<p><strong>实证</strong>是邪气亢盛为主（"邪气盛则实"），需用祛邪泻法；<strong>虚证</strong>是正气不足为主（"精气夺则虚"），需用扶正补法。虚实决定治法是攻还是补。</p><div class="classic-quote">《素问》："邪气盛则实，精气夺则虚。"<span class="src">——《黄帝内经》</span></div><div class="mnem">实证声高痛拒按苔厚脉实泻，虚证声低痛喜按苔薄脉虚补。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">实证与虚证<br>定攻补</span><span class="df-arrow">→</span><span class="df-node df-logic">实证→邪气盛<br>正邪交争剧烈<br>虚证→正气夺<br>功能全面衰退</span><span class="df-arrow">→</span><span class="df-node df-organ">面红声高痛拒按<br>苔厚脉实有力<br>vs<br>面白声低痛喜按<br>苔薄脉虚无力</span><span class="df-arrow">→</span><span class="df-node df-symptom">实证→泻法<br>虚证→补法</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">实证——"邪气猖獗，但正气还在奋力抗争"</span><div class="ds-body">实证是正气不虚但邪气旺盛——身体处于"全火力交火"状态，所以表现剧烈：面红（气血被邪气"逼"到表面）、声高气粗（正气在呐喊）、痛拒按（局部是正邪交战的"主战场"——一按更痛）、脉实有力（正气的信号还很强）。实证的治则是"祛邪"——帮正气一把，把邪气打出体外（汗法、吐法、下法、清法、消法等）。<strong>实证的关键信号</strong>：新病、壮实体质、症状剧烈、反应亢进。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">虚证——"正气弱了，连剧烈反应的能力都没有了"</span><div class="ds-body">虚证是正气不足——全身功能全面衰减，所以表现温和：面白（阳气不能上荣）、声低气怯（说话的力气都不够了）、痛喜按（按着舒服——因为不是"堵了"而是"虚性的不舒服"）、脉虚无力（正气弱得像快熄灭的灯火）。虚证的治则是"扶正"——补气血阴阳，让正气重新有"打仗的资本"。<strong>虚证的关键信号</strong>：久病、羸弱体质、症状温和持续、功能衰退。</div></div></div><div class=compare-table><div class=ct-left><h4>实证(邪气盛)</h4><p>邪气亢盛正气尚可</p><p>多见于新病急病</p><p>形体壮实反应亢进</p><p>治则：祛邪(泻法)</p><p>例：高烧剧痛便秘—攻邪为主</p></div><div class=ct-right><h4>虚证(正气夺)</h4><p>正气不足功能减退</p><p>多见于久病慢病</p><p>形体虚弱功能衰退</p><p>治则：扶正(补法)</p><p>例：乏力纳差自汗—补虚为主</p></div></div><div class=trap-box><strong>虚实辨证要点：</strong>盛则实(要泻)、衰则虚(要补)。虚实夹杂时需权衡攻补比例。真实假虚(大实有羸状)和真虚假实(至虚有盛候)需要仔细鉴别。</div><div class=clinical-case>实证如壮汉扛重物(邪气盛)要帮他卸掉重物(泻法)。虚证如瘦弱之人(正气虚)要给他补充营养(补法)。虚实错杂时既要祛邪又要扶正攻补兼施。</div>'},
{id:'dx-28-2',name:'虚证与实证的临床表现鉴别要点',type:'compare',content:'<p>虚实鉴别是决定攻补的关键——虚则补之、实则泻之。判断错了后果严重。口诀：<strong>实证面红声高痛拒按苔厚脉实，虚证面白声低痛喜按苔薄脉虚</strong>。</p><div class="classic-quote">《素问》："实者泻之，虚者补之。"<span class="src">——《黄帝内经》</span></div><div class="mnem">实红高拒厚实泻，虚白低喜薄虚补；盛则实泻衰则补，虚实真假舌脉求。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">虚实鉴别<br>攻补定夺</span><span class="df-arrow">→</span><span class="df-node df-logic">实证→反应亢进<br>邪气盛而正不虚<br>虚证→反应低下<br>正气夺而邪已退</span><span class="df-arrow">→</span><span class="df-node df-organ">面红声高痛拒按<br>舌苍老苔厚脉实<br>vs<br>面白声低痛喜按<br>舌胖嫩苔薄脉虚</span><span class="df-arrow">→</span><span class="df-node df-symptom">实泻虚补</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">虚实鉴别——"攻补之前先辨虚实"</span><div class="ds-body">实证是"正气不虚但邪气盛"——身体在奋力抗邪，表现是反应剧烈（声高气粗、痛拒按、脉有力）。治则：祛邪（泻法）。虚证是"正气不足"——身体无力反应，表现是功能衰退（声低气怯、痛喜按、脉无力）。治则：扶正（补法）。最危险的是虚实真假："大实有羸状"（真实假虚——看起来像虚其实是实）和"至虚有盛候"（真虚假实——看起来像实其实是虚）。鉴别关键看舌脉和腹诊——</div></div></div><div class=compare-table><div class=ct-left><h4>实证</h4><p><strong>面色：</strong>红赤或有热色</p><p><strong>声音：</strong>声高气粗、多言</p><p><strong>疼痛：</strong>胀满疼痛拒按</p><p><strong>二便：</strong>便秘或暴泻、里急后重</p><p><strong>舌脉：</strong>舌质苍老苔厚腻、脉实有力</p></div><div class=ct-right><h4>虚证</h4><p><strong>面色：</strong>淡白或萎黄</p><p><strong>声音：</strong>声低气怯、少言</p><p><strong>疼痛：</strong>隐痛喜按、空痛</p><p><strong>二便：</strong>便溏或滑脱、小便清长</p><p><strong>舌脉：</strong>舌质胖嫩苔薄白、脉虚无力</p></div></div><div class=trap-box><strong>虚实鉴别口诀：</strong>实证面红声高痛拒按；虚证面白声低痛喜按。盛则泻实(祛邪)、衰则补虚(扶正)。注意：同样高热39度——面红声高痰黄稠是实证(麻杏石甘汤)；午后潮热声低痰白稀是虚证(补中益气汤)。</div><div class=clinical-case>两人同发高热39度——一人面红声高痰黄稠实证热痰壅肺用麻杏石甘汤。另一人午后潮热乏力声低痰白稀虚证脾肺气虚用补中益气汤。同样发热虚实不同治法完全相反——盛则实要泻、衰则虚要补。</div>'}
]},
{name:'细目五：阴阳',points:[
{id:'dx-29-1',name:'阴证与阳证的概念',type:'concept',content:'<p>阴阳是八纲的总纲。阳证=表热实的综合（功能亢进），阴证=里寒虚的综合（功能衰退）。<strong>"善诊者察色按脉先别阴阳"——诊法第一原则。</strong></p><div class="classic-quote">《素问》："善诊者，察色按脉，先别阴阳。"<span class="src">——《黄帝内经》</span></div><div class="mnem">阳证表热实亢进面貌，阴证里寒虚衰退形态；先别阴阳第一则，方向错了全盘歪。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">阴阳<br>八纲总纲</span><span class="df-arrow">→</span><span class="df-node df-logic">阳→表+热+实<br>功能亢进型<br>阴→里+寒+虚<br>功能衰退型</span><span class="df-arrow">→</span><span class="df-node df-organ">面赤发热<br>声高烦躁<br>vs<br>面白暗淡<br>声低蜷卧</span><span class="df-arrow">→</span><span class="df-node df-symptom">阳→清解<br>阴→温补</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">"先别阴阳"——诊断的第一原则</span><div class="ds-body">阴阳是六纲的最高抽象：表证+热证+实证=阳证（属阳——整体呈现兴奋、亢进、向外、向上的状态）；里证+寒证+虚证=阴证（属阴——整体呈现抑制、衰退、向里、向下的状态）。《素问》说"善诊者察色按脉先别阴阳"——诊断的第一步不是去分表里寒热虚实，而是先把所有信息归为"阳"还是"阴"两大类。为什么？因为方向决定了治法的性质基调——阳证的方向是"清解"（清法、解表法、泻法），阴证的方向是"温补"（温法、补法）。方向错了，后面的表里寒热虚实分得再细也没有意义。</div></div></div><div class=compare-table><div class=ct-left><h4>阳证</h4><p>表证+热证+实证的综合</p><p>面赤发热口渴烦躁</p><p>声高气粗大便干结</p><p>小便短黄舌红脉洪数</p><p>整体呈现兴奋亢进状态</p></div><div class=ct-right><h4>阴证</h4><p>里证+寒证+虚证的综合</p><p>面白暗淡身重蜷卧</p><p>少气懒言大便溏薄</p><p>小便清长舌淡脉弱</p><p>整体呈现抑制衰退状态</p></div></div><div class=trap-box><strong>先别阴阳：</strong>诊病第一件事就是分清阴阳——阳证(表热实)用清热/解表/泻法；阴证(里寒虚)用温里/补虚。方向对了再细化。</div><div class=clinical-case>一位阳证患者面红发热烦躁口渴声高气粗用白虎汤清热。一位阴证患者面白无华倦怠声低便溏用理中汤温补。先别阴阳是诊断第一原则方向错了一路错。</div>'},
{id:'dx-29-2',name:'阴证与阳证的鉴别要点',type:'compare',content:'<p>阴证和阳证的鉴别是八纲辨证的最终汇总——把表里寒热虚实归为阴阳两大类。阳证整体呈现兴奋亢进（面红声高脉洪数），阴证整体呈现抑制衰退（面白声低脉微细）。</p><div class="classic-quote">《素问》："善诊者，察色按脉，先别阴阳。"<span class="src">——《黄帝内经》</span></div><div class="mnem">阳红声高脉数便干，阴白声低脉弱便溏；先别阴阳大方向，再分表里寒热详。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">阴证与阳证<br>鉴别汇总</span><span class="df-arrow">→</span><span class="df-node df-logic">阳→表热实集合<br>兴奋+亢进+向外<br>阴→里寒虚集合<br>抑制+衰退+向里</span><span class="df-arrow">→</span><span class="df-node df-organ">面红声高烦躁<br>便干溲黄脉数<br>vs<br>面白声低倦怠<br>便溏溲清脉弱</span><span class="df-arrow">→</span><span class="df-node df-symptom">阳用清泻<br>阴用温补</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">阴证和阳证的"复合性质"</span><div class="ds-body">阴证不是单纯的"寒"，阳证也不是单纯的"热"——它们是多维度的综合。阴证=里（病位深）+寒（病性冷）+虚（正气弱）的叠加——整体就是"衰退、抑制"的面貌。阳证=表（病位浅/或里位的实热）+热（病性热）+实（邪气盛）的叠加——整体就是"亢进、兴奋"的面貌。辨证最终落在这两大方向——方向定了，具体用清法还是汗法还是</div></div></div><div class=compare-table><div class=ct-left><h4>阴证</h4><p>面白或晦暗</p><p>四肢厥冷、身重蜷卧</p><p>语声低微、少气懒言</p><p>大便溏泄、小便清长</p><p>舌淡胖苔白滑、脉沉微细</p><p>精神状态：萎靡不振</p></div><div class=ct-right><h4>阳证</h4><p>面红目赤有光</p><p>身热恶热、四肢温暖</p><p>语声高亢、多言烦躁</p><p>大便干结、小便短赤</p><p>舌红绛苔黄燥、脉洪数有力</p><p>精神状态：兴奋不安</p></div></div><div class=trap-box><strong>先别阴阳——诊断第一原则：</strong>善诊者察色按脉先别阴阳。阳证方向(表热实)用清解法；阴证方向(里寒虚)用温补法。方向错了后面全错。</div><div class=clinical-case>同是头痛—阳证面红声高脉数有力实热证用清热泻火；阴证面白声低脉弱无力虚寒证用温阳散寒。先别阴阳后细分表里寒热虚实。</div>'}
]},
{name:'细目六：八纲证候间的关系',points:[
{id:'dx-30-1',name:'证候相兼与错杂',type:'compare',content:'<p><strong>证候相兼</strong>是同一性质的证型组合（如表寒：表证+寒证），<strong>证候错杂</strong>是不同性质并存（如表寒里热）。相兼用单一法，错杂需兼顾双方。</p><div class="classic-quote">《素问》："谨守病机，各司其属。"<span class="src">——《黄帝内经》</span></div><div class="mnem">相兼同性质治法单纯，错杂寒热并主次须分。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">证候组合<br>两种类型</span><span class="df-arrow">→</span><span class="df-node df-logic">相兼：同性质<br>错杂：异性质</span><span class="df-arrow">→</span><span class="df-node df-organ">表寒/表热/里寒/里热<br>vs 表里同病/寒热错杂</span><span class="df-arrow">→</span><span class="df-node df-symptom">找主要矛盾</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">相兼vs错杂——同性质的"叠加"vs异性质的"混搭"</span><div class="ds-body">证候相兼=同性质证型叠加：表证+寒证=表寒证（麻黄汤），表证+热证=表热证（银翘散）。性质一致，治疗方向单纯。证候错杂=不同性质并存：表寒里热（怕冷发热+咳喘痰黄·麻杏石甘汤），上热下寒（心烦口疮+腰酸足冷·交泰丸）。错杂的"杂"字本身就是"混合"的意思——寒热虚实同时存在。治疗的核心原则是"分清主次"——是表寒为主还是里热为主，治疗就有了不同的侧重。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">错杂证的重点——"表里同病"和"寒热错杂"</span><div class="ds-body">表里同病=表证+里证同时出现。例如：感冒（表证）+便秘（里证）同时存在。寒热错杂=寒+热同时出现在不同部位。最有名的寒热错杂是"上热下寒"——上面口疮心烦（热）、下面腰酸脚冷（寒），交泰丸黄连+肉桂寒热并用。错杂证的治疗法则是"寒热并用、攻补兼施"——用方子的"复合性"来抵消人体的"复杂性"。麻杏石甘汤（麻黄桂枝温散表寒+石膏清肺热）就是表里双解的典范。</div></div></div><div class=compare-table><div class=ct-left><h4>证候相兼(同性质)</h4><p><strong>表寒证：</strong>表证+寒证(恶寒发热无汗脉浮紧→麻黄汤)</p><p><strong>表热证：</strong>表证+热证(发热恶风咽痛脉浮数→银翘散)</p><p><strong>里寒证：</strong>里证+寒证(畏寒肢冷腹痛便溏→理中丸)</p><p><strong>里热证：</strong>里证+热证(高热口渴便秘→白虎汤)</p></div><div class=ct-right><h4>证候错杂(不同性质)</h4><p><strong>表里同病：</strong>表寒+里热(恶寒发热+咳喘痰黄→麻杏石甘汤)</p><p><strong>寒热错杂：</strong>上热下寒(心烦口疮+腰酸足冷→交泰丸)</p><p><strong>虚实夹杂：</strong>正虚邪实(肝硬化腹水→攻补兼施)</p><p>错杂证的治法需兼顾双方、分清主次</p></div></div><div class=trap-box><strong>错杂证的辨证要点：</strong>相兼证(寒+表=表寒)用解表散寒法；错杂证(寒+热同存)需"寒热并用"——如麻杏石甘汤麻桂(温)+石膏(寒)同用。辨析错杂证的关键在于找出哪个是主要矛盾。</div><div class=clinical-case>一位慢支炎急性发作患者咳嗽痰黄(里热)同时怕冷发热无汗(表寒)——表寒里热错杂证。用麻杏石甘汤(麻黄桂枝散表寒、石膏清里热)表里双解。三天后表解热退咳喘减轻。这就是错杂证的特点——寒热并存需要寒热药同用。</div>'},
{id:'dx-30-2',name:'证候真假寒热真假',type:'compare',content:'<p><strong>证候真假</strong>是八纲辨证中最容易误诊的情况——真热假寒（阳盛格阴·白虎汤）和真寒假热（阴盛格阳·通脉四逆汤）。鉴别关键是舌象和饮水：舌红苔黄燥+渴喜冷饮→真热；舌淡苔白滑+不渴/喜热饮→真寒。</p><div class="classic-quote">《素问》："阴盛格阳，阳盛格阴。"<span class="src">——《黄帝内经》</span></div><div class="mnem">真热假寒肢冷苔黄渴冷饮，真寒假热面红苔淡脉微细。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">寒热真假<br>危重证鉴别</span><span class="df-arrow">→</span><span class="df-node df-logic">真热→阳盛格阴<br>真寒→阴盛格阳</span><span class="df-arrow">→</span><span class="df-node df-organ">舌·脉·渴饮<br>三辨定真假</span><span class="df-arrow">→</span><span class="df-node df-symptom">白虎清热vs<br>四逆回阳</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">为什么会出现"假象"？——格拒机制</span><div class="ds-body">寒热真假的本质是体内阴阳出现了"格拒"（一方过盛，把另一方推到体表）。真热假寒=阳盛格阴：内部热极（阳盛）→把少量阴寒之气"逼"到了体表四肢→所以四肢冰凉（假寒），但胸腹灼热（真热）。真寒假热=阴盛格阳：内部寒极（阴盛）→残余的阳气被"逼"到体表→所以面红如妆（假热），但四肢厥冷、脉微欲绝（真寒）。理解和鉴别这两种"格拒"是中医临证最重要也最难的功夫之一——搞错了方向，寒证用寒药=雪上加霜，热证用热药=火上浇油，都会出人命。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">鉴别关键——"舌象、脉象、饮水"三把钥匙</span><div class="ds-body">真热假寒：舌红苔黄燥（舌是热的铁证）、脉滑数有力（内部火还在烧）、渴喜冷饮（想喝冰水）。真寒假热：舌淡苔白滑（舌是寒的铁证）、脉微细欲绝（内部火力已尽）、不渴/喜热饮（即使面红，喝热水才舒服）。记住口诀："舌象骗不了人，渴饮也骗不了人"——四肢冷但舌红苔黄+渴冷饮=热；脸红外加脉微+舌淡苔滑=寒。万不可被"手脚冰凉"误导去用热药——要先看舌。</div></div></div><div class=compare-table><div class=ct-left><h4>真热假寒(阳盛格阴)</h4><p><strong>假象(寒)：</strong>手足冰凉、四肢厥冷、脉沉</p><p><strong>本质(真热)：</strong>胸腹灼热、口渴喜冷饮、舌红苔黄燥、脉滑数有力、不恶寒反恶热、小便短赤</p><p><strong>病机：</strong>内热过盛阳气被郁不能外达</p><p><strong>治疗：</strong>白虎汤/承气汤清热泻火(不可用热药)</p></div><div class=ct-right><h4>真寒假热(阴盛格阳)</h4><p><strong>假象(热)：</strong>面红如妆、烦躁不安、口渴、脉浮大</p><p><strong>本质(真寒)：</strong>四肢厥冷、喜热饮或不渴、舌淡苔白滑、脉微欲绝、小便清长大便溏</p><p><strong>病机：</strong>阴寒内盛虚阳外越</p><p><strong>治疗：</strong>参附汤/通脉四逆汤回阳救逆(不可用寒药)</p></div></div><div class=trap-box><strong>真假鉴别关键——舌象和饮水：</strong>真热假寒→舌红苔黄燥+渴喜冷饮(即使手脚冷)；真寒假热→舌淡苔白滑+不渴或喜热饮(即使脸红)。记住——舌头骗不了人口渴的偏好也骗不了人。</div><div class=clinical-case>一位慢性肾炎晚期患者面色苍白浮肿四肢冰凉但又烦躁不安面颧微红。年轻医生看到面红烦躁想用清热药。老师纠正这是真寒假热(阴盛格阳)——面红如妆不是满面通红烦躁是因阳衰不温养心神。舌淡胖苔白滑脉微细真寒无疑。急用参附汤大补元气回阳救逆。一剂后烦躁缓解四肢渐温。如果误用清热药后果不堪设想。</div>'}
]}
]},
{unit:'第九单元 病性辨证',subunits:[
{name:'细目一：辨阴阳虚损证候',points:[
{id:'dx-31-1',name:'阳虚证阴虚证的临床表现',type:'detail',content:'<p><strong>阳虚证</strong>（虚寒·金匮肾气丸）是阳气不足温煦失职。<strong>阴虚证</strong>（虚热·六味地黄丸）是阴液不足虚热内生。一寒一热性质相反。鉴别核心：阳虚"怕冷"——炉子火不够了；阴虚"手心热"——锅快烧干了。</p><div class="classic-quote">《素问》："阳虚则外寒，阴虚则内热。"<span class="src">——《黄帝内经》</span></div><div class="mnem">阳虚怕冷四肢凉，阴虚手心热汗淌。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">阴阳虚损<br>虚寒vs虚热</span><span class="df-arrow">→</span><span class="df-node df-logic">阳虚→温煦不足<br>阴虚→津液亏耗</span><span class="df-arrow">→</span><span class="df-node df-organ">畏寒肢冷喜温<br>vs五心烦热盗汗</span><span class="df-arrow">→</span><span class="df-node df-symptom">金匮肾气丸<br>vs六味地黄丸</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">阳虚——"火不够了"；阴虚——"水不够了"</span><div class="ds-body">阳虚的人全身的供暖系统功率下降→怕冷（比别人多穿一件）、四肢冷、腰膝冷痛、精神萎靡嗜睡、大便稀溏、小便清长、舌淡胖齿痕、脉沉迟。阴虚的人全身的冷却系统缺水→五心烦热（手心脚心胸口）、午后潮热（像潮水一样定时发热）、盗汗（睡醒一身汗）、口干咽燥、舌红少苔、脉细数。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">鉴别对比</span><div class="ds-body">阳虚=虚寒证：怕冷喜温、得温则减、面白舌淡胖、脉沉迟无力→金匮肾气丸/右归丸（温阳）。阴虚=虚热证：怕热喜凉、五心烦热、面红舌红少苔、脉细数→六味地黄丸/左归丸（滋阴）。同一病人身上可以同时存在阳虚和阴虚（阴阳两虚）——既有怕冷又手心热、舌淡胖但少苔——需要用右归丸加左归丸合方化裁。</div></div></div><div class=compare-table><div class=ct-left><h4>阳虚证(虚寒)</h4><p><strong>核心病机：</strong>阳气不足、温煦功能减退——炉子火不够了</p><p><strong>寒象：</strong>畏寒肢冷、脘腹冷痛喜温喜按</p><p><strong>精神：</strong>神疲乏力、少气懒言、嗜卧</p><p><strong>二便：</strong>大便溏薄、小便清长</p><p><strong>舌脉：</strong>舌淡胖有齿痕、脉沉迟无力</p><p><strong>代表方：</strong>金匮肾气丸/右归丸温补肾阳</p><p><strong>生活感受：</strong>比别人多穿一件、夏天怕空调、喝热水舒服</p></div><div class=ct-right><h4>阴虚证(虚热)</h4><p><strong>核心病机：</strong>阴液不足、虚热内生——锅快烧干了</p><p><strong>热象：</strong>五心烦热(手心足心胸中)、午后潮热、颧红</p><p><strong>津亏：</strong>口燥咽干、渴不多饮、皮肤干燥</p><p><strong>睡眠：</strong>盗汗(睡时出汗醒则止)、失眠多梦</p><p><strong>舌脉：</strong>舌红少苔或无苔、脉细数</p><p><strong>代表方：</strong>六味地黄丸/左归丸滋补肾阴</p><p><strong>生活感受：</strong>手心发热想贴墙、晚上盗汗枕头湿、口干不想喝水</p></div></div><div class=trap-box><strong>阳虚vs阴虚——一句话鉴别：</strong>阳虚→怕冷(炉子火不够了)；阴虚→手心热(锅快烧干了)。共同点：都有神疲乏力腰膝酸软。区别在于寒热偏好——阳虚喜温恶寒、阴虚恶热喜凉。注意：阴阳两虚证可同时存在(如更年期综合征既有畏寒又有潮热)。</div><div class=clinical-case>两位同龄女性一起来看病——甲女士怕冷严重、夏天也穿长袖、腰膝冷痛、夜尿三四次、舌淡胖——肾阳虚用金匮肾气丸温阳。乙女士手心脚心发热、盗汗、口干、失眠、舌红少苔——肾阴虚用六味地黄丸滋阴。两个病人都以"虚"为主诉但一寒一热治法截然不同。</div>'},
{id:'dx-31-2',name:'亡阳证亡阴证的临床表现与鉴别',type:'compare',content:'<p><strong>亡阳</strong>（冷汗·肢厥·脉微·参附汤）和<strong>亡阴</strong>（油汗·身热·脉细·生脉散）都是危重证。鉴别核心在"汗"：亡阳汗冷清稀如水，亡阴汗热黏稠如油。</p><div class="classic-quote">《灵枢》："阴阳俱竭，精气乃绝。"<span class="src">——《黄帝内经》</span></div><div class="mnem">亡阳冷汗肢厥参附救，亡阴油汗身热生脉收。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">亡阳vs亡阴<br>生命垂危</span><span class="df-arrow">→</span><span class="df-node df-logic">阳脱→冷·清<br>阴竭→热·黏</span><span class="df-arrow">→</span><span class="df-node df-organ">汗·肢·舌·脉<br>四维鉴别</span><span class="df-arrow">→</span><span class="df-node df-symptom">回阳vs救阴</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">亡阳vs亡阴——汗的质地决定生死方向</span><div class="ds-body">亡阳：冷汗淋漓如流水（不黏、清冷）、四肢厥冷至肘膝（冷到伸不直）、面色苍白、气息微弱、舌淡润、脉微欲绝——阳气将绝，急用参附汤回阳救逆。亡阴：汗出如油（黏手、温暖）、身热肢温、面红烦躁、呼吸急促、舌红干、脉细数疾——阴液将竭，急用生脉散益气救阴。两者有时先后出现——先亡阴（大出血脱水）→后亡阳（阴竭阳无所附），此时需参附+生脉同用。</div></div></div><div class=compare-table><div class=ct-left><h4>亡阳证(阳气暴脱)</h4><p><strong>核心病机：</strong>阳气极度衰微、温煦固摄功能丧失</p><p><strong>汗：</strong>冷汗淋漓——汗冷如水、不黏手</p><p><strong>四肢：</strong>四肢厥冷——冰凉过肘膝</p><p><strong>面色：</strong>面色苍白或灰暗无华</p><p><strong>呼吸：</strong>气息微弱—呼多吸少</p><p><strong>神志：</strong>精神萎靡、神志模糊至昏迷</p><p><strong>舌脉：</strong>舌淡润、脉微欲绝</p><p><strong>治法：</strong>回阳救逆→参附汤(人参+附子)</p></div><div class=ct-right><h4>亡阴证(阴液枯竭)</h4><p><strong>核心病机：</strong>阴液极速消耗、虚热内扰</p><p><strong>汗：</strong>汗出如油——汗热而黏、油润</p><p><strong>四肢：</strong>身热肢温——手足仍温</p><p><strong>面色：</strong>面红如妆或颧红</p><p><strong>呼吸：</strong>呼吸急促—气粗</p><p><strong>神志：</strong>烦躁不安、谵妄</p><p><strong>舌脉：</strong>舌红而干、脉细数疾</p><p><strong>治法：</strong>益气救阴→生脉散(人参+麦冬+五味子)</p></div></div><div class=trap-box><strong>亡阳vs亡阴——汗的鉴别：</strong>亡阳→冷汗(清稀如水、不黏、冷)；亡阴→热汗(黏稠如油、温、热)。误治后果：亡阳误用凉药会加速阳气消亡；亡阴误用热药会加速阴液耗竭。临床可阴阳两亡(先亡阴后亡阳或反之)，需益气固脱兼施。</div><div class=clinical-case>一位产后大出血的产妇突然面色苍白、全身冷汗如雨下、四肢冰冷、气息微弱——亡阳证急用参附汤回阳救逆(人参15g+附子9g急煎鼻饲)配合输血。一小时后汗止肢温、血压回升。另一例高热脱水患者汗出如油、身热烦躁、口渴——亡阴证用生脉散合增液汤益气救阴。两例的显著区别：一冷一热、一汗清冷一汗黏热。</div>'}
]},
{name:'细目二：气虚类证辨证',points:[
{id:'dx-32-1',name:'气虚证的临床表现辨证要点',type:'detail',content:'<p><strong>气虚证</strong>是全身或脏腑功能减退的病理状态。核心三大主症：神疲乏力+少气懒言+自汗。活动后加重是气虚的关键鉴别特征。代表方：四君子汤/补中益气汤。</p><div class="classic-quote">《素问》："正气存内，邪不可干。"<span class="src">——《黄帝内经》</span></div><div class="mnem">气虚乏力气短自汗动加，四君补中益气把气纳。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">气虚证<br>功能减退</span><span class="df-arrow">→</span><span class="df-node df-logic">气不足→<br>推动·固摄<br>下降</span><span class="df-arrow">→</span><span class="df-node df-organ">神疲·气短<br>自汗·动加</span><span class="df-arrow">→</span><span class="df-node df-symptom">四君子汤</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">气虚证——"气不够用了"</span><div class="ds-body">气是生命的动力。气虚即动力不足——全身功能减退。典型表现：神疲乏力（最核心，只想躺着）、少气懒言（说话费力声低微）、自汗（微动即汗，或不动也出汗）、面色淡白、舌淡脉虚。所有症状"动则加重"——休息后稍缓解，活动后更严重。代表方四君子汤（补脾气基础方）或补中益气汤（补气+升提）。鉴别：气虚偏功能不足（乏力为主），阳虚偏温度不够（怕冷为主）。气虚+动则加重是诊断的关键钥匙。</div></div></div><div class=compare-table><div class=ct-left><h4>核心表现(四字诀)</h4><p><strong>乏——神疲乏力：</strong>全身没劲、精神不振</p><p><strong>短——少气懒言：</strong>说话声低、气不够用</p><p><strong>漏——自汗不止：</strong>不动也出汗、活动加重</p><p><strong>淡——舌淡脉虚：</strong>舌质淡嫩、脉虚无力</p><p><strong>加——活动加重：</strong>所有症状活动后更明显</p></div><div class=ct-right><h4>临床表现与代表方</h4><p><strong>精神系统：</strong>精神萎靡、头晕目眩</p><p><strong>呼吸系统：</strong>气短声低、动则气喘</p><p><strong>消化系统：</strong>食欲不振、大便溏薄</p><p><strong>免疫系统：</strong>易感冒、抵抗力下降</p><p><strong>体征：</strong>面色淡白、舌淡苔白、脉虚无力</p><p><strong>代表方：</strong>四君子汤/补中益气汤</p></div></div>'},
{id:'dx-32-2',name:'气陷证的临床表现辨证要点',type:'detail',content:'<p><strong>气陷证</strong>是气虚无力升举导致内脏位置下移。气虚是基础（能量不够），气陷是进展（撑不住往下掉）。代表方：补中益气汤（升提）。和气虚证的鉴别：气虚只有疲乏无力；气陷有内脏下垂和坠胀感。</p><div class="classic-quote">《素问》："升降出入，无器不有。"<span class="src">——《黄帝内经》</span></div><div class="mnem">气陷下垂坠胀补中升，气虚无垂四君平。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">气陷证<br>升举无力</span><span class="df-arrow">→</span><span class="df-node df-logic">气虚基础<br>+升举功能<br>进一步衰退</span><span class="df-arrow">→</span><span class="df-node df-organ">腹部坠胀<br>内脏下垂</span><span class="df-arrow">→</span><span class="df-node df-symptom">补中益气汤</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">气陷证——"气撑不住了"</span><div class="ds-body">气陷是在气虚基础上，气的"升举"功能进一步衰退——内脏失去气的支撑力而往下坠。典型症状：气虚基础+腹部坠胀（饭后或久站加重）+内脏下垂（胃下垂/子宫脱垂/脱肛）。补中益气汤（重用人参黄芪+升麻柴胡升提）是代表方。方中黄芪补气升阳为君，升麻柴胡升提阳气为臣，参术草补气健脾为佐。和气虚证的鉴别要点：气虚只有乏力，气陷有"下垂+坠胀感"。</div></div></div><div class=compare-table><div class=ct-left><h4>临床表现</h4><p><strong>气虚基础症状：</strong>疲乏无力、气短声低、头晕目眩、自汗</p><p><strong>下坠感：</strong>腹部坠胀、尤以饭后或久站后加重</p><p><strong>内脏下垂：</strong>胃下垂→食后腹胀；肾下垂→腰酸痛站立加重；子宫脱垂→阴部有物脱出；脱肛→肛门坠胀便后加重</p><p><strong>舌脉：</strong>舌淡苔白、脉弱无力</p></div><div class=ct-right><h4>辨证要点与方药</h4><p><strong>核心病机：</strong>中气不足、升举无力→张力下降脏器移位</p><p><strong>辨证要点：</strong>气虚基础+内脏下垂+腹部坠胀感</p><p><strong>代表方：</strong>补中益气汤(黄芪+人参+白术+升麻+柴胡+陈皮+当归+炙甘草)</p><p><strong>鉴别(与气虚)：</strong>气虚只有疲乏无力；气陷有内脏下垂和坠胀感</p></div></div>'}
]},
{name:'细目三：血虚类证辨证',points:[{id:'dx-33-1',name:'血虚证的临床表现辨证要点',type:'detail',content:'<p><strong>血虚证</strong>——面唇甲舌"四白"+头晕心悸+月经少+舌淡脉细。四物汤补血。血虚是"营养液不够了"，有"五白"特征：面白+唇白+甲白+舌白+月经淡。</p><div class="classic-quote">《灵枢》："中焦受气取汁，变化而赤，是谓血。"<span class="src">——《黄帝内经》</span></div><div class="mnem">血虚五白晕心悸，四物归脾养血色。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">血虚证<br>濡养不足</span><span class="df-arrow">→</span><span class="df-node df-logic">血液亏少<br>脏腑失养</span><span class="df-arrow">→</span><span class="df-node df-organ">面白·头晕<br>心悸·经少</span><span class="df-arrow">→</span><span class="df-node df-symptom">四物补血</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">血虚证——"血库空了"</span><div class="ds-body">血虚是血液总量/质量不足——濡养功能减退。最直观的五个窗口（五白）：面色萎黄或苍白无华、口唇淡白、指甲淡白脆薄、舌质淡白、月经色淡量少。伴随症状：头晕眼花（蹲起发黑）、心悸失眠（血不养心）。舌淡脉细。代表方：四物汤（当归+白芍+川芎+熟地）补血调血。需注意：血虚≠贫血——血虚概念更宽，包括血的濡养功能下降，即便血红蛋白正常也有可能是中医血虚。</div></div></div><div class=compare-table><div class=ct-left><h4>临床表现(看四个部位)</h4><p><strong>看面色：</strong>面色萎黄/淡白无华——脸上没血色</p><p><strong>看唇甲：</strong>唇色淡白、爪甲色淡——末梢血不足</p><p><strong>看头部：</strong>头晕眼花——大脑缺血；心悸失眠——心脏血不足</p><p><strong>看月经：</strong>月经量少色淡、推迟或闭经</p><p><strong>舌脉：</strong>舌淡苔白、脉细无力</p></div><div class=ct-right><h4>辨证要点与方药</h4><p><strong>核心病机：</strong>血液亏虚、濡养功能减退</p><p><strong>辨证要点：</strong>唇舌爪甲色淡+面白+头晕心悸=血虚三大主症</p><p><strong>代表方：</strong>四物汤(当归白芍川芎熟地)</p><p><strong>兼证治疗：</strong>心血虚→归脾汤(养血安神)；肝血虚→补肝汤(养血柔肝)；脾血虚→归脾汤(健脾生血)</p><p><strong>鉴别(与气虚)：</strong>血虚→面白唇淡为主(物质不够)；气虚→乏力气短为主(能量不够)。两者常并存→气血两虚(八珍汤)</p><p><strong>日常调理：</strong>红枣桂圆当归炖汤、避免熬夜(肝藏血熬夜伤血)</p></div></div><div class=trap-box><strong>血虚典型特征——"五白"：</strong>面白、唇白、甲白、舌白、月经色淡。血虚是"营养液不够了"，全身各处因缺血而功能减退。注意与贫血的区别：血虚≈贫血但不完全等同——中医血虚包括贫血和/或血液濡养功能下降。头皮发麻、手脚发麻、皮肤干燥都是血虚的间接征象。</div><div class=clinical-case>一位28岁女性面萎黄无华、头晕眼花站起来就发黑、心悸失眠多梦、月经量少色淡已半年。舌淡脉细。血常规提示轻度贫血(Hb95g/L)。辨证为血虚——营血不足脏腑失养。用四物汤加阿胶(烊化)、制首乌养血。治疗一个月后面色转红润、头晕明显好转。一个半月后月经量恢复正常。这就是典型的血虚证:面白+头晕+心悸+月经少+舌淡。</div>'}]},
{name:'细目四：气滞类证辨证',points:[
{id:'dx-34-1',name:'气滞证的临床表现辨证要点',type:'detail',content:'<p><strong>气滞证</strong>是气的运行不畅、郁滞不通。特点：胀痛+窜痛+嗳气/排气后减轻+情绪影响+脉弦。代表方：柴胡疏肝散疏肝理气止痛。</p><div class="classic-quote">《素问》："百病生于气也。"<span class="src">——《黄帝内经》</span></div><div class="mnem">气滞胀痛窜走不定嗳气减，柴胡疏肝肝气得散。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">气滞证<br>运行不畅</span><span class="df-arrow">→</span><span class="df-node df-logic">气不通→<br>不通则痛</span><span class="df-arrow">→</span><span class="df-node df-organ">胀痛窜痛<br>嗳气后减</span><span class="df-arrow">→</span><span class="df-node df-symptom">柴胡疏肝散</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">气滞证——"气走不动了"</span><div class="ds-body">气滞是气在某处"堵车"了——气在体内运行不畅、郁滞不通。"不通则痛"——表现为胀痛、窜痛（部位不定、走来走去）、嗳气或排气后缓解（气通了一下）、与情绪波动相关（生气/抑郁加重）。最常见于胸胁脘腹（肝经所过）。脉弦（弦脉是气滞最重要的脉象）。与血瘀的鉴别：气滞→胀痛窜走不定（气在胀），血瘀→刺痛固定不移（血在瘀）。</div></div></div><div class=compare-table><div class=ct-left><h4>临床表现</h4><p><strong>疼痛特点：</strong>胀痛、窜痛(部位不固定)、走窜攻冲</p><p><strong>嗳气排气后减轻：</strong>气通了一时缓解</p><p><strong>情绪影响：</strong>情绪波动加重(生气/抑郁→痛)</p><p><strong>部位：</strong>最常见于胸胁脘腹(肝经所过)</p><p><strong>与饮食关系：</strong>饭后加重(食阻气机)</p><p><strong>舌脉：</strong>苔薄白脉弦——弦脉是最主要舌脉征象</p></div><div class=ct-right><h4>辨证要点与方药</h4><p><strong>核心病机：</strong>气机郁滞不通→胀痛窜痛</p><p><strong>辨证要点：</strong>胀痛+窜痛+嗳气排气后减轻+脉弦</p><p><strong>代表方：</strong>柴胡疏肝散(疏肝理气止痛)</p><p><strong>鉴别(与血瘀)：</strong>气滞→胀痛窜走不定(气在胀)；血瘀→刺痛固定不移(血在瘀)。气滞活动排气后减轻；血瘀夜间加重。</p><p><strong>日常调理：</strong>舒畅情志、适当运动、玫瑰花佛手泡茶</p></div></div><div class=trap-box>考点提示</div><div class=clinical-case>一位中年男性每次生闷气后两胁胀痛、痛无定处、一会儿左边一会儿右边、嗳气后舒服些、脉弦。B超肝胆正常。辨证为肝气郁滞——情绪抑郁导致肝失疏泄、气机郁滞、不通则痛。用柴胡疏肝散(柴胡9g白芍12g枳壳9g香附9g川芎9g甘草6g)疏肝理气。三剂后胁痛消失。这就是气滞证的典型表现：胀痛+窜痛+与情绪相关+嗳气减轻。</div>'},
{id:'dx-34-2',name:'气逆证的临床表现辨证要点',type:'detail',content:'<p><strong>气逆证</strong>是气机升降失常、应降反升。肺气逆→咳（苏子降气汤），胃气逆→呕（旋覆代赭汤），肝气逆→眩晕头痛（镇肝熄风汤）。"往上冲"就是气逆。</p><div class="classic-quote">《素问》："怒则气上。"<span class="src">——《黄帝内经》</span></div><div class="mnem">肺逆咳胃逆呕肝逆眩晕，苏子旋覆镇肝各不同。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">气逆证<br>应降反升</span><span class="df-arrow">→</span><span class="df-node df-logic">气机方向<br>错误→上冲</span><span class="df-arrow">→</span><span class="df-node df-organ">肺咳·胃呕<br>肝眩晕</span><span class="df-arrow">→</span><span class="df-node df-symptom">苏子·旋覆<br>·镇肝</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">三脏气逆鉴别</span><div class="ds-body">肺气上逆——咳嗽频作、气喘气促、呼气困难。肺主肃降以降为顺，不降反逆则咳喘。苏子降气汤/三拗汤。胃气上逆——恶心呕吐、嗳气呃逆、反酸烧心。胃主通降以降为和，不降反逆则呕恶嗳呃。旋覆代赭汤/丁香柿蒂汤。肝气上逆——头痛眩晕、面红目赤、甚至突然昏仆。郁怒则肝气横逆上冲。镇肝熄风汤。气逆和气滞的区别：气滞→不通则痛（胀痛），气逆→失常则上（咳嗽呕吐头痛）。同为气的异常，一为运行不畅、一为方向错误。</div></div></div><div class=compare-table><div class=ct-left><h4>三脏气逆鉴别</h4><p><strong>肺气上逆——呼吸系统：</strong>咳嗽频作、气喘气促、呼气困难。肺主肃降以降为顺，肺气不降反而上逆则咳喘。常见于感冒咳嗽哮喘→苏子降气汤/三拗汤</p><p><strong>胃气上逆——消化系统：</strong>恶心呕吐、嗳气呃逆、反酸烧心。胃主通降以降为和，胃气不降反而上逆则呕恶嗳呃。常见于胃炎消化不良→旋覆代赭汤/丁香柿蒂汤</p><p><strong>肝气上逆——神经系统：</strong>头痛眩晕、面红目赤、呕血(血随气升)、甚至突然昏仆。肝主疏泄喜条达恶抑郁，郁怒则肝气横逆上冲。常见于高血压脑出血前兆→镇肝熄风汤</p></div><div class=ct-right><h4>综合鉴别</h4><p>肺气逆→咳嗽为主(出声)</p><p>胃气逆→呕恶为主(出物)</p><p>肝气逆→头痛眩晕为主(出血)</p><p>三者可同时出现(如肝气犯肺肝气犯胃)</p><p>气逆与气滞区别：气滞→不通则痛(胀痛)；气逆→失常则上(咳嗽呕吐头痛)。同为气的异常，一为运行不畅、一为方向错误。</p></div></div><div class=trap-box><strong>气逆的日常判断：</strong>"往上冲"就是气逆——咳嗽是肺气往上冲、呕吐是胃气往上冲、头痛眩晕是肝气往上冲。正常人体升降有序肺气下降胃气下降肝气条达——该降的不降就是逆。气逆久了会耗气伤阴。</div><div class=clinical-case>一位公司经理在激烈争吵后突然剧烈头痛眩晕、面色通红、血压升到180/110、伴恶心欲吐。辨证为肝气上逆——暴怒伤肝、肝气暴张上冲头目。用镇肝熄风汤加羚羊角粉急煎。服药两小时后头痛减轻、血压降至150/95。这就是典型的"怒则气上"——肝气暴升、血随气涌、头痛眩晕。如果不及时控制可能发展为中风(脑出血)。</div>'}
]},
{name:'细目五：血病其他证辨证',points:[
{id:'dx-35-1',name:'血瘀证的临床表现辨证要点',type:'detail',content:'<p><strong>血瘀证</strong>的特征是"刺痛、固定、夜间重"。舌紫暗有瘀斑+脉涩。成因有四种：气滞→瘀、气虚→瘀、寒凝→瘀、热蕴→瘀。代表方：血府逐瘀汤（行气活血）。</p><div class="classic-quote">《素问》："诸血者，皆属于心。"<span class="src">——《黄帝内经》</span></div><div class="mnem">血瘀刺痛固定夜重紫暗舌，逐瘀汤中桃红来活血。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">血瘀证<br>血行不畅</span><span class="df-arrow">→</span><span class="df-node df-logic">血液凝滞<br>不通则痛</span><span class="df-arrow">→</span><span class="df-node df-organ">刺痛固定<br>夜间加重</span><span class="df-arrow">→</span><span class="df-node df-symptom">血府逐瘀汤</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">血瘀证——"血被堵住了"</span><div class="ds-body">血瘀六大特征：疼痛（刺痛如针刺、固定不移、拒按——不通则痛）、时间（夜间加重——夜间血行更慢）、肿块（外伤青紫或体内坚硬肿块）、出血（反复不止、血色紫暗有血块）、面色（面色黧黑、唇甲青紫、皮肤紫斑）、舌脉（舌紫暗有瘀斑瘀点、舌下静脉曲张、脉涩）。四大成因：气滞→瘀（行气活血·血府逐瘀汤），气虚→瘀（益气活血·补阳还五汤），寒凝→瘀（温经散寒·温经汤），热蕴→瘀（清热逐瘀·桃核承气汤）。</div></div></div><div class=compare-table><div class=ct-left><h4>六大特征</h4><p><strong>疼痛：</strong>刺痛如针刺、固定不移、拒按——不通则痛</p><p><strong>时间：</strong>夜间加重——夜间血行较慢瘀滞更明显</p><p><strong>肿块：</strong>外伤→青紫肿胀(体表)；内脏→坚硬肿块(体内)</p><p><strong>出血：</strong>反复不止、血色紫暗有血块</p><p><strong>面色：</strong>面色黧黑(黑眼圈)、唇甲青紫、皮肤紫斑丝状红缕</p><p><strong>舌脉：</strong>舌紫暗有瘀斑瘀点、舌下静脉曲张青紫、脉涩</p></div><div class=ct-right><h4>辨证要点与方药</h4><p><strong>核心病机：</strong>血液凝滞不行→刺痛固定+紫暗</p><p><strong>辨证要点：</strong>刺痛固定不移+舌紫暗瘀斑=两大主症</p><p><strong>代表方：</strong>血府逐瘀汤(头部胸胁瘀血)/桃红四物汤(妇科)/复元活血汤(外伤)</p><p><strong>鉴别(与气滞)：</strong>血瘀→刺痛固定(痛的部位不变)；气滞→胀痛窜走(痛的部位变化)。血瘀夜间重；气滞与情绪相关。血瘀舌紫暗脉涩；气滞脉弦。</p><p><strong>成因四种：</strong>气滞→瘀；气虚→瘀；寒凝→瘀；热蕴→瘀</p></div></div><div class=trap-box><strong>血瘀的四大成因：</strong>①气滞血瘀(气不通→血也堵)；②气虚血瘀(气推不动→血停)；③寒凝血瘀(血遇寒则凝)；④热蕴血瘀(血热互结)。治疗时除了活血化瘀还要针对成因：气滞配行气(血府逐瘀汤)、气虚配益气(补阳还五汤)、寒凝配散寒(温经汤)、热蕴配清热(抵挡汤)。</div><div class=clinical-case>一位外伤患者右踝扭伤三天、局部青紫肿胀、刺痛固定不移、夜间痛醒、不能着地。舌有瘀点脉涩。辨证为外伤血瘀——血脉破损离经之血瘀滞脉络。用复元活血汤加三七粉活血化瘀止痛。七天后青紫消退大半、疼痛明显减轻。这就是血瘀的典型表现：外伤→青紫肿胀+刺痛固定+夜间加重。</div>'},
{id:'dx-35-2',name:'血热证的临床表现辨证要点',type:'detail',content:'<p><strong>血热证</strong>是热邪侵入血分、迫血妄行。特征：急性出血（色鲜红质稠）+舌红绛+身热烦躁。代表方：犀角地黄汤凉血解毒。与血瘀的鉴别：血热→急性出血色鲜红，血瘀→慢性刺痛色紫暗。</p><div class="classic-quote">《素问》："热入血分，迫血妄行。"<span class="src">——《黄帝内经》</span></div><div class="mnem">血热鲜红质稠急出舌红绛，犀角地黄丹芍来凉血。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">血热证<br>热入血分</span><span class="df-arrow">→</span><span class="df-node df-logic">热迫血行<br>血溢脉外</span><span class="df-arrow">→</span><span class="df-node df-organ">急性出血<br>色鲜红质稠</span><span class="df-arrow">→</span><span class="df-node df-symptom">犀角地黄汤</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">血热证——"血被煮开了"</span><div class="ds-body">血热是热邪侵入血分→迫血妄行（血液被热邪"逼"得溢出脉外）+血液被"煎煮"得浓缩。出血特征：急性发作、势急量多、色鲜红质稠。全身热象：身热烦躁、渴喜冷饮、面红目赤。皮肤：紫色斑疹（阳斑）。舌红绛（深红色是血热的标志）、脉滑数或弦数。与阴虚的鉴别：血热是实热（身热烦躁渴冷饮），阴虚是虚热（五心烦热颧红盗汗）。与气不摄血的鉴别：血热色鲜红质稠势急（热邪实），气不摄血色淡质稀势缓（气虚）。</div></div></div><div class=compare-table><div class=ct-left><h4>血热证临床表现</h4><p><strong>出血特征：</strong>急性发作、出血势急量多、色鲜红质稠</p><p><strong>全身热象：</strong>身热烦躁、口干渴喜冷饮、面红目赤</p><p><strong>神志：</strong>心烦失眠、重则神昏谵语(热入心包)</p><p><strong>皮肤：</strong>皮肤紫红色斑疹(阳斑)、热迫血妄行</p><p><strong>舌脉：</strong>舌红绛(深红色)、苔黄燥、脉滑数或弦数</p><p><strong>代表方：</strong>犀角地黄汤(凉血止血) / 清营汤(清营凉血)</p></div><div class=ct-right><h4>鉴别诊断</h4><p><strong>血热vs血瘀：</strong>血热→急性出血色鲜红(热迫血行)；血瘀→慢性刺痛色紫暗(血行不畅)。</p><p><strong>血热vs阴虚：</strong>血热→实热(身热烦躁渴喜冷饮)；阴虚→虚热(五心烦热颧红盗汗)。</p><p><strong>血热vs气不摄血：</strong>血热→色鲜红质稠势急(热邪实)；气不摄血→色淡质稀势缓(气虚)</p><p><strong>临床常见病：</strong>过敏性紫癜(血热型)、血小板减少性紫癜、月经先期量多色深红、急性鼻衄、咯血、消化道出血等</p></div></div><div class=trap-box><strong>血热的"热"与"血"的关系：</strong>血热不是简单的高烧发热，而是"热在血分"——血液被热邪煎熬。辨别要点：①出血鲜红质稠②舌质必红绛③心烦急躁。血热如不及时清解，可进一步发展成热入心包(神昏谵语)或热盛动风(抽搐痉厥)。</div><div class=clinical-case>一位青年女性月经先期量多色鲜红质稠十天不止伴身热烦躁口干面红目赤。舌红绛脉滑数。辨证为血热迫血妄行——热邪侵入血分扰动血海。用犀角地黄汤加水牛角(代犀角)生地赤芍丹皮凉血止血。三剂后血量明显减少五剂血止。与另一例月经量多色淡质稀伴面色萎黄乏力气短的气不摄血证形成鲜明对比。</div>'},
{id:'dx-35-3',name:'血寒证的临床表现辨证要点',type:'detail',content:'<p><strong>血寒证</strong>是寒邪客于血脉、血行不畅。特征：冷痛得温减+月经紫暗有血块+舌淡紫。代表方：温经汤温经散寒养血祛瘀。与血瘀的鉴别：血寒必有寒象（怕冷冷痛得热减），血瘀不一定有寒。</p><div class="classic-quote">《素问》："寒则气收……寒则涩而不通。"<span class="src">——《黄帝内经》</span></div><div class="mnem">血寒冷痛得温减紫暗舌，温经汤中桂萸来温暖。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">血寒证<br>寒客血脉</span><span class="df-arrow">→</span><span class="df-node df-logic">血得寒则凝<br>凝则不痛</span><span class="df-arrow">→</span><span class="df-node df-organ">冷痛得温减<br>月经紫暗块</span><span class="df-arrow">→</span><span class="df-node df-symptom">温经汤温散</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">血寒证——"血被冻住了"</span><div class="ds-body">血寒是寒邪侵入血脉→"血得寒则凝"→血液凝滞不畅。临床特点：手足或少腹冷痛、得温减轻（热水袋贴上去舒服）；形寒肢冷（全身怕冷）；女性月经后期量少、色紫暗有血块、痛经（经前或经期小腹冷痛、热敷缓解）；舌淡紫或紫暗、苔白滑、脉沉迟涩。代表方：温经汤（吴茱萸桂枝温经散寒、当归川芎养血活血）。典型场景：年轻女性经期吃冰淇淋→小腹冷痛→热水袋贴→舒服——"血得寒则凝、得温则行"。</div></div></div><div class=compare-table><div class=ct-left><h4>临床表现</h4><p><strong>冷痛：</strong>手足或少腹冷痛、得温减轻</p><p><strong>整体：</strong>形寒肢冷——全身怕冷畏寒</p><p><strong>女性：</strong>月经后期量少、色紫暗有血块、痛经</p><p><strong>痛经特征：</strong>经前或经期小腹冷痛、热敷后缓解、热水袋贴上去舒服</p><p><strong>舌脉：</strong>舌淡紫或紫暗、苔白滑、脉沉迟涩</p><p><strong>指甲：</strong>指甲紫暗、按压回血慢</p></div><div class=ct-right><h4>辨证要点与方药</h4><p><strong>核心病机：</strong>寒客血脉→血寒凝滞不通→冷痛得温减</p><p><strong>辨证要点：</strong>冷痛+得温减+月经紫暗夹块</p><p><strong>代表方：</strong>温经汤(温经散寒养血祛瘀)</p><p><strong>鉴别(与血瘀)：</strong>血寒必有"寒象"(怕冷+冷痛+得热减)；血瘀不一定有寒象。两者可同时存在→寒凝血瘀</p><p><strong>日常：</strong>少食生冷、注意保暖、经期用暖宝宝/热水袋、生姜红糖水</p></div></div><div class=trap-box><strong>血寒证的典型场景：</strong>年轻女性经期吃冰淇淋→小腹冷痛→用热水袋贴→舒服些——这就是"血得寒则凝、得温则行"。血寒与宫寒关系密切，长期血寒可导致不孕。温经汤是妇科血寒证的要方。</div><div class=clinical-case>一位25岁女性每次月经第一天小腹冷痛剧烈、需请假卧床、用热水袋敷着才舒服些、经血色紫暗有血块、平时手脚冰凉、怕冷。舌淡紫苔白脉沉迟。辨证为血寒证——寒客胞宫、血寒凝滞。用温经汤加减(吴茱萸桂枝温经散寒、当归川芎养血活血)于经前一周开始服药。三个月后痛经明显减轻、手脚也开始暖和了。</div>'}
]},
{name:'细目六：气血同病类证辨证',points:[{id:'dx-36-1',name:'气滞血瘀气虚血瘀气血两虚证的临床表现',type:'compare',content:'<p><strong>气滞血瘀</strong>（胀+刺痛·血府逐瘀汤）、<strong>气虚血瘀</strong>（乏力+青紫·补阳还五汤）、<strong>气血两虚</strong>（气虚+血虚·八珍汤）。三者的核心区别：有无疼痛（瘀）和有无乏力（虚）。</p><div class="classic-quote">《灵枢》："气为血之帅，血为气之母。"<span class="src">——《黄帝内经》</span></div><div class="mnem">气滞血瘀胀刺痛双治，气虚血瘀乏力瘀重用芪，气血两虚不痛纯虚八珍宜。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">气血同病<br>三类型</span><span class="df-arrow">→</span><span class="df-node df-logic">气滞→血瘀<br>气虚→血瘀<br>气血两虚</span><span class="df-arrow">→</span><span class="df-node df-organ">实证·虚中实<br>纯虚</span><span class="df-arrow">→</span><span class="df-node df-symptom">活血+行气<br>补气+活血<br>双补</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">三种模式的鉴别链条</span><div class="ds-body">气滞血瘀：胀痛+刺痛并存→实证→行气+活血（血府逐瘀汤）。气虚血瘀：乏力+刺痛→虚中夹实→重用补气少佐活血（补阳还五汤重用黄芪120g）。气血两虚：乏力+面白+心悸→纯虚无实→补气养血（八珍汤/十全大补汤）。三个方代表三种不同治法——血府逐瘀汤重在理气活血（攻），补阳还五汤重用黄芪补气为主（补+攻），八珍汤纯补（纯补）。</div></div></div><div class=compare-table><div class=ct-left><h4>气血同病三型</h4><p><strong>气滞血瘀：</strong>胀痛(气滞)+刺痛固定(血瘀)+舌紫暗脉弦涩→血府逐瘀汤/膈下逐瘀汤行气活血化瘀</p><p><strong>气虚血瘀：</strong>乏力气短自汗(气虚)+青紫肿块刺痛(血瘀)+舌淡有瘀斑脉虚涩→补阳还五汤益气活血通络</p><p><strong>气血两虚：</strong>气虚(疲乏气短声低)+血虚(面白头晕心悸)+舌淡脉细→八珍汤/十全大补汤气血双补</p></div><div class=ct-right><h4>鉴别要点</h4><p><strong>气滞血瘀：</strong>以"胀+痛"为特征——既有胀感又有刺痛→实证用行气活血药</p><p><strong>气虚血瘀：</strong>以"乏力+青紫"为特征——虚中夹实→重用补气药辅以活血</p><p><strong>气血两虚：</strong>以"气虚+血虚"为特征——纯虚无实(无痛无瘀)→补气养血</p><p>三者的核心区别：有无疼痛(瘀)和有无乏力(虚)。</p></div></div><div class=trap-box><strong>临床提示：</strong>气滞血瘀多见于慢性疼痛患者(肝硬化胸痹)；气虚血瘀多见于中风后遗症(补阳还五汤重用黄芪)；气血两虚多见于久病或产后(八珍汤)。三者病机不同治则各异。</div><div class=clinical-case>一位慢性肝炎患者胁下刺痛固定不移一年伴乏力自汗面色晦暗。辨证为气虚血瘀——久病耗气气虚推动无力血瘀停滞。用补阳还五汤加减重用黄芪60g配合活血化瘀药。三个月后胁痛明显减轻体力恢复。</div>'}]},
{name:'细目七：津液类证辨证',points:[{id:'dx-37-1',name:'痰证的临床表现',type:'detail',content:'<p><strong>痰证</strong>——"百病多由痰作祟"。痰随气升降无处不到，可见于肺（咳嗽痰多·二陈汤）、胃（呕恶纳呆）、心（神昏癫狂）、经络（麻木瘰疬）、头（眩晕·半夏白术天麻汤）。舌苔腻、脉滑是痰证共性。</p><div class="classic-quote">《丹溪心法》："百病多由痰作祟，怪病多痰。"<span class="src">——朱震亨</span></div><div class="mnem">痰随气升无处不去，苔腻脉滑百病由之。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">痰证<br>无形之痰</span><span class="df-arrow">→</span><span class="df-node df-logic">水液代谢障碍<br>痰浊内停</span><span class="df-arrow">→</span><span class="df-node df-organ">肺·胃·心·经<br>部位不同症异</span><span class="df-arrow">→</span><span class="df-node df-symptom">苔腻脉滑</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">痰证——"身体里流动的垃圾"</span><div class="ds-body">痰不等于咳出来的痰——它包括"有形之痰"（可见的痰液）和"无形之痰"（体内停滞的病理产物）。痰的形成根源在脾（脾为生痰之源），贮存在肺（肺为贮痰之器），但可以随气运行到全身各部位。停在肺=咳嗽痰多（二陈汤），停在胃=恶心呕恶，蒙蔽心窍=神昏癫狂，流注经络=肢体麻木瘰疬痰核，上扰清窍=眩晕头痛（无痰不作眩·半夏白术天麻汤）。舌苔腻、脉滑是痰证"通用指纹"。</div></div></div><div class=compare-table><div class=ct-left><h4>痰证表现(按部位)</h4><p><strong>停于肺：</strong>咳嗽痰多、胸闷气喘→二陈汤</p><p><strong>停于胃：</strong>恶心呕吐、脘痞纳呆</p><p><strong>蒙蔽心窍：</strong>神昏癫狂、痴呆、自言自语</p><p><strong>流注经络：</strong>肢体麻木、半身不遂、瘰疬痰核</p><p><strong>上扰清窍：</strong>眩晕、头痛、耳鸣如潮</p><p><strong>舌脉：</strong>苔腻、脉滑</p></div><div class=ct-right><h4>痰的特点</h4><p>"百病多由痰作祟"——痰病症状复杂多变</p><p><strong>怪病多痰：</strong>疑难杂症从痰论治常收奇效</p><p><strong>肥胖多痰：</strong>"肥人多痰湿"→健脾化痰</p><p><strong>眩晕多痰：</strong>无痰不作眩→半夏白术天麻汤</p><p><strong>证型鉴别：</strong>痰+寒→寒痰(白稀)；痰+热→热痰(黄稠)；痰+风→风痰(动风)；痰+湿→湿痰(多易咯)</p></div></div><div class=trap-box><strong>痰的辨证要点：</strong>痰有"形"(咳出之痰)和"无形"(体内之痰)。有形之痰看颜色和质地：黄稠→热痰(清热化痰)；白稀→寒痰(温化寒痰)；白多易咯→湿痰(燥湿化痰)；少而黏→燥痰(润肺化痰)。无形之痰看苔腻脉滑、胖人、眩晕心悸等间接征象。</div><div class=clinical-case>一位65岁肥胖男性突发眩晕、视物旋转如坐舟车、伴恶心呕吐、胸闷痰多、舌苔白腻脉滑。辨证为痰湿中阻、清阳不升——"无痰不作眩"，用半夏白术天麻汤化痰息风。三剂后眩晕明显减轻。另一位肥胖女性反复咳嗽痰多胸闷纳差——痰湿蕴肺用二陈汤合三子养亲汤。两例体现了痰证"随气升降无处不到"的特点，在肺则咳在胃则恶在心则迷在经络则麻。</div>'}]}
]},
{unit:'第十单元 脏腑辨证',subunits:[
{name:'细目一：心病辨证',points:[
{id:'dx-38-1',name:'心气虚的临床表现',type:'detail',content:'<p><strong>心气虚</strong>是心脏功能减退、鼓动无力的病理状态。心主血脉、主神志，心气不足则推动无力、神失所养。核心辨证要点：心悸+气虚见症（气短乏力自汗）。</p><div class="classic-quote">《素问》："心者，君主之官，神明出焉。"《灵枢》："心气虚则悲......"<span class="src">----《黄帝内经》</span></div><div class="mnem">心气虚悸活动加，气短自汗面白华；保元炙草来补气，早治防阳更要察。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">心气虚<br>鼓动无力</span><span class="df-arrow">→</span><span class="df-node df-logic">心气不足<br>推动血液<br>无力</span><span class="df-arrow">→</span><span class="df-node df-organ">心悸·气短<br>自汗·面白</span><span class="df-arrow">→</span><span class="df-node df-symptom">心动悸·活动<br>加重·脉虚/结代</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">心气虚"到底是什么状态？----心脏泵血的"动力不足"</span><div class="ds-body">心气虚可以理解成心脏"泵"的功率下降了----就像你本来可以用8档跑车的速度工作、走路、上下楼梯，但现在心脏这台发动机的"油压低了"（心气不足）→往全身泵血的力量减弱了。最直观的体验：爬个三楼以前一口气上得去，现在到二楼就得停下来喘一阵（"心悸活动后加重"）。心气虚不是"心脏器质性重病"，而是心功能的早期衰减信号。这个阶段用药（保元汤/炙甘草汤）效果很好，如果不管不顾→会向心阳虚（加上怕冷）甚至心脉痹阻（心绞痛）发展。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">病机推导：心气虚是怎么一步步产生的</span><div class="ds-body">心气来源两个方面----脾运化的水谷精气（后天之源）+ 肾阳的温煦推动（先天之根）。所以最常见的两种心气虚的"病机推导"是：①思虑过度+长期熬夜→暗耗心血→血不养气→"气随血耗"→心气也跟着不足。②久病重病+年老体衰→肾气渐亏→"先天之根"缺乏后援→心气虚。→最终结果都是一样的：心鼓动无力→血无法被充分泵送到全身→各器官缺血（表现出乏力、面白、眩晕）+ 心脏本身的"反馈信号"----它自己觉得累→所以心慌（心悸）。<strong>诊断的钥匙：只要听到患者说"我的心跳得厉害、特别是活动以后加重"----首先想到心气虚。</strong></div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">症状群识别----"心悸活动加+无热象"是锁定心气虚的三把锁</span><div class="ds-body"><strong>核心症状（必须同时具备才能定心气虚）：</strong><br><strong>①心悸（尤其活动后加重）----</strong>不是静止时也跳，而是走几步或者稍微一干活就心慌气短。<strong>②气短乏力----</strong>感觉"气不够用"、需深呼吸、身体沉。<strong>③自汗----</strong>不是热的出汗，是微微一动就会出汗（卫气不固）。<strong>④面白舌淡----</strong>心气不能推送血到面部→面白无华。<strong>⑤脉虚无力或结代----</strong>脉象是心功能的最直接的"仪表盘"----虚弱无力，或有早搏（结代脉）。<br><br>鉴别要点（和心阳虚比）：心气虚有气虚（乏力、自汗、气短），但没有寒象（不冷、手脚不凉）→心阳虚就是心气虚+畏寒肢冷。<br><br><strong>代表方：</strong>保元汤（补气养心·基础方）/炙甘草汤（养心复脉·兼治脉结代）。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易和心气虚混淆的是哪个证？----心气虚vs心阳虚vs心血虚</span><div class="ds-body"><strong>心气虚</strong>=心悸+活动加重+气短+自汗+面白+无寒象+舌淡+脉弱→<strong>保元汤</strong>（补气）。<strong>心阳虚</strong>=心气虚+畏寒肢冷+心胸憋闷+舌淡胖+脉沉迟→<strong>桂枝甘草汤/参附汤</strong>（温阳）。<strong>心血虚</strong>=心悸+失眠多梦+面白+头晕+无活动加重+舌淡+脉细→<strong>四物汤/归脾汤</strong>（补血）。<br><br>三者的鉴别关键在于两个维度的交叉----"看活动后是否加重"（心气虚特点）+"看有没有寒象"（心阳虚独有）。</div></div><div class="derive-step ds-orange"><span class="ds-num">5</span><span class="ds-title">同是心气虚，不同的人群表现差异----场景变体</span><div class="ds-body"><strong>▸ 场景A：独居老人----"心气虚+肾气虚"叠加</strong><br>临床表现：七十二岁独居，不严重但长期"没劲"----说话后半句声音越来越小，吃个饭累得慌、走两步要坐一坐。同时腰膝酸软（肾气不足）、夜尿多。这是心气虚+肾气虚，治疗用保元汤+金匮肾气丸（心肾同补）。<br><br><strong>▸ 场景B：高压中青年+熬夜----"心气虚+心阴虚"早期</strong><br>临床表现：35岁创业期，心慌心悸（活动后明显）+ 同时手心脚心热、口干、入睡困难（兼有阴虚火旺）。这不是单纯的心气虚----是"气阴两虚"：心血暗耗导致气也不足+阴也不足。单用补气药效果不佳（因为阴也亏了）。治疗用保元汤+天王补心丹化裁----益气+滋阴并用。</div></div></div><div class=compare-table><div class=ct-left><h4>临床症状</h4><p><strong>心悸怔忡：</strong>自觉心跳不宁，活动后加重</p><p><strong>气短乏力：</strong>稍动则气喘吁吁</p><p><strong>自汗：</strong>不活动也出汗</p><p><strong>面白舌淡：</strong>血不上荣</p><p><strong>脉虚/结代：</strong>脉软弱无力或节律不齐</p><p><strong>神疲：</strong>精神不振易疲劳</p></div><div class=ct-right><h4>辨证要点与方药</h4><p><strong>核心病机：</strong>心气不足、鼓动无力</p><p><strong>辨证要点：</strong>心悸+气虚见症(气短乏力自汗)</p><p><strong>代表方：</strong>保元汤/炙甘草汤</p><p><strong>临床鉴别：</strong>心血虚→心悸+失眠+面白+舌淡，无心悸活动加重特征；心阴虚→心悸+五心烦热+舌红少苔</p><p><strong>日常生活注意：</strong>避免过劳、熬夜；可适当用黄芪、党参泡水；注意保暖避免受寒</p></div></div><div class=trap-box><strong>临床提示：</strong>心气虚与心阳虚心脉痹阻有递进关系。心气虚(心悸+气虚)→心阳虚(气虚+畏寒肢冷)→心脉痹阻(剧烈胸痛)。早期心气虚阶段及时益气养心可以防止病情进展。冠心病早期常表现为心气虚，不可忽视。</div><div class=clinical-case>一位65岁退休教师近半年来上三楼就心慌气短得停下来歇一会儿，平时说话声低、动不动就出汗、面色淡白无华。去医院查心电图显示偶发室早。中医辨证为心气虚----心脏鼓动无力、气血不能上荣。用炙甘草汤加减(炙甘草12g、人参9g、桂枝9g、麦冬12g、生地15g等)益气养心。服药两周后心慌明显减轻，能上三楼不喘了。坚持调养两个月后面色转红润、室早消失。这个病例体现了心气虚的典型表现----心悸活动加重、气短自汗、脉结代。</div>'},
{id:'dx-38-2',name:'心血虚的临床表现鉴别要点',type:'compare',content:'<p><strong>心血虚</strong>是心血不足、心失所养的病理状态。心主血脉藏神，心血虚则神不内守、心神浮越。核心辨证要点：心悸失眠+无热象（面白舌淡）。</p><div class="classic-quote">《灵枢》："心藏脉，脉舍神。"《素问》："诸血者，皆属于心。"<span class="src">----《黄帝内经》</span></div><div class="mnem">心血虚悸失眠加，多梦健忘眩晕乏；面白舌淡脉细弱，归脾四物养神佳。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">心血虚<br>血不养心</span><span class="df-arrow">→</span><span class="df-node df-logic">血液不足<br>心神失养</span><span class="df-arrow">→</span><span class="df-node df-organ">心悸失眠<br>多梦健忘<br>面白舌淡</span><span class="df-arrow">→</span><span class="df-node df-symptom">无热象<br>月经少<br>脉细弱</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">心血虚到底是什么状态？----心脏"没血可泵"的虚证</span><div class="ds-body">心血虚跟心气虚不一样----心气虚是"泵"的推力不足（发动机没油了），心血虚是"泵"里面的"血容量"不够（存油本身就不多）。心主血脉----血是物质基础，心需要心血充盈才能正常工作。当心血不足时----心脏本身缺血了就会"空转"----出现心悸（心脏缺血时跳动不稳定的自我保护反应）。同时心神需要血来濡养----心血不足→心神失养→失眠多梦+终日恍惚。心血虚的患者典型的"生活感受"是：总觉得心里不踏实，容易受惊（听到电话铃声或别人的叫声都会心"砰砰跳"一下），晚上翻来覆去睡不着----不是"想事情"而不睡，而是"血不足、神不安"的被动失眠。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">病机推导：心血虚是怎么来的？----"库存长期入不敷出"</span><div class="ds-body">心血虚的典型病机推导有三条路径：①思虑过度----心主神明，想得太多本身就在消耗心血（"思则气结→暗耗心血"），考研党、高管长期情绪过劳→"想太多"直接把心血的库存烧完了。②失血过多（产后大出血、长期月经过多）----血是有形的物质，从体内直接流失了→血库直接"被放空"→心血来不及补充→心血虚。③脾虚不生化----脾胃是气血生化之源（脾生成的水谷精微→奉心化赤为血）。长期消化不好、食欲差→"原料车间减产"→心血生成来源枯竭→心血虚。第三种最常见但最不易被意识到----"我是失眠心悸，医生怎么会说我脾虚？"因为心血不足的根在脾（脾不能提供足够原料）。所以治疗心血虚最高效的方子是归脾汤（人参白术健脾生血+当归龙眼肉酸枣仁养心血）----补源头比补库存更根本。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">症状群识别----"心悸失眠+面白+无热象"锁定心血虚</span><div class="ds-body"><strong>核心症状（必须同时出现三个以上才能定）：</strong><br><strong>①心悸失眠----</strong>睡不好、心慌。特点是"血少了神就不能安宁"。<strong>②多梦健忘----</strong>血不养神→不仅入睡困难，而且睡着后各种梦；记忆力明显下降。<strong>③眩晕面白----</strong>血不上荣于头面和脑→蹲下起来眼前发黑＋脸色萎白无华。<strong>④唇舌色淡+月经量少色淡----</strong>这是血液总量不足的证据。舌淡白、脉细弱（如丝线一样细小）。<br><br>代表方：<strong>归脾汤</strong>（健脾生血+养心安神----补脾+补心）、或<strong>四物汤</strong>（单纯补血调血的通用方）。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----心血虚vs心阴虚</span><div class="ds-body"><strong>心血虚</strong>=心悸失眠+多梦+面白+唇淡+舌淡+脉细弱+无热象（不发热、手心不热、不盗汗）→<strong>归脾汤</strong>。<br><strong>心阴虚</strong>=心悸失眠+心烦+五心烦热+潮热盗汗+口干+舌红少苔+脉细数→<strong>天王补心丹</strong>。<br><br>一句话说清：同样失眠、同样心悸，一个热（心烦手足心热），一个不热（面白舌淡）。鉴别核心就看"有没有热象"----手心热不热、舌头红不红、有没有盗汗。</div></div><div class="derive-step ds-orange"><span class="ds-num">5</span><span class="ds-title">同是心血虚，不同年龄/性别的"血虚入口"不同</span><div class="ds-body"><strong>▸ 场景A：长期熬夜的程序员----"暗耗心血"型</strong><br>青年男性，长期晚睡、用脑过度、睡眠不足。表现为心悸+失眠+多梦易醒，面色萎黄。其血虚来源是"思+耗"----持续过度兴奋→过度调用心血（血不被用来濡养神经而被"浪费"）→最后库存见底。治疗不仅用四物汤补血----还要强制晚10点前睡（让血能好好"回肝潜藏"）。</div></div><div class="derive-step ds-orange"><div class="ds-body"><strong>▸ 场景B：月经过多女性----"失血→血虚"型</strong><br>30岁女性，每个月月经量多（或周期短、时间长）→长期铁丢失+血红蛋白下降→头晕眼花、心悸+同时面色萎黄+指甲苍白。这类血虚的直接原因就是血液的"流出"大于"生成"。治疗用归脾汤补气摄血（先止住"漏"）配合四物汤（直接补血）----同时必须用妇科方法调理月经过多的根本原因。</div></div></div><div class=compare-table><div class=ct-left><h4>心血虚(无热象)</h4><p><strong>心悸失眠：</strong>心失所养则悸、心神不安则失眠</p><p><strong>多梦健忘：</strong>血不养神则多梦易醒、记忆力差</p><p><strong>眩晕面白：</strong>血不荣于上则头晕眼花、面色淡白无华</p><p><strong>唇舌色淡：</strong>血虚不充脉络</p><p><strong>月经量少色淡：</strong>血海不足</p><p><strong>舌脉：</strong>舌淡苔白、脉细弱</p></div><div class=ct-right><h4>心阴虚(有热象)</h4><p><strong>心悸心烦：</strong>虚火扰心</p><p><strong>失眠：</strong>虚火内扰心神不宁</p><p><strong>五心烦热：</strong>阴虚生内热</p><p><strong>潮热盗汗：</strong>阴虚阳亢迫津外泄</p><p><strong>口燥咽干：</strong>阴津不足上承</p><p><strong>舌脉：</strong>舌红少苔、脉细数</p></div></div><div class=trap-box><strong>鉴别要点：</strong>血虚vs阴虚----核心区别在于有无<strong>热象</strong>。心血虚面色淡白、无热感；心阴虚面色潮红、五心烦热。两者都有心悸失眠，但阴虚者伴心烦、手足心热、盗汗。一句话记：血虚是"不够了"→补(四物汤/归脾汤)；阴虚是"虚火旺"→滋阴(天王补心丹)。</div><div class=clinical-case>一位28岁女性程序员长期熬夜加班，近三个月来心悸失眠、每天晚上只能睡四五个小时、多梦易醒、白天头晕眼花、面色萎黄无华、月经量少色淡。舌淡苔白、脉细弱。辨证为心血虚----长期劳神耗伤心血，心失所养则悸、神不内守则失眠。用归脾汤加减(酸枣仁15g、远志9g、当归12g、龙眼肉9g、黄芪15g等)养血安神。一周后睡眠明显改善，能睡六七个小时。调理一个月后面色红润、精力恢复。这就是典型的"血不养神"----血液不足神志不安，补血则神自安。</div>'},
{id:'dx-38-3',name:'心脉痹阻证痰瘀寒气四因的比较',type:'compare',content:'<p><strong>心脉痹阻</strong>是心脏脉络被痰、瘀、寒、气等病理因素阻塞的病理状态。类似冠心病心绞痛。四因鉴别核心：刺痛→瘀血，闷痛→痰浊，剧痛得温减→寒凝，胀痛走窜→气滞。</p><div class="classic-quote">《灵枢》："心手少阴之脉......是动则病......心痛......"《金匮要略》："阳微阴弦，即胸痹而痛......"<span class="src">----《黄帝内经》《金匮要略》</span></div><div class="mnem">刺痛瘀血闷痰浊，剧痛寒凝胀气滞；同是心脉不通病，四因仔细来辨识。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">心脉痹阻<br>四因致病</span><span class="df-arrow">→</span><span class="df-node df-logic">瘀血/痰浊<br>寒凝/气滞</span><span class="df-arrow">→</span><span class="df-node df-organ">疼痛性质<br>+舌脉鉴</span><span class="df-arrow">→</span><span class="df-node df-symptom">四方各异<br>须分清主次</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">心脉痹阻：不是一种病，是四种"堵塞"方式</span><div class="ds-body">心的经脉不通→"不通则痛"→胸痛。但"不通"的形式不一样：瘀血把它"堆"堵了（像水管里都是泥浆），痰浊把它"糊"住了（像抹了一层厚浆糊），寒凝把它"冻"住了（像水管里的水结冰了），气滞把它"扭"住了（像水管被人拧了一把）。所以不同患者虽然都是胸口痛，但疼痛的性质、舌脉、诱因完全不同，需要用完全不同的方药治疗。这就是中医"辨证论治"最生动的体现：心脉痹阻这个"病"让西医来看，诊断都是"冠心病"----用药趋同，但中医必须在四因中"辨"出哪个为主、哪个为辅，方向选错效果天差地别。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">四因鉴别----如何根据"痛法"和"舌脉"锁定病因</span><div class="ds-body"><strong>①刺痛（如针扎）固定不移+舌紫暗有瘀斑+脉涩=瘀血内阻。</strong>特点是夜间加重（晚上血行更慢→瘀更重）。方：血府逐瘀汤。<strong>②闷痛（如压重物）+体胖+苔白腻+脉滑=痰浊壅塞。</strong>特点是吃饱后加重（食后助湿生痰→痰堵更甚）。方：瓜蒌薤白半夏汤。<strong>③剧痛（如刀割）+遇寒诱发+得暖减+畏寒肢冷+脉沉紧=阴寒凝滞。</strong>特点是冬季/清晨寒冷时发作。方：瓜蒌薤白白酒汤加桂枝。<strong>④胀痛窜痛+情绪波动诱发+脉弦+喜太息=气机郁滞。</strong>特点是生完气后发作。方：柴胡疏肝散。<br><br>一句话总结：看疼痛性质（刺痛/闷痛/剧痛/胀痛）→看诱因（夜间/饱食/寒冷/生气）→舌脉佐证→选方。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">四因"两两相兼"最常见----临床不只有单一原因</span><div class="ds-body">真实临床上，心脉痹阻的病人很少是单纯一种病因----多数是两因或三因相兼，最常见的是：<strong>寒凝+痰浊</strong>----老年体胖者，冬季发作（寒凝+痰浊互结）。方选瓜蒌薤白白酒汤+苓桂术甘汤。<strong>气滞+血瘀</strong>----情绪紧张后刺痛（先气滞不通→血瘀形成）。方选血府逐瘀汤（兼顾理气活血）。重要的是分清楚主次----①哪个是因中的"主力"决定了疼痛性质和诱发特点，②哪个是次要矛盾（伴发）。治疗时"主力"方为主、辅以祛次要因素的药。例如：患者既因生气诱发（气滞为主）、又苔腻体胖（痰浊兼见）→要用柴胡疏肝散加瓜蒌薤白半夏汤----理气为主、化痰为辅。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----心脉痹阻四因vs真心痛（心肌梗死）</span><div class="ds-body">同属心脉不通----<strong>心脉痹阻</strong>（四因导致的胸痛）疼痛相对有一定间歇、含服硝酸甘油或温通药可有缓解。而<strong>真心痛</strong>（心肌梗死）是心脉完全闭塞、气血断绝，表现为：持续剧烈胸痛（超过30分钟不解）、面色苍白、大汗淋漓、四肢厥冷、脉微欲绝----这是危候，需急诊抢救，中药可用苏合香丸温开醒神的同时速送医。两者的关键区别是：痹阻是"部分不通"（尚可急救），真心痛是"完全断绝"（命悬一线）。考试常考：当题干给了"胸痛剧烈持续不缓解+冷汗+脉微"----答案是真心痛（不是心脉痹阻）。</div></div><div class="derive-step ds-orange"><span class="ds-num">5</span><span class="ds-title">同为心脉不通，不同人不同诱因----场景变体</span><div class="ds-body"><strong>▸ 场景A：冬季清晨锻炼的老年男性----"寒凝为主"</strong><br>凌晨五点多出门快走，忽然左胸剧痛如刀割、痛及左臂、得暖稍缓、畏寒明显。这种在"清晨+寒冷"+剧烈运动三重加持下→寒邪直接凝滞心脉。治疗以温通为主（瓜蒌薤白白酒汤重加桂枝、附子）。</div></div><div class="derive-step ds-orange"><div class="ds-body"><strong>▸ 场景B：中年企业高管生气后胸痛----"气滞+血瘀"混合</strong><br>和客户激烈争吵后--胸闷、胸胁胀痛（胀痛持续几分钟）继而刺痛向肩膀放射。这是"气滞在先、血瘀在后"----情绪爆发导致气机瞬间紊乱→气滞→血流随之缓慢→血瘀堵住经脉→胸痛发作。治疗以行气配合化瘀（血府逐瘀汤+逍遥散）。</div></div></div><div class=compare-table><div class=ct-left><h4>四因鉴别表</h4><p><strong>瘀血内阻：</strong>刺痛固定不移、唇舌紫暗、舌有瘀斑、脉涩→血府逐瘀汤活血化瘀</p><p><strong>痰浊壅塞：</strong>闷痛如压重物、体胖痰多、苔白腻脉滑→瓜蒌薤白半夏汤化痰通阳</p><p><strong>阴寒凝滞：</strong>剧痛得温减、遇寒加重、畏寒肢冷、脉沉紧→瓜蒌薤白白酒汤加桂枝散寒通阳</p><p><strong>气机郁滞：</strong>胀痛窜痛、因情绪波动诱发、喜太息、脉弦→柴胡疏肝散疏肝理气</p></div><div class=ct-right><h4>诊断鉴别要点</h4><p><strong>疼痛性质：</strong>刺痛→瘀血；闷痛→痰浊；剧痛(冷)→寒凝；胀痛(走窜)→气滞</p><p><strong>诱因：</strong>夜间加重→瘀血；寒冷加重→寒凝；情绪加重→气滞；饱食后加重→痰浊</p><p><strong>舌脉：</strong>紫暗瘀斑→瘀血；白腻→痰浊；沉紧→寒凝；弦→气滞</p><p><strong>预后：</strong>同是心脉不通，原因不同用药完全不同→辨证论治的精髓</p></div></div><div class=trap-box><strong>临床要点----抓住核心特征：</strong><br>刺痛(如针扎)固定不移+舌紫暗→<strong>瘀血</strong>(血府逐瘀汤)<br>闷痛(如压大石)+体胖苔腻→<strong>痰浊</strong>(瓜蒌薤白半夏汤)<br>剧痛(如刀割)+遇寒加重→<strong>寒凝</strong>(瓜蒌薤白白酒汤加桂)<br>胀痛(串痛)+情绪诱发→<strong>气滞</strong>(柴胡疏肝散)<br><strong>注意：</strong>临床常两因相兼，如寒凝+痰浊、气滞+血瘀等，需要分清主次联合用药。</div><div class=clinical-case>一位55岁男性冬季清晨锻炼时突发左侧胸痛、痛引左肩背、疼痛剧烈如刀割、得暖后缓解、伴畏寒肢冷。舌淡紫苔白、脉沉紧。辨证为寒凝心脉----心阳不振、寒邪凝滞。用瓜蒌薤白白酒汤加桂枝附子温通心阳散寒通痹。服药三天后胸痛明显减轻。嘱其入冬前提前服用预防。这个病例的鉴别关键：遇寒发作+剧痛得温减→寒凝为主(热性疼痛为灼痛、不同于心脉痹阻)。</div>'},
{id:'dx-38-4',name:'痰蒙心神痰火扰神证的比较',type:'compare',content:'<p><strong>痰蒙心神</strong>和<strong>痰火扰神</strong>都是精神异常的证型。区别在于"痰"是否化"火"----痰蒙心神是"呆"（痰湿闭阻、神识迷糊），痰火扰神是"狂"（痰火内扰、狂躁妄动）。鉴别核心是苔色和寒热表现。</p><div class="classic-quote">《丹溪心法》："痰之为物，随气升降，无处不到......百病多由痰作祟。"<span class="src">----朱震亨</span></div><div class="mnem">痰蒙心神呆痴痴，痰火扰神狂乱嘶；白腻苔滑温开用，黄腻脉数凉开治。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">痰浊为病<br>随气升降</span><span class="df-arrow">→</span><span class="df-node df-logic">痰蒙心神<br>无火热<br>温开醒神</span><span class="df-arrow">→</span><span class="df-node df-logic">痰火扰神<br>痰+火<br>凉开安神</span><span class="df-arrow">→</span><span class="df-node df-symptom">一寒一热<br>治则相反</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">两个证本质上都是"痰扰心神"----区别在"火"的有无</span><div class="ds-body">痰厥心神可以理解为同一碗"脏水"（痰浊）倒入了心这个"水池"，把心神（精神意识）搅浑了。但是这两种证候的"脏水"的温度不同：痰蒙心神相当于"冷脏水"泼进去（无火热，只是浑浊了神志），痰火扰神相当于"滚烫的脏水"泼进去（痰+火，既浑浊还有灼烧）。因为火的存在一切症状都更"剧烈"----出现打人毁物、狂躁、面红目赤。所以鉴别点就非常清晰：有火无火（一个冷一个热），有热没有苔黄腻+脉滑数就是火。关键在于这个火是哪里来的？痰浊淤积久了会"郁而化火"----所以痰蒙心神如果长期不处理→痰浊在体内闷久了→产热→转成了痰火扰神（就像堆肥久了会自燃！）。因此在治疗上早期（痰蒙期）用温开法（苏合香丸）把痰化开----就阻止了进入"火"的阶段。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">两者"神志异常"的表现----一个"呆"一个"狂"</span><div class="ds-body"><strong>痰蒙心神（呆/静/冷）：</strong>人物表现像"断了线"----反应迟钝、问一句答半句、或说话前言不搭后语、神情呆滞、表情淡漠、甚至能坐在椅子上半天不动。属于"内向性"精神障碍（类似西医抑郁症/精神发育迟滞/某些类型的痴呆）。严重时意识模糊、昏不知人（中风中脏腑的"阴闭"）。舌苔白腻、脉滑。<br><br><strong>痰火扰神（狂/动/热）：</strong>人物表现像"着了火"----急躁粗暴、胡言乱语（甚至骂人、控制不住地大声说话）、打人毁物、登高而歌。属"外向性"精神障碍（西医的精神分裂症躁狂型/双相情感障碍亢奋期）。严重时会神昏谵语（胡话连篇、高烧不退）。舌苔黄腻、脉滑数。<br><br><strong>一句话鉴别：</strong>癡呆安静→痰蒙（"冷痰"，温开）；狂躁激烈→痰火（"热痰"，凉开）。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">痰蒙心神的"温开"和痰火扰神的"凉开"----治法差别</span><div class="ds-body"><strong>痰蒙心神----"温开醒神"：</strong>因为它是"寒痰+湿痰"蒙蔽心窍→选辛温开窍药（麝香、苏合香、安息香等）→代表方<strong>苏合香丸</strong>（温通开郁）。就像一个冰霜冻住的锁用"火"烤一烤就打开了。<br><strong>痰火扰神----"凉开醒神"：</strong>因为痰和热（火）缠在一起形成"热痰/痰火"堵塞心窍→需要选用"寒"性的开窍药（麝香+牛黄+犀角等）来一方面清热解毒，一方面开窍----代表方<strong>安宫牛黄丸</strong>（最常用）、至宝丹、紫雪丹（温病"三宝"）。就像一锅滚烫的粥倒进排水管堵住了，既要通开（开窍）也要降温（清热）。两方一字之差:苏合香丸（温）vs安宫牛黄丸（凉）----开窍的方向完全相反，考试常用来考查学生对"有无火热"的鉴别。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----痰火扰神vs阳明腑实（热盛神昏）</span><div class="ds-body">两者都有神昏谵语、烦躁不安，但病机完全不同：<strong>痰火扰神</strong>=痰+火→蒙蔽心包→神昏谵语+痰黄稠+苔黄腻+脉滑数→清热化痰·安宫牛黄丸。<strong>阳明腑实（热盛神昏）</strong>=邪热传里+燥屎内结→热扰神明→神昏+腹满硬痛拒按+便秘+日晡潮热+苔黄燥焦裂+脉沉实有力→攻下通腑·大承气汤（"釜底抽薪"法----通过排便把火泻出去）。如果简化为：看大便----有便秘+腹胀+舌苔黄燥=阳明腑实；有痰黄稠苔黄腻=痰火扰神。两者兼有时可合方（安宫牛黄丸+大承气汤）----"痰火+腑实"通下+开窍并用。</div></div></div><div class=compare-table><div class=ct-left><h4>痰蒙心神(痰湿闭阻)</h4><p><strong>病机：</strong>痰浊蒙蔽心窍、心神失灵</p><p><strong>神志表现：</strong>神识模糊、表情呆滞、喃喃自语、反应迟钝、痴呆状</p><p><strong>痰的特征：</strong>无火象----痰白稀、无热象</p><p><strong>舌脉：</strong>苔白腻、脉滑</p><p><strong>治则：</strong>→苏合香丸温开醒神</p></div><div class=ct-right><h4>痰火扰神(痰火内扰)</h4><p><strong>病机：</strong>痰浊化火、火热内扰心神</p><p><strong>神志表现：</strong>心烦失眠、狂躁妄动、神昏谵语、打人毁物、胡言乱语</p><p><strong>痰的特征：</strong>有火象----痰黄稠、面红目赤、身热</p><p><strong>舌脉：</strong>苔黄腻、脉滑数</p><p><strong>治则：</strong>→安宫牛黄丸凉开醒神</p></div></div><div class=trap-box><strong>一句话鉴别：</strong>痰蒙心神→"呆"(如痴如呆、神识模糊)；痰火扰神→"狂"(狂躁妄动、打人毁物)。核心区别在是否有火热象----苔黄腻+面红+痰黄稠→痰火。</div><div class=clinical-case>一位老年患者脑梗后逐渐出现表情淡漠、反应迟钝、喃喃自语、问东答西。苔白腻、脉滑。辨证为痰蒙心神----痰浊阻滞脑络、蒙蔽心窍。用涤痰汤加减化痰开窍，配合针灸治疗。三个月后患者语言能力有所恢复。另一位精神分裂患者狂躁不安、登高而歌、弃衣而走、面红目赤。苔黄腻、脉滑数。辨证为痰火扰神----痰火内盛扰乱心神。用黄连温胆汤合安宫牛黄丸清化痰火、安神定志。两例对照可见：同是"痰"扰心神，一寒一热治则完全不同。</div>'}
]},
{name:'细目二：肺病辨证',points:[
{id:'dx-39-1',name:'肺气虚肺阴虚证的临床表现辨证要点',type:'detail',content:'<p><strong>肺气虚</strong>是肺功能减弱、宣降无力。<strong>肺阴虚</strong>是肺津不足、虚热内生。两者都有咳嗽但病机治法截然不同。鉴别点：肺气虚"说话没劲走两步喘"，肺阴虚"干咳嗓子干手心热"。</p><div class="classic-quote">《素问》："诸气者，皆属于肺。"《灵枢》："肺气虚则鼻塞不利少气......"<span class="src">----《黄帝内经》</span></div><div class="mnem">肺气虚喘声低怕风白痰，肺阴虚干咳热手心盗汗。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肺虚证<br>两类不同</span><span class="df-arrow">→</span><span class="df-node df-logic">肺气虚功能减<br>肺阴虚津液亏</span><span class="df-arrow">→</span><span class="df-node df-organ">咳+气虚vs<br>咳+热象</span><span class="df-arrow">→</span><span class="df-node df-symptom">补肺vs润肺<br>治则不同</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">两个证的本质不同----"功能弱了"vs"燃料干了"</span><div class="ds-body">把肺想象成一个鼓风机----吹风机的功能：风扇转（功能）+ 有风出来（物质）。肺气虚=风扇转得慢了（功能减退），肺阴虚=风筒里的液体（津液）被烤干了（物质不足）。所以肺气虚的人虽然肺"弱"但尚有正常津液→痰稀白；而肺阴虚的人津液已经不够用了→痰少、干、甚至无痰（干咳）。两者的共同点都在于"虚"（不是实证），所以都不适合用猛烈的祛邪法（如麻黄、桂枝等）----而要用"补"法（补气或滋阴）。但"补"的方向截然不同。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">病机推导：肺气虚和肺阴虚怎么来的？</span><div class="ds-body"><strong>肺气虚的三条路径：</strong>①久咳伤气----慢性咳嗽拖了很久不愈→每次咳嗽都在耗气→肺气逐渐由盛转虚。②脾虚不生气血----脾胃为肺之"母"（土生金）→长期脾虚吃不好→水谷精微不足→肺失去后天滋养→肺气虚。③年老体衰→所有脏器功能下降，不独肺。肺气虚导致肺的"卫外"功能（防御力）下降→结果就是反复感冒、动则气喘、怕风。<strong>肺阴虚的两条路径：</strong>①燥邪伤阴----长期秋季干燥+抽烟+辛辣饮食不断消耗肺里津液。②久病伤阴----长期慢性肺病如肺结核、慢性咽炎、长期熬夜暗耗肺阴。肺阴虚的结果就是"火"（虚火）开始肆虐----干咳、痰少、嗓子干、五心烦热、盗汗。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">症状群识别----一"气"一"阴"一目了然</span><div class="ds-body"><strong>肺气虚的核心症状：</strong>咳喘无力（咳嗽声低）、气短声低（说话后气不够用）、自汗怕风（一动就出汗、一吹风就感冒）、痰白清稀、面色淡白、舌淡苔白、脉虚弱。<strong>代表方：</strong>补肺汤/玉屏风散（预防感冒）。<br><strong>肺阴虚的核心症状：</strong>干咳无痰或少黏痰（或痰中带血丝）、口燥咽干（声音嘶哑）、五心烦热（手心脚心发热）、潮热盗汗（下午低热、睡着出汗）、形体消瘦、舌红少津少苔、脉细数。<strong>代表方：</strong>百合固金汤/沙参麦冬汤。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----肺气虚vs肺阳虚</span><div class="ds-body"><strong>肺气虚</strong>=咳喘无力+自汗+怕风+痰白稀+舌淡+脉弱+<strong>无明显寒象</strong>→补肺汤。<br><strong>肺阳虚</strong>=肺气虚+<strong>畏寒肢冷明显</strong>+背冷如掌大+痰白稀泡沫+舌淡胖+脉沉迟→苓甘五味姜辛汤温肺化饮。<br>鉴别核心：肺阳虚是在肺气虚基础上增加了"寒"----不仅功能弱了，而且温煦不足了（明显怕冷、背部寒冷感）。</div></div><div class="derive-step ds-orange"><span class="ds-num">5</span><span class="ds-title">同是肺虚，不同的人群表现----场景变体</span><div class="ds-body"><strong>▸ 场景A：老年慢阻肺+肺气虚+反复感冒</strong><br>七十岁，常年咳嗽白稀痰，走几步就喘，一遇风凉就感冒，说话声音低微。这是肺气虚+卫外不固，不仅要补肺还要固表----补肺汤合玉屏风散长期服用，同时建议冬季打流感疫苗（中西医结合预防）。<br><br><strong>▸ 场景B：中年教师+慢性咽炎+肺阴虚</strong><br>四十五岁教师，常年用嗓过度、秋季干咳无痰，嗓子干痒、声音嘶哑，手心脚心发热。这是典型的肺阴虚（职业耗津+秋燥夹击）。用沙参麦冬汤加川贝、梨皮、玄参----养阴润肺。注意：她不需要补气，不能误用黄芪升提（会加重燥热）。</div></div></div><div class=compare-table><div class=ct-left><h4>肺气虚(功能不足)</h4><p><strong>核心症状：</strong>咳喘无力、气短声低、动则益甚</p><p><strong>全身表现：</strong>自汗畏风、易感冒、面色淡白</p><p><strong>痰的特点：</strong>痰白清稀或泡沫样</p><p><strong>舌脉：</strong>舌淡苔白、脉虚弱</p><p><strong>代表方：</strong>补肺汤/玉屏风散(预防感冒)</p></div><div class=ct-right><h4>肺阴虚(津液不足)</h4><p><strong>核心症状：</strong>干咳无痰或少黏痰、口燥咽干、声音嘶哑</p><p><strong>全身表现：</strong>午后潮热、五心烦热、盗汗、消瘦</p><p><strong>痰的特点：</strong>无痰或少黏痰、痰中带血丝</p><p><strong>舌脉：</strong>舌红少津少苔、脉细数</p><p><strong>代表方：</strong>百合固金汤/沙参麦冬汤</p></div></div><div class=trap-box><strong>一句话鉴别：</strong>肺气虚→"没力气"(说话没劲走两步喘怕风自汗)；肺阴虚→"干"(干咳没痰嗓子干手心热盗汗)。看痰：白稀痰→气虚；无痰或少黏痰→阴虚。两者都有时叫"气阴两虚"----需益气养阴并用。</div><div class=mini-quiz><div class=mq-title>自我检测----你是哪种肺虚？</div><div class=mq-scene>最近总是咳嗽，留意一下自己的感觉：</div><div class=mq-q>以下哪种情况更符合你？</div><div class=mq-opts><span class=mq-opt data-ans=wrong>A. 咳嗽有白稀痰、说话没力气、怕冷怕风、容易感冒</span><span class=mq-opt data-ans=wrong>B. 咳嗽痰黄稠、发烧喉咙痛</span><span class=mq-opt data-ans=right>C. 干咳无痰或少痰、嗓子干、手心热、晚上出汗</span><span class=mq-opt data-ans=wrong>D. 咳嗽痰多白黏胸闷身体沉重</span></div><div class=mq-feedback style=display:none><template class=fb-right>你偏向<strong>肺阴虚</strong>。主要特征：干咳无痰或少黏痰、咽干口燥、五心烦热、盗汗。</template><template class=fb-wrong>选A→偏<strong>肺气虚</strong>，需温肺益气；选B→<strong>肺热实证</strong>；选D→<strong>痰湿阻肺</strong>。</template></div></div><div class=clinical-case>一位35岁教师秋季发作干咳，无痰、咽干痒、声音嘶哑、手心热、晚上盗汗枕头湿。舌红少苔、脉细数。辨证为肺阴虚----燥邪伤肺、肺阴不足。用沙参麦冬汤加川贝母、梨皮清润肺燥。五剂后咳嗽显著减轻。另一位60岁退休工人常年咳嗽、白稀痰、每遇风冷加重、说话声低、自汗、每个月感冒一两次。舌淡脉虚。辨证为肺气虚----肺气不足、卫外不固。用补肺汤合玉屏风散益气固表。三个月后感冒次数明显减少、咳嗽减轻。</div>'},
{id:'dx-39-2',name:'风寒犯肺寒痰阻肺证的比较',type:'compare',content:'<p><strong>风寒犯肺</strong>是外感寒邪侵犯肺卫（表寒证）。<strong>寒痰阻肺</strong>是寒痰内伏于肺（里寒证）。两者都有寒象、咳嗽白痰，但病位浅深不同。鉴别关键：有无表证（恶寒发热并见）及病程新久。</p><div class="classic-quote">《素问》："风寒客于人，使人毫毛毕直，皮肤闭而为热。"<span class="src">----《黄帝内经》</span></div><div class="mnem">风寒犯肺表证急白痰，寒痰阻肺里证白腻苔。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">外寒与内寒<br>病位不同</span><span class="df-arrow">→</span><span class="df-node df-logic">风寒-表实<br>寒痰-里虚</span><span class="df-arrow">→</span><span class="df-node df-organ">表→发散<br>里→温化</span><span class="df-arrow">→</span><span class="df-node df-symptom">脉浮vs脉滑<br>新病vs久病</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">相同点和不同点----一个"外来"一个"内生"</span><div class="ds-body">两者共同的临床表现是"咳嗽+白痰+怕冷"----这导致很多初学者把他们混淆。但仔细分析它们的来源完全不同：风寒犯肺是"外来"的寒邪从体表（皮毛/口鼻）侵入肺→所以伴随表证（恶寒发热并见、头痛身痛、脉浮）。寒痰阻肺是"内生"的寒痰（源于脾虚运化水湿能力下降→湿聚为痰→同时阳气不足不足以温化痰饮）→它没有表证，是一种慢性反复发作的里寒证。打个比方：风寒犯肺像你大冬天在外面淋了一场冷雨，感冒了（急性）。寒痰阻肺像你的肺（其实是脾）长期处在一个寒冷潮湿的地下室----痰越积越多、肺就像"糊了一层冰浆糊"（慢性）。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">病机推导----两条完全不同的"寒+咳"的路</span><div class="ds-body"><strong>风寒犯肺的病理路线：</strong>风寒外袭（降温+穿少了+大风）→风寒首先束缚了"肺主皮毛"的卫气→毛孔关闭（无汗）+肺气不能宣发→气郁在胸中→咳嗽（身体试图通过咳嗽冲破这个"寒的封锁"）。因为是外来的，所以全身正在跟这个"入侵者"交战----所以有恶寒（怕冷）发热（体温升高）和头身疼痛。<strong>寒痰阻肺的病理路线：</strong>先有一个"寒"+先有一个"痰"→然后它们相互结合寄居在肺中。本质上是因为脾不运化水液→痰湿内生+肾阳不足（或肺气虚寒）不能温化这些痰→于是"寒痰"就在肺里住了下来。发作常常是"老慢支"或老人的"寒饮伏肺"----冬春加剧，无表证。两条路虽然都走到"咳白痰怕冷"这个路口，但起点完全不同。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">症状群识别----一张表格看穿一"表"一"里"</span><div class="ds-body"><strong>风寒犯肺（表）：</strong>咳嗽白稀痰+恶寒发热无汗+头身痛+鼻塞流清涕+痰稀白易咳+苔薄白+脉浮紧→<strong>麻黄汤</strong>辛温解表宣肺。<br><strong>寒痰阻肺（里）：</strong>咳嗽白痰量多易咯+胸闷气喘喉中痰鸣+畏寒肢冷（但无发热）+口淡不渴+病程长反复发作+苔白腻+脉滑→<strong>苓甘五味姜辛汤/小青龙汤</strong>温肺化饮。<br>记忆法：风寒犯肺是"新病+全身不舒服+寒包着热"；寒痰阻肺是"老病+局部痰多+身体虚冷"。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----风寒犯肺vs风水相搏证（头面水肿+恶寒）</span><div class="ds-body">两者都由外感风寒诱发，都有恶寒、脉浮。鉴别点：<strong>风寒犯肺</strong>以咳嗽咳痰为主症，水肿不明显。<strong>风水相搏</strong>以头面眼睑浮肿迅速波及全身为突出表现，伴小便短少，咳嗽为次。病机不同：风寒犯肺是肺卫闭郁、肺气上逆（咳为主），风水是风寒闭肺、通调水道失职、水溢肌肤（肿为主）。两个证鉴别的关键词是：有肿=风水（越婢加术汤），无肿=风寒（麻黄汤）。</div></div><div class="derive-step ds-orange"><span class="ds-num">5</span><span class="ds-title">同为"寒+咳"，不同年龄/体质差异----场景变体</span><div class="ds-body"><strong>▸ 场景A：年轻体壮冬季淋雨----"风寒犯肺"</strong><br>28岁男性，淋雨回家后当晚恶寒重、发热38℃、无汗、浑身酸痛、咳嗽白痰。这种"表实"的典型风寒----用麻黄汤一剂发汗后迅速缓解。<br><br><strong>▸ 场景B：老慢支患者冬季加重----"寒痰阻肺"</strong><br>68岁女性，每年入冬咳喘发作，白痰量多如泡沫、喉中痰鸣、背冷、夜不能平卧。没有发热怕冷的新发感----而是深伏的寒痰被冬天的"外寒"惹动了。用小青龙汤散寒化饮+苓桂术甘汤温化痰饮。</div></div></div><div class=compare-table><div class=ct-left><h4>风寒犯肺(表寒证)</h4><p><strong>病机：</strong>风寒外袭、肺卫失宣</p><p><strong>咳嗽：</strong>咳嗽白稀痰</p><p><strong>鼻塞：</strong>鼻塞流清涕</p><p><strong>全身：</strong>恶寒发热无汗、头身痛</p><p><strong>舌脉：</strong>苔薄白、脉浮紧</p><p><strong>病程：</strong>新病、起病急</p><p><strong>治法：</strong>辛温解表宣肺</p><p><strong>代表方：</strong>麻黄汤/三拗汤</p></div><div class=ct-right><h4>寒痰阻肺(里寒证)</h4><p><strong>病机：</strong>寒痰伏肺、肺失宣降</p><p><strong>咳嗽：</strong>咳嗽痰多色白易咯</p><p><strong>胸闷：</strong>胸闷气喘、喉中痰鸣</p><p><strong>全身：</strong>畏寒肢冷、口淡不渴</p><p><strong>舌脉：</strong>苔白腻、脉弦滑</p><p><strong>病程：</strong>久病、反复发作</p><p><strong>治法：</strong>温肺化痰</p><p><strong>代表方：</strong>苓甘五味姜辛汤/小青龙汤</p></div></div>'},
{id:'dx-39-3',name:'风热犯肺肺热炽盛燥邪犯肺证的辨证要点',type:'compare',content:'<p>肺系热证分三种----<strong>风热犯肺</strong>（最轻·表热·银翘散）→<strong>肺热炽盛</strong>（最重·里热·麻杏石甘汤）→<strong>燥邪犯肺</strong>（偏干·桑杏汤）。辨别的关键在痰的性状：黄稠痰伴表证=风热；黄稠痰+高热无表证=肺热；无痰或少痰+口鼻干=燥邪。</p><div class="classic-quote">《素问》："肺恶热......热伤气。"<span class="src">----《黄帝内经》</span></div><div class="mnem">痰黄表证风热宜，壮热无表肺热实，干少无痰燥邪致----看痰辩肺最相宜。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肺热三种<br>浅深不同</span><span class="df-arrow">→</span><span class="df-node df-logic">风热-表<br>肺热-里<br>燥邪-偏</span><span class="df-arrow">→</span><span class="df-node df-organ">黄痰表→银翘<br>黄痰高热→麻杏<br>无痰干→桑杏</span><span class="df-arrow">→</span><span class="df-node df-symptom">看痰辩病性</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">肺热三证是"同一类病"但"三个不同发展阶段"</span><div class="ds-body">这三个证可以被看成同一种肺部热邪感染入侵的三个病程阶段:①初起阶段----邪气刚刚从口鼻/皮毛侵入肺卫（表），病人表证明显----如发热、咽痛、黄痰----这是<strong>风热犯肺</strong>。②如果初起没控制好或病人体质壮热严重→热入里，病情进入高峰，出现高热、胸痛、喘咳气急----那就变成了<strong>肺热炽盛</strong>。③如果发病时以"干燥"气候为主（秋季居多）或患者本身肺阴虚→显示的症状以"干"为主（无痰、少痰、咽干、声音哑）----就是<strong>燥邪犯肺</strong>。所以这三个证之间在一定程度上可以"互相转换"----风热未能及时疏解→入里→肺热炽盛。肺热炽盛后期津液耗伤→燥象显现。治疗时必须清楚当下最主要矛盾是在表、在里还是偏燥。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">"看痰辨证"----肺热三证最直接的方法</span><div class="ds-body"><strong>①"痰黄+表证"→风热犯肺（病最轻·在表）：</strong>痰黄稠、咳嗽咽痛、发热恶风（不是恶寒、是怕风）、鼻塞浊涕、苔薄黄、脉浮数。方用银翘散----疏散风热+清热解毒（轻剂）。<br><strong>②"黄稠脓痰/铁锈痰+高热无表证"→肺热炽盛（病最重·在里）：</strong>发热甚高（39-40℃）、不恶寒、咳喘气急、胸闷或胸痛、痰黄稠如脓甚至带腥臭味或痰铁锈色、口渴喜冷饮、舌红苔黄燥、脉滑数。方用麻杏石甘汤（重用石膏清肺热）或苇茎汤（排脓）+方中常加黄芩鱼腥草。<br><strong>③"无痰或少痰难咯+口鼻干"→燥邪犯肺（偏燥）：</strong>干咳无痰或少而黏着难咳出，咳甚则声音嘶哑、咽干痒、鼻干、或伴发热微恶寒（较轻）----脉浮数（偏温燥）或浮紧（偏凉燥）。方----温燥（秋季久晴无雨）：桑杏汤；凉燥（秋深天凉）：杏苏散。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">三个证里要特别谨慎的是"肺热炽盛"与"肺痈"的界限</span><div class="ds-body"><strong>肺热炽盛</strong>如果热毒继续深入肺脏、腐败血肉→就会酿生"肺痈"（肺脓肿）。肺痈有特征性的表现：<strong>咳吐大量脓血腥臭痰</strong>（痰像脓一样、有腥臭味）、胸痛剧烈、伴有发热甚至寒战、舌红苔黄腻、脉滑数。治疗不在麻杏石甘汤范畴了，而应选<strong>苇茎汤</strong>（冬瓜仁+薏苡仁+桃仁+苇茎）----清热解毒排脓。这里要鉴别的核心点：肺痈有"脓血腥臭痰"（这是肺坏死的产物），而单纯的肺热炽盛的痰是"黄稠痰"（未形成脓）。考试题干只要出现"大量腥臭脓痰"字眼→立即判断肺痈。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----风热犯肺vs风热表证（单纯感冒）</span><div class="ds-body"><strong>风热犯肺</strong>=发热+咳嗽+黄痰+咽痛（以<strong>咳嗽痰黄</strong>为主症）→止咳为要→银翘散/桑菊饮。<br><strong>风热表证（风热感冒上呼吸道为主）</strong>=发热重+微恶风+鼻塞浊涕+咽喉红肿+但<strong>咳嗽不明显</strong>----较重的是银翘散（偏咽痛发热）、较轻的是桑菊饮（偏咳嗽）。区别其实很细微----都属卫分证，治疗也差不多，考试中一般不深挖。注意：风热表邪入里化热之后，便从银翘散证转为麻杏石甘汤证。</div></div></div><div class=compare-table><div class=ct-left><h4>风热犯肺(表热)</h4><p><strong>病机：</strong>风热袭表、肺卫失和</p><p><strong>痰：</strong>黄稠痰</p><p><strong>寒热：</strong>发热恶风、咽痛</p><p><strong>舌脉：</strong>苔薄黄、脉浮数</p><p><strong>病情：</strong>最轻</p><p><strong>代表方：</strong>银翘散/桑菊饮</p></div><div class=ct-right><h4>肺热炽盛(里热)</h4><p><strong>病机：</strong>热邪壅肺、肺气郁闭</p><p><strong>痰：</strong>黄稠痰或脓血腥臭</p><p><strong>寒热：</strong>高热烦渴、胸痛</p><p><strong>舌脉：</strong>苔黄燥、脉滑数</p><p><strong>病情：</strong>最重</p><p><strong>代表方：</strong>麻杏石甘汤/苇茎汤</p></div></div><div class=compare-table style="margin-top:6px"><div class=ct-left><h4>燥邪犯肺(偏燥)</h4><p><strong>病机：</strong>燥伤肺津、肺失濡润</p><p><strong>痰：</strong>无痰或少黏痰难咯</p><p><strong>特征：</strong>口鼻咽干燥、声音嘶哑</p><p><strong>舌脉：</strong>苔薄而干、脉细数</p><p><strong>季节：</strong>秋季多见</p><p><strong>代表方：</strong>桑杏汤(温燥)/杏苏散(凉燥)</p></div><div class=ct-right><h4>鉴别口诀</h4><p><strong>看痰辨肺病----最直接的鉴别法</strong></p><p>痰黄+表证→风热(银翘散)</p><p>痰黄+高热+胸痛→肺热(麻杏石甘汤)</p><p>无痰或少痰+口鼻干→燥邪(桑杏汤)</p><p>白稀痰+恶寒→风寒(麻黄汤)</p></div></div><div class=trap-box><strong>痰的性状是辨肺病的关键：</strong>无痰或少痰→肺阴虚或燥邪；黄稠痰伴表证→风热犯肺；黄稠痰伴高热→肺热炽盛；白稀痰→风寒或寒痰；脓血腥臭痰→肺痈。临床问诊第一句话问痰----有痰无痰、什么颜色、什么质地。</div><div class=clinical-case>一位秋季发病的患者干咳无痰、咽干咽痒、声音嘶哑、舌红少津。辨证为燥邪犯肺----用桑杏汤加川贝母梨皮。三剂后咳嗽明显减轻。另一位患者高热39度、咳喘气急、痰黄稠如脓、胸痛。辨证为肺热炽盛----用麻杏石甘汤加黄芩鱼腥草。三日后退热、咳嗽减轻。</div>'}
]},
{name:'细目三：脾病辨证',points:[
{id:'dx-40-1',name:'脾气虚脾阳虚脾虚气陷脾不统血证的鉴别',type:'compare',content:'<p>脾病四证是同一病机不同发展阶段的递进关系----从<strong>气虚→阳虚→气陷→不统血</strong>，病情逐步加深。气虚→纳呆便溏（参苓白术散）；+寒=阳虚→畏寒肢冷腹痛（理中丸）；+下坠=气陷→胃下垂脱肛（补中益气汤）；+出血=不统血→紫癜月经过多（归脾汤）。</p><div class="classic-quote">《素问》："脾主运化......脾气虚则四肢不用，五脏不安。"<span class="src">----《黄帝内经》</span></div><div class="mnem">脾虚四证层层加：气虚基础寒阳虚，气陷下垂出不统，四考点一索拉。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">脾病<br>递进四证</span><span class="df-arrow">→</span><span class="df-node df-logic">气+寒→阳虚<br>气+垂→气陷<br>气+血→不统</span><span class="df-arrow">→</span><span class="df-node df-organ">参苓→理中<br>→补中→归脾</span><span class="df-arrow">→</span><span class="df-node df-symptom">基础+兼证<br>定阶段</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">脾病四证的"递进金字塔"----从最基础到最重</span><div class="ds-body">每一个证的"上一层"都包含"下一层"的所有特征，再加一个核心"新特征"：①<strong>脾气虚=脾病的基础证型</strong>，脾运化能力全面下降：纳呆腹胀、大便溏薄、神疲乏力、面色萎黄、舌淡苔白脉缓弱。这是脾的四证中最"轻"的阶段----只用参苓白术散健脾。②<strong>脾阳虚=脾虚（上述症状）+"虚寒"（畏寒肢冷、脘腹冷痛喜温喜按、大便清稀完谷不化、舌淡胖齿痕苔白滑、脉沉迟）</strong>。这是在气虚基础上加了"寒"+能量不够（运化）+"热量也不够"（温煦不行）。治疗当理中丸温中健脾。③<strong>脾虚气陷=脾虚（气虚基础）+"下垂"</strong>----因"气升举无力"导致腹部有坠胀、食后更甚、久泻脱肛、胃下垂/子宫脱垂。用补中益气汤升提（不仅是补气）。④<strong>脾不统血=脾虚（气虚基础）+"出血"</strong>----因气不固摄血液导致血溢出脉外：便血、皮肤紫癜、月经过多、牙龈出血等。用归脾汤补气摄血。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">同一病人如何从气虚一路走到不统血----真实案例链</span><div class="ds-body">这是临床上很常见的演变：45岁女性公务员因长期工作劳累+思虑过度→首先表现出食欲不振、饭后腹胀、大便长期不成形、面色萎黄----脾气虚（服参苓白术散好转）→半年后又因工作更忙劳累+加班，出现喝冷水就拉肚子、腹部发凉、喜暖----从气虚滑入脾阳虚（改服理中丸）→一年后因为搬家疲累过度，突然感到站久了胃部有下坠感、检查出了胃下垂----进入脾虚气陷阶段（换用补中益气汤）。同一病人、同一条病机线、三年走完"气虚→阳虚→气陷"----时间线很清晰！如果再往下因为长期气不摄血、也可能发展为月经过多、牙龈出血等等----即"脾不统血"。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">症状群----四证的鉴别记忆表</span><div class="ds-body"><strong>鉴别要诀：找"新加"的东西！（基础+1）</strong><br>①脾气虚=基础证：纳差、大便溏、乏力、舌淡、脉弱（参苓白术散）。②脾阳虚=基础证以上+畏寒肢冷、脘腹冷痛、喜热喜按、舌淡胖齿痕（理中丸）。③脾虚气陷=基础证以上+坠胀感、脱肛/胃下垂、餐后加重（补中益气汤）。④脾不统血=基础证以上+慢性出血（肌衄、便血、崩漏、舌淡）（归脾汤）。<br><br>记忆法----基础是"气虚"；加"寒"→阳虚；加"下垂"→气陷；加"出血"→不统血。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----脾阳虚vs脾气虚vs胃阳虚</span><div class="ds-body"><strong>脾气虚</strong>=纳呆+便溏+乏力+面色萎黄（参苓白术散）。<br><strong>脾阳虚</strong>=脾气虚+畏寒肢冷+腹痛喜温+完谷不化（理中丸）。<br><strong>胃阳虚</strong>=胃脘冷痛（喜温喜按）+食后缓解+泛吐清水+舌淡胖（理中汤/小建中汤）----和脾阳虚很像，但胃阳虚更偏"胃脘"局部症状（胃痛、呕吐清水），脾阳虚更偏"全身"症状（乏力、腹泻、怕冷）。其实在临床上二者往往同时出现。</div></div></div><div class=compare-table><div class=ct-left><h4>脾病四证递进</h4><p><strong>脾气虚(基础)：</strong>纳呆腹胀、大便溏薄、神疲乏力、面色萎黄、舌淡苔白、脉缓弱→参苓白术散健脾益气</p><p><strong>脾阳虚(+寒象)：</strong>脾气虚+畏寒肢冷、脘腹冷痛喜温喜按、大便清稀完谷不化、舌淡胖苔白滑、脉沉迟→理中丸温中健脾</p><p><strong>脾虚气陷(+下垂)：</strong>脾气虚+脘腹坠胀、食后加重、久泻脱肛、胃下垂等→补中益气汤升阳举陷</p><p><strong>脾不统血(+出血)：</strong>脾气虚+便血肌衄、月经过多、牙龈出血等→归脾汤补气摄血</p></div><div class=ct-right><h4>记忆方法</h4><p>脾气虚→能量的量不够(运化减退)</p><p>脾阳虚→能量的温度不够(温煦减退)</p><p>脾虚气陷→能量的支撑力不够(升举无力)</p><p>脾不统血→能量的约束力不够(固摄无力)</p></div></div><div class=trap-box><strong>考核重点----四证的鉴别：</strong>• 脾气虚→纳呆便溏乏力(基础)→参苓白术散• 脾阳虚→+畏寒肢冷腹痛喜温→理中丸• 脾虚气陷→+内脏下垂脱肛→补中益气汤• 脾不统血→+各种出血紫癜→归脾汤<br>一句话记忆：基础是气虚，加寒成阳虚，加下垂成气陷，加出血成不统血。</div><div class=clinical-case>一位45岁女性公务员食欲不振大便不成形三年、面色萎黄、神疲乏力→脾气虚用参苓白术散好转。半年后因工作劳累出现腹部发凉、喝冷水就腹泻、喜温喜按→从气虚发展为脾阳虚改用理中丸。一年后又因搬家劳累出现胃部坠胀、检查发现胃下垂→从脾阳虚发展为脾虚气陷改用补中益气汤。同一病人同一类证型三个阶段三种方药----中医辨证的精髓就在于分期分证论治。</div>'},
{id:'dx-40-2',name:'湿热蕴脾寒湿困脾证的临床表现',type:'compare',content:'<p><strong>湿热蕴脾</strong>和<strong>寒湿困脾</strong>都是湿邪困阻中焦脾胃，但一寒一热性质相反。核心鉴别看口味+舌苔：湿热口苦苔黄腻（茵陈蒿汤），寒湿口淡苔白腻（藿香正气散）。</p><div class="classic-quote">《素问》："诸湿肿满，皆属于脾。"<span class="src">----《黄帝内经》</span></div><div class="mnem">湿热口苦苔黄腻，寒湿口淡苔白腻。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">湿困中焦</span><span class="df-arrow">→</span><span class="df-node df-logic">+热=湿热<br>+寒=寒湿</span><span class="df-arrow">→</span><span class="df-node df-organ">苔黄腻口苦<br>vs苔白腻口淡</span><span class="df-arrow">→</span><span class="df-node df-symptom">清利vs温化</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">同是"湿邪困脾"----一个"热蒸"一个"冰敷"</span><div class="ds-body">它们都是"脾虚不能运化水湿→湿邪阻滞中焦"的结果。但因为导致"湿"产生的环境不同和个人体质不同→湿气就会和"热"结合（湿热）或和"寒"结合（寒湿）。两者的共同表现：脘腹痞闷、纳呆恶心、头身困重、大便异常。区别：湿热是"又湿又热"----有热象（舌红、苔黄腻、口苦、小便黄、大便黏滞不爽）。寒湿是"又湿又寒"----有寒象（舌淡胖、苔白腻、口淡不渴、小便清长、大便溏泻）。记住：如果没有明显的热或寒，只是单纯的湿困脾（舌苔白腻不黄、口中和）----也可以叫做"湿困脾"偏中性。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">一张表格鉴别寒湿热湿</span><div class="ds-body"><strong>湿热蕴脾（热+湿）：</strong>口苦口黏、渴不欲饮、大便溏泄不爽灼肛、小便短黄、舌红苔黄腻、脉濡数→<strong>茵陈蒿汤</strong>清热利湿。<br><strong>寒湿困脾（寒+湿）：</strong>口淡不渴、口甜黏腻、大便稀溏、小便清长、舌淡苔白腻、脉濡缓→<strong>藿香正气散/平胃散</strong>温化寒湿。<br><br>最直接的快速判别：口味----口苦（热），口淡（寒）。舌苔----黄腻（热），白腻（寒）。</div></div></div><div class=compare-table><div class=ct-left><h4>湿热蕴脾(热+湿)</h4><p><strong>病机：</strong>湿热内蕴、脾胃纳运失职</p><p><strong>口味：</strong>口苦口黏、渴不欲饮</p><p><strong>二便：</strong>大便溏泄不爽、溲短黄</p><p><strong>舌苔：</strong>舌红苔黄腻、脉濡数</p><p><strong>身目：</strong>可伴身目发黄(阳黄)</p><p><strong>代表方：</strong>茵陈蒿汤/甘露消毒丹</p></div><div class=ct-right><h4>寒湿困脾(寒+湿)</h4><p><strong>病机：</strong>寒湿内盛、脾阳受困</p><p><strong>口味：</strong>口淡不渴、口甜黏腻</p><p><strong>二便：</strong>大便稀溏、小便清长</p><p><strong>舌苔：</strong>舌淡苔白腻、脉濡缓</p><p><strong>身目：</strong>或见面目发黄(阴黄)</p><p><strong>代表方：</strong>藿香正气散/平胃散/胃苓汤</p></div></div>'}
]},
{name:'细目四：肝病辨证',points:[
{id:'dx-41-1',name:'肝血虚肝阴虚证的临床表现鉴别要点',type:'compare',content:'<p><strong>肝血虚</strong>（无热象·四物汤）和<strong>肝阴虚</strong>（有虚热·一贯煎）都是肝的阴血不足。核心区别在于有无热象----肝血虚面白舌淡肢麻；肝阴虚手足心热舌红口干胁肋灼痛。</p><div class="classic-quote">《素问》："肝受血而能视......肝主筋......"<span class="src">----《黄帝内经》</span></div><div class="mnem">肝血无热面肢麻，肝阴有热舌红辣；肝血四物补肝汤，肝阴一贯把热擦。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肝虚证</span><span class="df-arrow">→</span><span class="df-node df-logic">血虚无热/<br>阴虚有热</span><span class="df-arrow">→</span><span class="df-node df-organ">目·筋·经<br>症状各异</span><span class="df-arrow">→</span><span class="df-node df-symptom">补血vs滋阴</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">肝血虚vs肝阴虚----区别在"火"</span><div class="ds-body">肝血虚是"量不够了"（好比油灯里的油耗得没剩多少，灯火微弱，无热感）。肝阴虚是"不仅量不够，还烧起来了"（油几乎干了----灯芯开始干烧----所以有"虚热"：手足心热、胁部灼痛、心烦）。二者共同涉及肝的"体窍":目（头晕眼花）、筋（运动不适）、以及与肝相关的经络循行部位（胁肋部不适）。差异在于：肝阴虚多了"热"（因为阴不够→相对阳亢了），所以有"热气"向上蒸→目涩、面烘热、心烦、盗汗。血不充足但无"火"则不产生热象。</div></div><div class="derive-step ds-blue"><span class="ds-num">2</span><span class="ds-title">病机推导：什么消耗了肝血和肝阴？</span><div class="ds-body"><strong>肝血虚常见成因：</strong>①月经量多/产后大失血→血直接从体内流失→肝血库存被放空（因为女子以肝为先天，经带胎产都耗肝血）。②长期高强度用眼（熬夜、盯屏幕）→"肝开窍于目"→目无休止消耗肝→间接耗血。③脾虚不能生化→水的源头没了。（注意：化源不足的病机要点往往容易忘）。<strong>肝阴虚常见成因：</strong>①乙肝等肝病慢性消耗→体内阴液暗耗。②长期生气→"怒伤肝"→"肝郁化火"→火把肝里的"水分"烧干了。③肾阴不足→水不涵木→母病及子（肾属水、肝属木----肾阴为肝阴之根）。所以肝阴虚患者往往伴随肾虚（头晕耳鸣腰膝酸软）----肝肾同源。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">症状群识别----肝血虚和肝阴虚的对症鉴别</span><div class="ds-body"><strong>肝血虚的核心（无热象）：</strong>面部苍白无华/萎黄、头晕眼花（蹲起尤甚）、目涩夜盲、四肢麻木（尤其夜间或固定姿势后）、爪甲干枯脆薄、月经少色淡、舌淡苔白、脉细。<strong>方：</strong>四物汤/补肝汤。<br><strong>肝阴虚的核心（有虚热）：</strong>面部潮红/两颧发红、头晕目涩（伴干涩感、怕光）、视物昏花、胁肋灼痛或隐隐作痛（越按越不舒服）、五心烦热、潮热盗汗、口干咽燥、舌红少苔、脉弦细数。<strong>方：</strong>一贯煎。</div></div><div class="derive-step ds-orange"><span class="ds-num">4</span><span class="ds-title">最容易混淆的对比----肝血虚vs心血虚vs肝血虚+血瘀</span><div class="ds-body"><strong>心血虚</strong>=心悸失眠+面白无华----以"心神"症状为主。<br><strong>肝血虚</strong>=眼睛干涩+指甲脆+月经少----以"肝的体窍（目/筋/经）"症状为主。<br>两者可能同时存在（心肝血虚），月经量少+面色萎黄+心悸+睡眠差----此时用四物汤补血，可同时养心肝。<br><strong>易错点：</strong>肝血虚如果失治，血不养筋→肢体麻木、肌肉痉挛、易于摔倒+如加上疼痛固定不移+舌紫暗→可能发展成"肝血虚兼血瘀"----在养血的同时就要加活血药（鸡血藤、丹参等）了。</div></div></div>'},
{id:'dx-41-2',name:'肝郁气滞肝火炽盛肝阳上亢证的鉴别',type:'compare',content:'<p>肝病三部曲----<strong>肝郁气滞</strong>（初期·胀痛太息·柴胡疏肝散）→<strong>肝火炽盛</strong>（中期·头痛口苦·龙胆泻肝汤）→<strong>肝阳上亢</strong>（后期·眩晕腰酸·天麻钩藤饮）。越早干预效果越好，肝郁阶段可完全逆转。</p><div class="classic-quote">《素问》："肝主疏泄......怒则气上......"<span class="src">----《黄帝内经》</span></div><div class="mnem">肝郁胀叹气，肝火头痛急，肝阳眩晕起，三部曲牢记。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肝病<br>三部曲</span><span class="df-arrow">→</span><span class="df-node df-logic">郁→火→阳<br>递进发展</span><span class="df-arrow">→</span><span class="df-node df-organ">疏肝→清肝<br>→平肝</span><span class="df-arrow">→</span><span class="df-node df-symptom">各阶段<br>方药不同</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">肝病三步："憋着"→"烧起来"→"飘起来"</span><div class="ds-body">第一步----<strong>肝郁气滞</strong>：肝脏的"疏泄"功能被憋住了。原因多为情绪压抑、工作压力（想发火又发不出来）。此时肝脏被"堵"在管道里→所以胀痛（尤其是两胁和乳房）。这个阶段最短、最容易治愈----用<strong>柴胡疏肝散</strong>或<strong>逍遥散</strong>疏肝理气。第二步----<strong>肝火炽盛</strong>：如果长期"郁"而不解→体内的"火"被憋了出来----"气有余便是火"。火是往上冲的----导致头痛、面红、目赤、口苦、易怒、失眠。这个阶段是最典型的高血压/头痛/失眠人群。治疗需<strong>龙胆泻肝汤</strong>清肝泻火。第三步----<strong>肝阳上亢</strong>：肝火烧了太久，把肝肾的阴血（基础物质）严重消耗→阴不能制阳→"水不涵木"→肝阳（类似肝的虚火）往上飘→出现眩晕耳鸣、头重脚轻、走路不稳。此时已是本虚标实，治疗用<strong>天麻钩藤饮</strong>或<strong>镇肝熄风汤</strong>平肝潜阳。三个字记忆法："堵"→"烧"→"飘"。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">三证的快速鉴别</span><div class="ds-body"><strong>肝郁气滞</strong>：胀痛+走窜不定+善太息（喜欢叹气）+情绪抑郁/易怒+脉弦。无热象。方：柴胡疏肝散。<br><strong>肝火炽盛</strong>：胁肋灼痛+头痛+面红+目赤+口干口苦+耳鸣如潮（声音大）+急躁易怒+失眠+舌红苔黄脉弦数。方：龙胆泻肝汤。<br><strong>肝阳上亢</strong>：眩晕耳鸣+头重脚轻+腰膝酸软（上盛下虚）+面红目赤+急躁易怒+舌红少苔脉弦有力。方：天麻钩藤饮/镇肝熄风汤。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">最容易混淆的对比----肝阳上亢vs肝火炽盛</span><div class="ds-body">两者都有头痛、面红、易怒。但----<strong>肝火炽盛</strong>是纯实证----"火"在烧，"烧"得很旺：头痛如裂、口苦咽干、肋痛剧烈、大便干结、苔黄厚燥、脉弦数有力（完全不怕冷且体壮的人）。<strong>肝阳上亢</strong>是"本虚标实"----不仅有"阳亢于上的虚火"，还有"肝肾阴虚于下"：头重脚轻（走路不稳）、腰膝酸软（肾虚）、夜里盗汗（阴虚）----所以本质上是一个"虚+实"混合。鉴别点是：肝阳上亢有腰膝酸软（"下虚"）+眩晕（头重脚轻飘飘然），肝火证没有。</div></div></div>'},
{id:'dx-41-3',name:'肝风内动四证的临床表现',type:'compare',content:'<p><strong>肝风内动</strong>四证----<strong>肝阳化风</strong>（阳亢·镇肝熄风汤）、<strong>热极生风</strong>（高热·羚角钩藤汤）、<strong>阴虚风动</strong>（虚风·大定风珠）、<strong>血虚生风</strong>（血不养筋·四物汤）。一"风"四因，各不同源。</p><div class="classic-quote">《素问》："诸风掉眩，皆属于肝。"<span class="src">----《黄帝内经》</span></div><div class="mnem">肝阳热极与阴虚，血虚四因各不同；高血压肝阳、高热极、阴虚无、血虚贫。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肝风内动<br>四证</span><span class="df-arrow">→</span><span class="df-node df-logic">阳化·热极<br>阴虚·血虚</span><span class="df-arrow">→</span><span class="df-node df-organ">各因生风<br>各不同方治</span><span class="df-arrow">→</span><span class="df-node df-symptom">一风四因</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">四种"风"生成的"燃料"完全不一样</span><div class="ds-body"><strong>①肝阳化风（最多见最危险）----"风从阳化"。</strong>病因：肝肾阴虚→阴不制阳→阳亢向上冲→"化生了内风"。临床表现：中风先兆----眩晕欲倒、头痛剧烈、肢体麻木震颤、语言不利、面红如醉→严重时突然昏仆、半身不遂。舌红脉弦。方：镇肝熄风汤。此即高血压脑出血(中风)的核心病因。<strong>②热极生风----"风从热生"。</strong>病因:高烧（热极）→灼伤肝脉→筋脉失养而痉挛。多见于小儿高热惊厥、脑膜炎高热等。表现:高热神昏、抽搐项强、角弓反张、两目上翻、舌红苔黄燥、脉弦数。方:羚角钩藤汤。不用镇肝熄风汤。----这是"高热伤筋"的急症。</div></div><div class="derive-step ds-orange"><div class="ds-body"><strong>③阴虚风动----"风从虚生"。</strong>原因：久病耗伤阴液/温病后期----水分极度缺乏→水不涵木→虚风暗动。表现：病情往往拖到晚期----情志开始不明显（不狂躁）,而是在安静中"蠕动"：手足微微震颤、肌肉蠕动、午后低热、消瘦脱形、舌光红少苔、脉细数。方：大定风珠。与肝阳化风的剧烈不同----它是"慢风"、"微抽"。<strong>④血虚生风----"风从血生"。</strong>病因:失血太多或化瘀不足→肝血亏→不能养筋→筋干而抽。表现：面色萎黄、头晕、肢体麻木、肌肉跳动、手足拘挛（可伴皮肤瘙痒）、爪甲无华。舌淡白、苔白、脉细或弦细。方：四物汤加味（首乌、钩藤、阿胶、鸡血藤等）。同是抽，它不发热、没有高血压、是"贫血性的抽"。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">鉴别速记</span><div class="ds-body">记忆口诀----辨"风"，先看"有没有高血压+突发晕倒"→有=肝阳化风；有高烧+抽搐→热极生风；久病+蠕动+舌红光红少苔→阴虚风动；血亏+麻木+面白+舌淡→血虚生风。一句话：肝阳化风最凶险（中风）；热极生风有高烧（小儿多见）；阴虚风动是"虚抽"（久病）；血虚生风是"贫血抽"。</div></div></div>'}
]},
{name:'细目五：肾病辨证',points:[
{id:'dx-42-1',name:'肾阳虚肾阴虚证的临床表现',type:'detail',content:'<p><strong>肾阳虚</strong>（怕冷·金匮肾气丸）和<strong>肾阴虚</strong>（手心热·六味地黄丸）是肾病辨证的两大基石。共同症状----腰膝酸软。区别核心：阳虚是"炉子没火了"（冷+弱），阴虚是"锅快烧干了"（热+干）。</p><div class="classic-quote">《素问》："肾者主水，受五脏六腑之精而藏之。"<span class="src">----《黄帝内经》</span></div><div class="mnem">肾阳虚冷腰膝酸，夜尿阳痿畏寒残；肾阴虚热心手汗，盗汗腰酸口舌干。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肾虚<br>先分阴阳</span><span class="df-arrow">→</span><span class="df-node df-logic">阳不够→冷<br>阴不够→热</span><span class="df-arrow">→</span><span class="df-node df-organ">腰膝酸软+<br>寒象vs热象</span><span class="df-arrow">→</span><span class="df-node df-symptom">温阳vs滋阴</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">肾为"水火之脏"----先辨别哪一"火"不足</span><div class="ds-body">肾在五脏中比较特殊----它同时承载了"水"（肾阴）和"火"（肾阳）两种能量。健康人水+火平衡（水火既济）。当肾阳虚----"火"不够了，身体就像没有暖气的冬天，所以怕冷、手脚凉、精神萎靡、腰部像放了一块冰。当肾阴虚----"水"不够了，体内相对就要"上火"（虚火），故手心脚心发热、潮热（如潮水般一阵一阵的发热）、盗汗（晚上睡觉出汗把枕头浸湿）、口干舌燥、心烦失眠。两者的共性：都是"虚"证（非实证），所以都具有腰膝酸软（肾虚的最基础信号）。用一个直观感受描述：肾阳虚患者夏天也要穿秋裤睡觉才能暖脚；肾阴虚患者冬天也手心出汗发烫。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">病机推导：肾阳虚和肾阴虚是怎么产生的？</span><div class="ds-body"><strong>肾阳虚的三大来源：</strong>①年老体衰----肾阳（命门之火）随年龄增长自然衰减。②久病及肾----慢性肺病、心脏病长期消耗→最后阳的根被动摇了（肾阳）。③房劳过度+熬夜----频繁性活动和长期熬夜直接透支命门之火。<strong>肾阴虚的三大来源：</strong>①热病后期（严重感染后高烧多日）→体液被"烧干"了。②慢性消耗（糖尿病、结核病）→长期耗伤津液。③肝肾同源----长期的肝火（熬夜+喝酒+压力）消耗了肾水以弥补肝的不足。记住：由于"阴阳互根"，长期肾阳虚可伤阴（阳损及阴），长期肾阴虚也可伤阳（阴损及阳）。很多老年人最后是"阴阳两虚"----既有又怕冷又手心热----需斟酌左右并用。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">症状群识别----一张表格抓住要害</span><div class="ds-body"><strong>肾阳虚（寒象为主）：</strong>腰膝冷痛（像腰里放了冰块）、怕冷肢冷（比别人多穿一件）、精神萎靡嗜睡、阳痿滑精宫寒不孕性欲减、夜尿多尿清长五更泄泻、舌淡胖有齿痕、脉沉迟无力。<strong>方：</strong>金匮肾气丸/右归丸。<br><strong>肾阴虚（热象为主）：</strong>腰膝酸软（腰像要断了）、五心烦热、午后潮热、盗汗、失眠多梦、头晕耳鸣、齿松发脱、咽干颧红、尿黄便干、舌红少苔或无苔、脉细数。<strong>方：</strong>六味地黄丸/左归丸。<br><br>最简记忆：一个"怕冷"（阳虚），一个"怕热/手心热"（阴虚）。</div></div></div>'},
{id:'dx-42-2',name:'肾精不足肾气不固肾虚水泛证的临床表现',type:'detail',content:'<p>肾病五证速查----<strong>肾阳虚</strong>（畏寒·肾气丸）、<strong>肾阴虚</strong>（潮热·六味丸）、<strong>肾精不足</strong>（早衰·左归丸）、<strong>肾气不固</strong>（尿频·缩泉丸）、<strong>肾虚水泛</strong>（水肿·真武汤）。共同基础症状：腰膝酸软。</p><div class="classic-quote">《素问》："肾主藏精......精之处也。"<span class="src">----《黄帝内经》</span></div><div class="mnem">五证辨肾先腰酸，阳虚畏寒阴热潮，不足早衰不固溲，水泛水肿好好瞧。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肾病五证</span><span class="df-arrow">→</span><span class="df-node df-logic">阳·阴·精<br>·气·水</span><span class="df-arrow">→</span><span class="df-node df-organ">各兼有特点</span><span class="df-arrow">→</span><span class="df-node df-symptom">寒热早衰<br>尿异常水肿</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">肾精不足和肾阴虚的区别----"不足"vs"虚火"</span><div class="ds-body">很多考生会混淆肾精不足和肾阴虚，因为他们都有耳鸣、头晕、腰酸。但鉴别点：肾精不足体现的是【生长发育生殖的障碍】----小儿发育迟缓（五迟五软：立迟行迟齿迟发迟语迟）、成人早衰（发早白、齿早脱、耳鸣耳聋、性早衰）。它<strong>不一定有热象</strong>（无潮热盗汗=没火），本质上是"缺了原料"而已。而肾阴虚突出的是"水少火旺"----虚火导致的手足心热、盗汗、舌红少苔。一句话：肾精不足是"不够了"，肾阴虚是"不够了+还烧了"。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">肾气不固和脾虚气陷----两者都有"下垂"，但位置和伴随症状不同</span><div class="ds-body"><strong>肾气不固</strong>突出在小便和生殖系统----固摄无能：夜尿多、遗尿、小便失禁、遗精早泄、滑精、胎动不安（肾主封藏）。方：金锁固精丸、缩泉丸。<strong>脾虚气陷</strong>突出在消化系统和内脏位置：脱肛、胃下垂、子宫脱垂、久泻不止----是"升提无力"的体现。方：补中益气汤。简记法：小便生殖系统异常+腰膝酸软→肾气不固（补肾固摄）；消化系统+内脏下垂+乏力→脾虚气陷（升提）。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">肾虚水泛----阳虚的"升级版"</span><div class="ds-body"><strong>肾虚水泛</strong>是在肾阳虚的基础上，因为温煦气化功能极度减弱，导致水液不能被正常代谢而"泛滥"全身，表现为：全身水肿（腰以下更甚，按之凹陷没指）、尿少（因气化无力产尿）、畏寒肢冷（阳虚基础）、腰膝酸冷、腹胀、或伴有心悸气短（水气凌心）。<strong>方：</strong>真武汤（附子温阳化气+白术健脾燥湿+茯苓+生姜+白芍）----相当于在肾气丸的基础上加了强力利水成分。鉴别：单纯肾阳虚没有明显水肿；肾虚水泛必见水肿。</div></div></div>'},
{id:'dx-42-3',name:'肾病五证的鉴别要点',type:'compare',content:'<p>肾病五证速查----<strong>肾阳虚</strong>（畏寒·肾气丸）、<strong>肾阴虚</strong>（潮热·六味丸）、<strong>肾精不足</strong>（早衰·左归丸）、<strong>肾气不固</strong>（尿频·缩泉丸）、<strong>肾虚水泛</strong>（水肿·真武汤）。共同基础症状：腰膝酸软。</p><div class="classic-quote">《素问》："肾主藏精......精之处也。"<span class="src">----《黄帝内经》</span></div><div class="mnem">五证辨肾先腰酸，阳虚畏寒阴热潮，不足早衰不固溲，水泛水肿好好瞧。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肾病五证</span><span class="df-arrow">→</span><span class="df-node df-logic">阳·阴·精<br>·气·水</span><span class="df-arrow">→</span><span class="df-node df-organ">各兼有特点</span><span class="df-arrow">→</span><span class="df-node df-symptom">寒热早衰<br>尿异常水肿</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">肾精不足和肾阴虚的区别----"不足"vs"虚火"</span><div class="ds-body">很多考生会混淆肾精不足和肾阴虚，因为他们都有耳鸣、头晕、腰酸。但鉴别点：肾精不足体现的是【生长发育生殖的障碍】----小儿发育迟缓（五迟五软：立迟行迟齿迟发迟语迟）、成人早衰（发早白、齿早脱、耳鸣耳聋、性早衰）。它<strong>不一定有热象</strong>（无潮热盗汗=没火），本质上是"缺了原料"而已。而肾阴虚突出的是"水少火旺"----虚火导致的手足心热、盗汗、舌红少苔。一句话：肾精不足是"不够了"，肾阴虚是"不够了+还烧了"。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">肾气不固和脾虚气陷----两者都有"下垂"，但位置和伴随症状不同</span><div class="ds-body"><strong>肾气不固</strong>突出在小便和生殖系统----固摄无能：夜尿多、遗尿、小便失禁、遗精早泄、滑精、胎动不安（肾主封藏）。方：金锁固精丸、缩泉丸。<strong>脾虚气陷</strong>突出在消化系统和内脏位置：脱肛、胃下垂、子宫脱垂、久泻不止----是"升提无力"的体现。方：补中益气汤。简记法：小便生殖系统异常+腰膝酸软→肾气不固（补肾固摄）；消化系统+内脏下垂+乏力→脾虚气陷（升提）。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">肾虚水泛----阳虚的"升级版"</span><div class="ds-body"><strong>肾虚水泛</strong>是在肾阳虚的基础上，因为温煦气化功能极度减弱，导致水液不能被正常代谢而"泛滥"全身，表现为：全身水肿（腰以下更甚，按之凹陷没指）、尿少（因气化无力产尿）、畏寒肢冷（阳虚基础）、腰膝酸冷、腹胀、或伴有心悸气短（水气凌心）。<strong>方：</strong>真武汤（附子温阳化气+白术健脾燥湿+茯苓+生姜+白芍）----相当于在肾气丸的基础上加了强力利水成分。鉴别：单纯肾阳虚没有明显水肿；肾虚水泛必见水肿。</div></div></div>'}
]},
{name:'细目六：腑病辨证',points:[
{id:'dx-43-1',name:'胃热炽盛证的临床表现',type:'detail',content:'<p><strong>胃热炽盛</strong>是胃中火热炽盛、胃失和降的病理状态。核心症状：胃脘灼痛拒按、消谷善饥、渴喜冷饮、口臭、牙龈肿痛、便秘、舌红苔黄、脉滑数。代表方：清胃散/玉女煎。</p><div class="classic-quote">《素问》："诸逆冲上，皆属于火……诸呕吐酸，皆属于热。"<span class="src">——《黄帝内经》</span></div><div class="mnem">胃热灼痛消谷饥，口臭龈肿便秘急；清胃散中连升麻，玉女石膏知母地。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">胃热炽盛<br>胃火内炽</span><span class="df-arrow">→</span><span class="df-node df-logic">热积胃中<br>胃失和降</span><span class="df-arrow">→</span><span class="df-node df-organ">灼痛+消谷+<br>口疮+龈肿</span><span class="df-arrow">→</span><span class="df-node df-symptom">热者寒之</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">胃热——"胃里有一团火在烧"</span><div class="ds-body">胃热炽盛就是胃这个"锅"底下的火烧得太旺了，锅里的水（胃津）被快速烧干。火性炎上→向上的出口（口腔、牙龈、咽喉）就会出现热象：口臭、牙龈肿痛、口腔溃疡反复发作。火性迫津→津液被迫外泄：口干渴（但只想喝冷水）、大便干结（肠中津液被烤干）。同时胃的蠕动过快（"火"刺激了胃功能亢进）→食物刚进胃就被快速消化了→"消谷善饥"（吃得多饿得快）。这个证型特别好发在爱吃辛辣烧烤火锅、长期饮酒或情绪急躁化火的人身上。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">症状群——灼痛+消谷+口臭，三联锁定</span><div class="ds-body">核心三联：①<strong>胃脘灼痛拒按</strong>——痛感像胃里有一团火在烧，按着更痛。②<strong>消谷善饥</strong>——吃完没多久又饿，有时伴口臭（食物在胃里被"火"烤成腐气往上冲）。③<strong>牙龈肿痛/口疮</strong>——足阳明胃经经过牙龈，火沿着经上炎至牙龈→红肿痛甚至出血。其他伴随：渴喜冷饮、便秘、舌红苔黄、脉滑数。<strong>代表方：</strong>清胃散（黄连+升麻+丹皮+生地+当归）清胃凉血止痛；玉女煎（石膏+知母+麦冬+熟地+牛膝）清胃滋阴，适用于胃热兼肾阴虚者。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">最容易混淆的对比——胃热炽盛vs胃阴虚</span><div class="ds-body"><strong>胃热炽盛</strong>=实火：灼痛拒按、消谷善饥、口臭明显、舌红苔黄厚、脉滑数有力→<strong>清胃散/玉女煎</strong>（清泻胃火）<br><strong>胃阴虚</strong>=虚火：隐痛不剧、饥不欲食（饿但不想吃）、口干燥但不渴、舌红少苔或无苔、脉细数→<strong>益胃汤/麦门冬汤</strong>（滋养胃阴）<br>鉴别核心：舌苔——胃热苔黄厚，胃阴虚无苔或少苔。一个要"清火"，一个要"养阴"。</div></div></div>'},
{id:'dx-43-2',name:'寒滞胃肠食滞胃肠证的临床表现',type:'detail',content:'<p><strong>寒滞胃肠</strong>是寒邪直接侵犯胃肠、导致气机阻滞（实寒证）。<strong>食滞胃肠</strong>是饮食不节、食积不化停滞胃肠（实证）。两者都有胃痛，但一寒一食性质不同。</p><div class="classic-quote">《素问》："寒则气收……寒气客于肠胃，厥逆上出，故痛而呕。"<span class="src">——《黄帝内经》</span></div><div class="mnem">寒滞突发冷痛得热减，食滞胀满嗳腐吐后减。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">胃肠实证<br>一寒一食</span><span class="df-arrow">→</span><span class="df-node df-logic">寒：收引凝滞<br>食：停滞不化</span><span class="df-arrow">→</span><span class="df-node df-organ">冷痛得热减<br>vs胀痛吐后减</span><span class="df-arrow">→</span><span class="df-node df-symptom">温中vs消导</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">寒滞胃肠——"冷"出来的胃痛</span><div class="ds-body">寒滞胃肠是"实寒"——不是阳虚（功能不够），而是外来寒邪直接攻入了胃肠（冰淇淋、冰啤酒、受凉等），寒性收引→胃肠痉挛→突发剧烈胃痛（像抽筋一样）。这种痛的特点是<strong>得热（热水袋/热汤）明显缓解、遇冷加剧</strong>。因无热象，故口淡不渴。因寒滞，舌淡苔白。代表方：良附丸（高良姜+香附）+良姜温胃散寒散结，香附理气止痛。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">食滞胃肠——"撑"出来的胃痛</span><div class="ds-body">食滞胃肠是"暴饮暴食"把胃的"容量"给撑爆了，食物积在胃里不能向下传导。胃胀满疼痛拒按、嗳气有腐臭味（打嗝有酸腐味，像食物馊了的味道）、吐出来或者拉出来后胀痛能缓解一些。舌苔厚腻（食积之苔）。代表方：保和丸（山楂+神曲+莱菔子+半夏+陈皮+茯苓+连翘）——消食和胃导滞。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">最容易混淆的对比——寒滞vs食滞vs胃热</span><div class="ds-body"><strong>寒滞胃肠</strong>：突发冷痛、得热减、口淡不渴、舌淡苔白→良附丸（温中散寒）<br><strong>食滞胃肠</strong>：胀满痛、嗳腐吞酸、吐后减、苔厚腻→保和丸（消食导滞）<br><strong>胃热炽盛</strong>：灼痛、消谷善饥、口臭、舌红苔黄→清胃散（清胃泻火）<br>三句话记住：寒→冷痛得热减；食→胀痛嗳腐臭；热→灼痛消谷饥。</div></div></div>'},
{id:'dx-43-3',name:'肠热腑实肠道津亏证的临床表现',type:'detail',content:'<p><strong>肠热腑实</strong>（实热证·大承气汤）和<strong>肠道津亏</strong>（津虚证·麻子仁丸）都有便秘。鉴别核心：肠热腑实有腹硬满拒按+潮热+苔黄燥→急下存阴；肠道津亏大便干如羊粪+无腹满+无发热→增水行舟。</p><div class="classic-quote">《素问》："大肠者，传导之官，变化出焉。"<span class="src">——《黄帝内经》</span></div><div class="mnem">腑实硬满拒按潮热急下，津亏羊粪干结润滑行舟。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肠病便秘<br>一实一虚</span><span class="df-arrow">→</span><span class="df-node df-logic">肠热腑实：热结<br>肠道津亏：津枯</span><span class="df-arrow">→</span><span class="df-node df-organ">硬满拒按潮热<br>vs羊粪干结无痛</span><span class="df-arrow">→</span><span class="df-node df-symptom">急下vs润下</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">肠热腑实——"热和燥屎结了块"</span><div class="ds-body">肠热腑实是"热邪"和肠道里的食物残渣"互结"住了——就像把水泥和沙子搅拌在一起干了就板结了。腹部硬邦邦的（硬满）、按下去痛得不行（拒按）、下午3-5点（日晡）发潮热（像潮水一样定时发热）、大便多日不通（严重时小量粪水从旁边渗出——"热结旁流"）。舌红苔黄厚干燥起刺、脉沉实有力。治法必须"急下存阴"（通腑泄热保住快要被烧干的津液）——大承气汤（大黄+芒硝+枳实+厚朴）。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">肠道津亏——"船在水浅的河道搁浅了"</span><div class="ds-body">肠道津亏是肠道里没有"水"了（津液不足），大便本身不硬多是硬化得像羊粪球一样一粒粒的，但腹部不胀满、不拒按、不发热。多见于老年人体液自然减少、产后失血、或热病后期。治疗的原则是"增水行舟"——不是猛攻，而是把肠道里的津液补足让大便能自己滑出来。代表方麻子仁丸（麻子仁+杏仁+白芍+大黄+枳实+厚朴）+增液汤（玄参+麦冬+生地）。</div></div></div>'},
{id:'dx-43-4',name:'肠道湿热膀胱湿热胆郁痰扰证的临床表现',type:'detail',content:'<p><strong>肠道湿热</strong>（赤白脓血痢·白头翁汤）、<strong>膀胱湿热</strong>（尿频急痛·八正散）、<strong>胆郁痰扰</strong>（胆怯易惊口苦·温胆汤）。三者都属"湿热"范畴，但部位不同：肠道湿热看大便、膀胱湿热看小便、胆郁痰扰看情志。</p><div class="classic-quote">《素问》："湿热不攘，大筋软短，小筋弛长……"<span class="src">——《黄帝内经》</span></div><div class="mnem">肠道湿热痢脓血，膀胱湿热淋沥痛，胆郁痰扰惊悸口苦。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">三焦湿热<br>部位不同</span><span class="df-arrow">→</span><span class="df-node df-logic">肠道→大便<br>膀胱→小便<br>胆经→情志</span><span class="df-arrow">→</span><span class="df-node df-organ">清利湿热<br>各有专方</span><span class="df-arrow">→</span><span class="df-node df-symptom">各随其脏</span></div><div class="derive-step ds-blue"><span class="ds-num">1</span><span class="ds-title">肠道湿热——湿热在"肠"</span><div class="ds-body">湿热蕴结在大肠（肠道），大肠传导功能失常→症状集中在"大便"上：腹痛、里急后重（想拉又拉不出来、蹲了半天只拉出一点点）、大便赤白脓血或黏冻（像鼻涕一样）、肛门灼热、小便短黄、舌红苔黄腻、脉滑数。代表方：白头翁汤（白头翁+黄连+黄柏+秦皮）清热利湿止痢。</div></div><div class="derive-step ds-red"><span class="ds-num">2</span><span class="ds-title">膀胱湿热——湿热在"膀胱"</span><div class="ds-body">湿热侵犯膀胱（也即"淋证"范畴）→症状集中在"小便"上：尿频尿急尿痛（尿时灼热感、淋漓不尽）、小便短黄浑浊、或尿中带血（血淋）、或尿中有砂石（石淋）。舌红苔黄腻、脉滑数。代表方：八正散（瞿麦+扁蓄+车前子+滑石+栀子+大黄+灯芯草+甘草）清热利湿通淋。</div></div><div class="derive-step ds-purple"><span class="ds-num">3</span><span class="ds-title">胆郁痰扰——湿热在"胆"</span><div class="ds-body">胆郁痰扰是"痰湿"+"火热"扰动了胆经，影响到"情志"方面——不像肠道膀胱那样有形可见的排泄物异常，而是"神"的层面被扰乱了。胆怯易惊（胆子变小、容易受惊）、烦躁不寐（心烦睡不着）、口苦（胆汁上逆）、呕恶（痰湿犯胃）。舌红苔黄腻（痰热之苔）、脉滑数。代表方：温胆汤（半夏+竹茹+枳实+陈皮+茯苓+甘草）清胆化痰、和胃安神。注意：温胆汤名为"温"，实为"清"。</div></div></div>'}
]},
{name:'细目七：脏腑兼证',points:[
{id:'dx-44-1',name:'心肾不交心脾气血虚证的辨证要点',type:'compare',content:'<p><strong>心肾不交</strong>（上热下寒·交泰丸）和<strong>心脾两虚</strong>（纯虚无热·归脾汤）都有心悸失眠。鉴别核心：心肾不交是上热下寒（心烦口疮+腰膝酸软下肢冷），心脾两虚是纯虚无热（心悸+纳差+面萎黄）。</p><div class="classic-quote">《灵枢》："心肾不交则失眠。"<span class="src">——《黄帝内经》</span></div><div class="mnem">心肾不交上热下寒失眠，心脾两虚纯虚无热健忘。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">脏腑兼证<br>失眠鉴别</span><span class="df-arrow">→</span><span class="df-node df-logic">心肾不交<br>（水火不济）</span><span class="df-arrow">→</span><span class="df-node df-logic">心脾两虚<br>（气血双亏）</span><span class="df-arrow">→</span><span class="df-node df-symptom">一热一冷vs纯虚</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">心肾不交——"水火乱了"</span><div class="ds-body">正常情况下心火（阳）往下走温暖肾水，肾水（阴）往上走制衡心火（水火既济）。当肾阴亏+心火亢，交通打破。上热：心烦、口疮、失眠多梦；下寒：腰膝酸软、遗精、双脚冰凉。同一个体"上面热下面寒"——"上热下寒"是心肾不交的最特征表现。方：交泰丸（黄连清心火+肉桂引火归原）交通心肾。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">心脾两虚——"气和血一起不够"</span><div class="ds-body">心气虚/心血虚+脾气虚——没有火、没有热象，纯粹的"虚+虚"。失眠（睡后易醒）+心悸+食少便溏+面色萎黄+神疲乏力+舌淡+脉细弱。纯虚无热。治疗：归脾汤（人参黄芪白术健脾+当归酸枣仁龙眼肉养心）补心脾。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">鉴别核心——"上热下寒"vs"纯虚无热"</span><div class="ds-body">心肾不交→上热（心烦口疮）+下寒（腰酸脚冷）+舌红少苔+脉细数→交泰丸交通心肾。<br>心脾两虚→无热象+纳差便溏+面色萎黄+舌淡+脉细弱→归脾汤健脾养心。<br>一句话：上热下寒心肾不交，纯虚无热心脾两虚。</div></div></div>'},
{id:'dx-44-2',name:'肝火犯肺肝胃不和肝郁脾虚证的辨证要点',type:'compare',content:'<p><strong>肝火犯肺</strong>（咳嗽痰黄+胸胁灼痛·黛蛤散合泻白散）、<strong>肝胃不和</strong>（脘胀嗳气吞酸·柴胡疏肝散/左金丸）、<strong>肝郁脾虚</strong>（胁胀便溏·逍遥散）。三者都有肝郁（胁胀脉弦），区别在于"下一个受害者"：肺→咳，胃→胀，脾→泻。</p><div class="classic-quote">《金匮要略》："见肝之病，知肝传脾，当先实脾。"<span class="src">——张仲景</span></div><div class="mnem">三证共有肝郁胁胀，犯肺咳嗽和胃泛酸，犯脾腹泻逍遥安。</div><div class="derive-box"><div class="derive-flow"><span class="df-node df-concept">肝病传变<br>三方向</span><span class="df-arrow">→</span><span class="df-node df-logic">木火刑金→肺<br>木克土→脾胃</span><span class="df-arrow">→</span><span class="df-node df-organ">咳·胀·泻<br>三出口</span><span class="df-arrow">→</span><span class="df-node df-symptom">各治兼脏</span></div><div class="derive-step ds-orange"><span class="ds-num">1</span><span class="ds-title">肝火犯肺（木火刑金·咳为主）</span><div class="ds-body">肝气郁结化火（火）→肝火顺着经络上冲→肺（金）被这股"火"灼伤→咳嗽（阵发性干咳或咳黄痰）、咳时胸胁灼痛、情绪不好时加重（一生气就咳）。口苦、面红、舌红苔黄、脉弦数。治疗：黛蛤散（青黛+蛤壳）清肝火+泻白散（桑白皮+地骨皮）泻肺热——肝肺同治。</div></div><div class="derive-step ds-orange"><span class="ds-num">2</span><span class="ds-title">肝胃不和（胃的症状为主）</span><div class="ds-body">肝郁气滞→横逆犯胃（木克土）→胃的"降"的功能被阻碍了（胃气上逆）→胃胀痛、嗳气频作（不停打嗝）、呃逆、泛酸烧心、恶心欲吐。情绪不好时加重。治疗：柴胡疏肝散疏肝理气+左金丸（黄连+吴茱萸）制酸和胃。</div></div><div class="derive-step ds-orange"><span class="ds-num">3</span><span class="ds-title">肝郁脾虚（腹泻为主）</span><div class="ds-body">肝气郁结→"克"了脾（脾运化被压制）→既有胁胀（肝郁表现）又有食少便溏腹胀（脾虚表现）——最典型的症状是"一紧张就肚子痛、拉肚子"（痛泻要方证）。治疗：逍遥散（柴胡+当归+白芍+白术+茯苓+薄荷+生姜）疏肝健脾。</div></div></div>'}
]}
]}
]};

var Q2 = [
{type:'choice',pointId:'dx-1-1',question:'中医诊断三大原则不包括?',options:['整体审察','四诊合参','病证结合','辨证论治'],answer:3},
{type:'choice',pointId:'dx-2-1',question:'恶寒发热并见主?',options:['里证','表证','半表半里证','虚证'],answer:1},
